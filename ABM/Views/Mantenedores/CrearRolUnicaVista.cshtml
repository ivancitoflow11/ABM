@using Microsoft.AspNetCore.Mvc.Rendering
@using ABM.Models
@model ABM.Models.RolWizardViewModel

@{
    ViewData["Title"] = "Crear Rol Wizard";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="d-flex align-items-center justify-content-center" style="min-height:100vh; background-color:#f8f9fa; font-family:'Segoe UI',sans-serif;">
    <div class="card shadow" style="max-width:600px; width:90%;">
        <div class="card-body p-4 p-md-5">
            <h3 class="card-title text-center mb-4 fw-bold">
                <span class="flag-icon flag-icon-cl me-2"></span>
                Crear Rol
            </h3>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form asp-action="CrearRolWizard" method="post" id="wizardForm">
                @Html.AntiForgeryToken()

                <!-- PASO 1: Nombre del Rol -->
                <div id="paso1" class="wizard-step" style="display:block;">
                    <div class="mb-4">
                        <label asp-for="NombreRol" class="form-label fw-semibold">Nombre del Rol</label>
                        <input asp-for="NombreRol" class="form-control form-control-lg" id="NombreRol" />
                        <span asp-validation-for="NombreRol" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-success btn-lg" onclick="Next(1)">Siguiente</button>
                    </div>
                </div>

                <!-- PASO 2: Selección de Menús -->
                <div id="paso2" class="wizard-step" style="display:none;">
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Seleccione Menús para el Rol</label>
                        @if (ViewBag.MenusDisponibles != null)
                        {
                            foreach (var menu in (IEnumerable<MenuModel>)ViewBag.MenusDisponibles)
                            {
                                <div class="form-check mb-2">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           name="ListaMenusSeleccionados"
                                           value="@menu.IdMenu"
                                           id="menu_@menu.IdMenu"
                                           data-nombre="@menu.NombreMenu" />
                                    <label class="form-check-label" for="menu_@menu.IdMenu">
                                        @menu.NombreMenu
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <p>No hay menús disponibles.</p>
                        }
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-lg" onclick="Prev(2)">Anterior</button>
                        <button type="button" class="btn btn-success btn-lg" onclick="Next(2)">Siguiente</button>
                    </div>
                </div>

                <!-- PASO 3: Selección de Menú de inicio -->
                <div id="paso3" class="wizard-step" style="display:none;">
                    <div class="mb-4">
                        <label asp-for="MenuInicioSeleccionadoId" class="form-label fw-semibold">Menú de inicio</label>
                        <select asp-for="MenuInicioSeleccionadoId" class="form-select form-select-lg" id="MenuInicioSeleccionadoId">
                            <option value="">Seleccione...</option>
                        </select>
                        <span asp-validation-for="MenuInicioSeleccionadoId" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-lg" onclick="Prev(3)">Anterior</button>
                        <button type="button" class="btn btn-success btn-lg" onclick="Next(3)">Siguiente</button>
                    </div>
                </div>

                <!-- PASO 4: Selección de País/Negocio/Sistema -->
                <div id="paso4" class="wizard-step" style="display:none;">
                    <div class="mb-4">
                        <!-- Selección de país con banderas -->
                        <div class="card border mb-3">
                            <div class="card-body text-center py-3">
                                <h6 class="mb-3">Seleccione el País</h6>
                                <div class="d-flex justify-content-center flex-wrap">
                                    @foreach (var pais in ((IEnumerable<PaisNegocioSistemaModel>)ViewBag.PNSModelList)
                                    .Select(x => new { x.CodPais, x.Pais })
                                    .Distinct())
                                    {
                                        <div class="country-flag-selector mx-2">
                                            <img src="~/img/flags/@(pais.CodPais.ToLower()).png" alt="@pais.Pais"
                                                 class="flag-selector" data-pais="@pais.CodPais.ToLower()"
                                                 style="width:48px; height:32px; cursor:pointer; border:2px solid transparent; transition: all 0.2s;" />
                                            <div class="text-center mt-1 small">@pais.Pais</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div id="paisSistemaContainer">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0">Seleccione los sistemas y negocios para el Rol a crear:</h6>
                                <button type="button" id="selectAllBtn" class="btn btn-sm btn-outline-primary">Seleccionar todos</button>
                            </div>

                            @foreach (var grupo in ((IEnumerable<PaisNegocioSistemaModel>)ViewBag.PNSModelList)
                            .GroupBy(x => x.CodPais.ToLower()))
                            {
                                <div class="pais-container mb-4" id="pais-@grupo.Key" style="display:none;">
                                    <div class="card">
                                        <div class="card-header bg-success text-white">
                                            <h6 class="mb-0">
                                                <span class="flag-icon flag-icon-@grupo.Key me-2 text-white"></span>
                                                Listado @grupo.First().Pais
                                            </h6>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                                                <table class="table table-striped table-hover mb-0">
                                                    <thead style="position: sticky; top: 0; background-color: #f8f9fa; z-index: 1;">
                                                        <tr>
                                                            <th style="width:50px;"></th>
                                                            <th>PAÍS</th>
                                                            <th>NEGOCIO</th>
                                                            <th>SISTEMA</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in grupo)
                                                        {
                                                            <tr>
                                                                <td class="text-center">
                                                                    <input class="form-check-input pns-checkbox"
                                                                           type="checkbox"
                                                                           name="ListaPNSSeleccionados"
                                                                           id="pns_@item.IdPaisNegocioSistema"
                                                                           value="@item.IdPaisNegocioSistema"
                                                                           data-pais="@item.CodPais.ToLower()" />
                                                                </td>
                                                                <td>@item.Pais</td>
                                                                <td>@item.Negocio</td>
                                                                <td>@item.Sistema</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="ListaPNSSeleccionados" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-lg" onclick="Prev(4)">Anterior</button>
                        <button type="button" class="btn btn-success btn-lg" onclick="Next(4)">Siguiente</button>
                    </div>
                </div>

                <!-- PASO 5: Resumen y Confirmación -->
                <div id="paso5" class="wizard-step" style="display:none;">
                    <div class="mb-4">
                        <h5 class="mb-3 fw-bold">Revisar Datos</h5>
                        <p class="fs-5"><strong>Nombre del Rol:</strong> <span id="lblNombreRol"></span></p>
                        <p class="fs-5"><strong>Menús:</strong> <span id="lblMenus"></span></p>
                        <p class="fs-5"><strong>Menú de inicio:</strong> <span id="lblVista"></span></p>
                        <p class="fs-5"><strong>País y Negocio:</strong> <span id="lblPNS"></span></p>
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-lg" onclick="Prev(5)">Anterior</button>
                        <button type="submit" class="btn btn-success btn-lg">Guardar Rol</button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sweetalert/sweetalert.min.js"></script>
    <script>
        // Prevent form submission on ENTER
        const form = document.getElementById('wizardForm');
        let currentStep = 1;
        form.addEventListener('keydown', e => {
            if (e.key === 'Enter') e.preventDefault();
        });

        // Error handling
        function showError(msg) {
            const summary = document.querySelector('.text-danger.mb-3');
            summary.innerHTML = `<ul><li>${msg}</li></ul>`;
            summary.style.display = 'block';
        }
        function clearError() {
            const summary = document.querySelector('.text-danger.mb-3');
            summary.innerHTML = '';
            summary.style.display = 'none';
        }

        // Wizard navigation
        function Next(step) {
            clearError();

            if (step === 1) {
                const nombreRol = document.getElementById('NombreRol').value.trim();
                if (!nombreRol) {
                    showError('El nombre del rol es obligatorio.');
                    return;
                }

                // Validación asíncrona para verificar nombre único
                fetch(`/Mantenedores/VerificarNombreRol?nombre=${encodeURIComponent(nombreRol)}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.existe) {
                            showError('El nombre del rol ya existe. Por favor, elija otro nombre.');
                        } else {
                            // Continuar al siguiente paso si el nombre es único
                            document.getElementById('paso' + step).style.display = 'none';
                            const next = step + 1;
                            document.getElementById('paso' + next).style.display = 'block';
                            currentStep = next;
                        }
                    })
                    .catch(error => {
                        console.error('Error al verificar el nombre del rol:', error);
                        showError('Error al verificar el nombre del rol. Intente nuevamente.');
                    });
                return; // Importante: detener la ejecución aquí
            }

            if (step === 2) {
                const marc = document.querySelectorAll('input[name="ListaMenusSeleccionados"]:checked');
                if (!marc.length) {
                    showError('Debe seleccionar al menos un Menú para el Rol.');
                    return;
                }
                const selIni = document.getElementById('MenuInicioSeleccionadoId');
                selIni.innerHTML = '<option value="">Seleccione...</option>';
                marc.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.value;
                    opt.text = item.getAttribute('data-nombre') || item.parentElement.querySelector('label').innerText.trim();
                    selIni.appendChild(opt);
                });
            }
            if (step === 3) {
                if (!document.getElementById('MenuInicioSeleccionadoId').value) {
                    showError('Debes elegir un Menú de inicio.');
                    return;
                }
            }
            if (step === 4) {
                if (!document.querySelectorAll('input[name="ListaPNSSeleccionados"]:checked').length) {
                    showError('Debe seleccionar al menos un País/Negocio/Sistema.');
                    return;
                }
            }

            document.getElementById('paso' + step).style.display = 'none';
            const next = step + 1;
            document.getElementById('paso' + next).style.display = 'block';
            currentStep = next;

            if (currentStep === 5) {
                document.getElementById('lblNombreRol').innerText = document.getElementById('NombreRol').value.trim();
                document.getElementById('lblMenus').innerText = Array.from(
                    document.querySelectorAll('input[name="ListaMenusSeleccionados"]:checked')
                ).map(i => i.parentElement.querySelector('label').innerText.trim()).join(', ');
                document.getElementById('lblVista').innerText = document.getElementById('MenuInicioSeleccionadoId')
                    .selectedOptions[0]?.text || '';
                document.getElementById('lblPNS').innerText = Array.from(
                    document.querySelectorAll('input[name="ListaPNSSeleccionados"]:checked')
                ).map(i => i.closest('tr').textContent.trim()).join(', ');
            }
        }

        function Prev(step) {
            clearError();
            document.getElementById('paso' + step).style.display = 'none';
            const prev = step - 1;
            document.getElementById('paso' + prev).style.display = 'block';
            currentStep = prev;
        }

        // Flag selector helpers
        function activateFlag(flagElement) {
            flagElement.style.borderColor = '#007bff';
            flagElement.style.opacity = '1';
        }

        function selectPais(paisCode) {
            document.querySelectorAll('.pais-container').forEach(container => {
                container.style.display = 'none';
            });
            const selectedContainer = document.getElementById('pais-' + paisCode);
            if (selectedContainer) {
                selectedContainer.style.display = 'block';
            }
        }

        function getCurrentSelectedPais() {
            const activeFlag = document.querySelector('.flag-selector[style*="opacity: 1"]');
            return activeFlag ? activeFlag.getAttribute('data-pais') : null;
        }

        function updateSelectAllButtonStatus() {
            const currentPaisCode = getCurrentSelectedPais();
            if (!currentPaisCode) return;

            const currentCheckboxes = document.querySelectorAll(`.pns-checkbox[data-pais="${currentPaisCode}"]`);
            const checkedCount = document.querySelectorAll(`.pns-checkbox[data-pais="${currentPaisCode}"]:checked`).length;
            const selectAllBtn = document.getElementById('selectAllBtn');

            if (checkedCount === 0) {
                selectAllBtn.textContent = 'Seleccionar todos';
                selectAllBtn.classList.remove('btn-outline-danger');
                selectAllBtn.classList.add('btn-outline-primary');
            } else if (checkedCount === currentCheckboxes.length) {
                selectAllBtn.textContent = 'Deseleccionar todos';
                selectAllBtn.classList.remove('btn-outline-primary');
                selectAllBtn.classList.add('btn-outline-danger');
            } else {
                selectAllBtn.textContent = 'Seleccionar todos';
                selectAllBtn.classList.remove('btn-outline-danger');
                selectAllBtn.classList.add('btn-outline-primary');
            }
        }

        // DOMContentLoaded: wizard initialization + flag/select-all logic
        document.addEventListener('DOMContentLoaded', function () {
            // Inicializar wizard: mostrar paso 1, ocultar los demás
            for (let i = 1; i <= 5; i++) {
                document.getElementById('paso' + i).style.display = (i === 1 ? 'block' : 'none');
            }

            // Inicializar flags
            const flags = document.querySelectorAll('.flag-selector');
            if (flags.length > 0) {
                const firstPais = flags[0].getAttribute('data-pais');
                selectPais(firstPais);
                activateFlag(flags[0]);
            }

            // Eventos de click en banderas
            flags.forEach(flag => {
                flag.addEventListener('click', function () {
                    // Reset de todas las banderas
                    flags.forEach(f => {
                        f.style.borderColor = 'transparent';
                        f.style.opacity = '0.5';
                    });

                    // Activar la seleccionada
                    activateFlag(this);

                    // Mostrar contenido país
                    const paisCode = this.getAttribute('data-pais');
                    selectPais(paisCode);

                    // Reset del botón Seleccionar todos
                    updateSelectAllButtonStatus();
                });
            });

            // Botón "Seleccionar todos"
            const selectAllBtn = document.getElementById('selectAllBtn');
            if (selectAllBtn) {
                selectAllBtn.addEventListener('click', function () {
                    const currentPaisCode = getCurrentSelectedPais();
                    const currentCheckboxes = document.querySelectorAll(`.pns-checkbox[data-pais="${currentPaisCode}"]`);
                    const allChecked = Array.from(currentCheckboxes).every(cb => cb.checked);
                    currentCheckboxes.forEach(cb => cb.checked = !allChecked);
                    updateSelectAllButtonStatus();
                });
            }

            // Escuchar cambios en checkboxes
            document.querySelectorAll('.pns-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', updateSelectAllButtonStatus);
            });

            // Estado inicial del botón
            updateSelectAllButtonStatus();
        });
    </script>
}
