@using Microsoft.AspNetCore.Mvc.Rendering
@using ABM.Models
@model ABM.Models.RolWizardViewModel

@{
    ViewData["Title"] = "Crear Rol Wizard";
}
<link rel="stylesheet" href="~/css/flag-icons.min.css" />

<div class="d-flex align-items-center justify-content-center" style="min-height: 100vh; background-color: #f8f9fa; font-family: 'Segoe UI', sans-serif;">
    <div class="card shadow" style="max-width: 600px; width: 90%;">
        <div class="card-body p-4 p-md-5">
            <h3 class="card-title text-center mb-4 fw-bold">
                <span class="flag-icon flag-icon-cl me-2"></span>
                Crear Rol
            </h3>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <form asp-action="CrearRolWizard" method="post">
                @Html.AntiForgeryToken()

                <!-- PASO 1: Nombre del Rol -->
                <div id="paso1" class="wizard-step" style="display:block;">
                    <div class="mb-4">
                        <label asp-for="NombreRol" class="form-label fw-semibold">Nombre del Rol</label>
                        <input asp-for="NombreRol" class="form-control form-control-lg" id="NombreRol" />
                        <span asp-validation-for="NombreRol" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-primary btn-lg" onclick="Next(1)">Siguiente</button>
                    </div>
                </div>

                <!-- PASO 2: Selección de Menús -->
                <div id="paso2" class="wizard-step" style="display:none;">
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Seleccione Menús para el Rol</label>
                        @if (ViewBag.MenusDisponibles != null)
                        {
                            foreach (var menu in (IEnumerable<MenuModel>)ViewBag.MenusDisponibles)
                            {
                                <div class="form-check mb-2">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           name="ListaMenusSeleccionados"
                                           value="@menu.IdMenu"
                                           id="menu_@menu.IdMenu"
                                           data-nombre="@menu.NombreMenu" />
                                    <label class="form-check-label" for="menu_@menu.IdMenu">
                                        @menu.NombreMenu
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <p>No hay menús disponibles.</p>
                        }
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-lg" onclick="Prev(2)">Anterior</button>
                        <button type="button" class="btn btn-primary btn-lg" onclick="Next(2)">Siguiente</button>
                    </div>
                </div>

                <!-- PASO 3: Selección de Menú de inicio -->
                <div id="paso3" class="wizard-step" style="display:none;">
                    <div class="mb-4">
                        <label asp-for="MenuInicioSeleccionadoId" class="form-label fw-semibold">Vista de inicio</label>
                        <select asp-for="MenuInicioSeleccionadoId" class="form-select form-select-lg" id="MenuInicioSeleccionadoId">
                            <option value="">Seleccione...</option>
                        </select>
                        <span asp-validation-for="MenuInicioSeleccionadoId" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-lg" onclick="Prev(3)">Anterior</button>
                        <button type="button" class="btn btn-primary btn-lg" onclick="Next(3)">Siguiente</button>
                    </div>
                </div>

                <!-- PASO 4: Seleccionar País y Negocio -->
                <div id="paso4" class="wizard-step" style="display:none;">
                    <div class="mb-4">
                        <label asp-for="SelectedPaisNegocioSistemaId" class="form-label fw-semibold">País y Negocio</label>
                        <select asp-for="SelectedPaisNegocioSistemaId" class="form-select form-select-lg" id="SelectedPaisNegocioSistemaId">
                            <option value="">Seleccione...</option>
                            @if (ViewBag.PaisNegocioList != null)
                            {
                                foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.PaisNegocioList)
                                {
                                    bool isSelected = (Model.SelectedPaisNegocioSistemaId?.ToString() == item.Value);
                                    <option value="@item.Value" selected="@(isSelected ? "selected" : null)">@item.Text</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="SelectedPaisNegocioSistemaId" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-lg" onclick="Prev(4)">Anterior</button>
                        <button type="button" class="btn btn-primary btn-lg" onclick="Next(4)">Siguiente</button>
                    </div>
                </div>

                <!-- PASO 5: Resumen y Confirmación -->
                <div id="paso5" class="wizard-step" style="display:none;">
                    <div class="mb-4">
                        <h5 class="mb-3 fw-bold">Revisar Datos</h5>
                        <p class="fs-5"><strong>Nombre del Rol:</strong> <span id="lblNombreRol"></span></p>
                        <p class="fs-5"><strong>Menús:</strong> <span id="lblMenus"></span></p>
                        <p class="fs-5"><strong>Menú de inicio:</strong> <span id="lblVista"></span></p>
                        <p class="fs-5"><strong>País y Negocio:</strong> <span id="lblPNS"></span></p>
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-lg" onclick="Prev(5)">Anterior</button>
                        <button type="submit" class="btn btn-success btn-lg">Guardar Rol</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const form = document.getElementById('wizardForm');
        let currentStep = 1;

        // Siempre impedir ENTER para que no haga submit
        form.addEventListener('keydown', e => {
            if (e.key === 'Enter') e.preventDefault();
        });

        function showError(msg) {
            const summary = document.querySelector('.text-danger.mb-3');
            summary.innerHTML = '<ul><li>' + msg + '</li></ul>';
            summary.style.display = 'block';
        }

        function clearError() {
            const summary = document.querySelector('.text-danger.mb-3');
            summary.innerHTML = '';
            summary.style.display = 'none';
        }

        function Next(step) {
            clearError();

            // 1) Paso 1 → validar sólo NombreRol
            if (step === 1) {
                if (!$('#NombreRol').valid()) {
                    return;
                }
            }

            // 2) Paso 2 → validar que haya al menos un menú
            if (step === 2) {
                if (document.querySelectorAll('input[name="ListaMenusSeleccionados"]:checked').length === 0) {
                    showError('Debe seleccionar al menos un Menú para el Rol.');
                    return;
                }
            }

            // 3) Paso 3 → validar MenuInicioSeleccionadoId
            if (step === 3) {
                if (!$('#MenuInicioSeleccionadoId').val()) {
                    showError('Debes elegir un Menú de inicio.');
                    return;
                }
            }

            // 4) Paso 4 → validar país y negocio
            if (step === 4) {
                if (!$('#SelectedPaisNegocioSistemaId').val()) {
                    showError('Debe seleccionar país y negocio.');
                    return;
                }
            }

            // Si pasaron todas las validaciones, navegar al siguiente paso
            document.getElementById('paso' + step).style.display = 'none';
            const nextStep = step + 1;

            // Llenar select de Menú de inicio en la transición 2→3
            if (step === 2 && nextStep === 3) {
                const selectInicio = document.getElementById('MenuInicioSeleccionadoId');
                selectInicio.innerHTML = '<option value="">Seleccione...</option>';
                document.querySelectorAll('input[name="ListaMenusSeleccionados"]:checked')
                    .forEach(item => {
                        const opt = document.createElement('option');
                        opt.value = item.value;
                        opt.text = item.getAttribute('data-nombre') ||
                            item.parentElement.querySelector('label').innerText;
                        selectInicio.appendChild(opt);
                    });
            }

            document.getElementById('paso' + nextStep).style.display = 'block';
            currentStep = nextStep;

            // Si es el paso 5, rellenar el resumen
            if (currentStep === 5) {
                document.getElementById('lblNombreRol').innerText =
                    document.getElementById('NombreRol').value;

                const menues = Array.from(
                    document.querySelectorAll('input[name="ListaMenusSeleccionados"]:checked')
                ).map(item => item.parentElement.querySelector('label').innerText.trim());
                document.getElementById('lblMenus').innerText = menues.join(', ');

                const inicioText = document
                    .getElementById('MenuInicioSeleccionadoId')
                    .selectedOptions[0]?.text || '';
                document.getElementById('lblVista').innerText = inicioText;

                const pnsText = document
                    .getElementById('SelectedPaisNegocioSistemaId')
                    .selectedOptions[0]?.text || '';
                document.getElementById('lblPNS').innerText = pnsText;
            }
        }

        function Prev(step) {
            clearError();
            document.getElementById('paso' + step).style.display = 'none';
            const prev = step - 1;
            document.getElementById('paso' + prev).style.display = 'block';
            currentStep = prev;
        }
    </script>
}
