@using Microsoft.AspNetCore.Mvc.Rendering
@using ABM.Models
@model ABM.Models.RolWizardViewModel

@{
    ViewData["Title"] = "Crear Rol Wizard";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="d-flex align-items-center justify-content-center" style="min-height:100vh; background-color:#f8f9fa; font-family:'Segoe UI',sans-serif;">
    <div class="card shadow" style="max-width:600px; width:90%;">
        <div class="card-body p-4 p-md-5">
            <h3 class="card-title text-center mb-4 fw-bold">
                <span class="flag-icon flag-icon-cl me-2"></span>
                Crear Rol
            </h3>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form asp-action="CrearRolWizard" method="post" id="wizardForm">
                @Html.AntiForgeryToken()

                <!-- PASO 1: Nombre del Rol -->
                <div id="paso1" class="wizard-step" style="display:block;">
                    <div class="mb-4">
                        <label asp-for="NombreRol" class="form-label fw-semibold">Nombre del Rol</label>
                        <input asp-for="NombreRol" class="form-control form-control-lg" id="NombreRol" />
                        <span asp-validation-for="NombreRol" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-primary btn-lg" onclick="Next(1)">Siguiente</button>
                    </div>
                </div>

                <!-- PASO 2: Selección de Menús -->
                <div id="paso2" class="wizard-step" style="display:none;">
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Seleccione Menús para el Rol</label>
                        @if (ViewBag.MenusDisponibles != null)
                        {
                            foreach (var menu in (IEnumerable<MenuModel>)ViewBag.MenusDisponibles)
                            {
                                <div class="form-check mb-2">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           name="ListaMenusSeleccionados"
                                           value="@menu.IdMenu"
                                           id="menu_@menu.IdMenu"
                                           data-nombre="@menu.NombreMenu" />
                                    <label class="form-check-label" for="menu_@menu.IdMenu">
                                        @menu.NombreMenu
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <p>No hay menús disponibles.</p>
                        }
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-lg" onclick="Prev(2)">Anterior</button>
                        <button type="button" class="btn btn-primary btn-lg" onclick="Next(2)">Siguiente</button>
                    </div>
                </div>

                <!-- PASO 3: Selección de Menú de inicio -->
                <div id="paso3" class="wizard-step" style="display:none;">
                    <div class="mb-4">
                        <label asp-for="MenuInicioSeleccionadoId" class="form-label fw-semibold">Menú de inicio</label>
                        <select asp-for="MenuInicioSeleccionadoId" class="form-select form-select-lg" id="MenuInicioSeleccionadoId">
                            <option value="">Seleccione...</option>
                        </select>
                        <span asp-validation-for="MenuInicioSeleccionadoId" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-lg" onclick="Prev(3)">Anterior</button>
                        <button type="button" class="btn btn-primary btn-lg" onclick="Next(3)">Siguiente</button>
                    </div>
                </div>

                <!-- PASO 4: Selección de País/Negocio/Sistema -->
                <div id="paso4" class="wizard-step" style="display:none;">
                    <div class="mb-4">
                        <label asp-for="ListaPNSSeleccionados" class="form-label fw-semibold d-block mb-2">
                            Seleccione sistemas y negocios por país
                        </label>
                        <div class="pns-list-container" style="max-height:300px; overflow:auto; border:1px solid #ddd; border-radius:4px; padding:10px;">
                            @foreach (var grupo in ((IEnumerable<PaisNegocioSistemaModel>)ViewBag.PNSModelList)
                            .GroupBy(x => x.CodPais.ToLower()))
                            {
                                <div class="mb-3">
                                    <h6 class="fw-semibold mb-2">
                                        <span class="flag-icon flag-icon-@grupo.Key me-2"></span>
                                        @grupo.First().Pais
                                    </h6>
                                    <div class="row">
                                        @foreach (var item in grupo)
                                        {
                                            <div class="col-12 col-md-6">
                                                <div class="form-check">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           name="ListaPNSSeleccionados"
                                                           id="pns_@item.IdPaisNegocioSistema"
                                                           value="@item.IdPaisNegocioSistema" />
                                                    <label class="form-check-label" for="pns_@item.IdPaisNegocioSistema">
                                                        @item.Negocio — @item.Sistema
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="ListaPNSSeleccionados" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-lg" onclick="Prev(4)">Anterior</button>
                        <button type="button" class="btn btn-primary btn-lg" onclick="Next(4)">Siguiente</button>
                    </div>
                </div>

                <!-- PASO 5: Resumen y Confirmación -->
                <div id="paso5" class="wizard-step" style="display:none;">
                    <div class="mb-4">
                        <h5 class="mb-3 fw-bold">Revisar Datos</h5>
                        <p class="fs-5"><strong>Nombre del Rol:</strong> <span id="lblNombreRol"></span></p>
                        <p class="fs-5"><strong>Menús:</strong> <span id="lblMenus"></span></p>
                        <p class="fs-5"><strong>Menú de inicio:</strong> <span id="lblVista"></span></p>
                        <p class="fs-5"><strong>País y Negocio:</strong> <span id="lblPNS"></span></p>
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-lg" onclick="Prev(5)">Anterior</button>
                        <button type="submit" class="btn btn-success btn-lg">Guardar Rol</button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sweetalert/sweetalert.min.js"></script>
    <script>
        const form = document.getElementById('wizardForm');
        let currentStep = 1;

        // Impedir ENTER accidental
        form.addEventListener('keydown', e => { if (e.key === 'Enter') e.preventDefault(); });

        function showError(msg) {
            const summary = document.querySelector('.text-danger.mb-3');
            summary.innerHTML = `<ul><li>${msg}</li></ul>`;
            summary.style.display = 'block';
        }
        function clearError() {
            const summary = document.querySelector('.text-danger.mb-3');
            summary.innerHTML = '';
            summary.style.display = 'none';
        }

        function Next(step) {
            clearError();

            if (step === 1) {
                if (!document.getElementById('NombreRol').value.trim()) {
                    showError('El nombre del rol es obligatorio.');
                    return;
                }
            }
            if (step === 2) {
                const marc = document.querySelectorAll('input[name="ListaMenusSeleccionados"]:checked');
                if (!marc.length) {
                    showError('Debe seleccionar al menos un Menú para el Rol.');
                    return;
                }
                const selIni = document.getElementById('MenuInicioSeleccionadoId');
                selIni.innerHTML = '<option value="">Seleccione...</option>';
                marc.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.value;
                    opt.text = item.getAttribute('data-nombre') || item.parentElement.querySelector('label').innerText.trim();
                    selIni.appendChild(opt);
                });
            }
            if (step === 3) {
                if (!document.getElementById('MenuInicioSeleccionadoId').value) {
                    showError('Debes elegir un Menú de inicio.');
                    return;
                }
            }
            if (step === 4) {
                if (!document.querySelectorAll('input[name="ListaPNSSeleccionados"]:checked').length) {
                    showError('Debe seleccionar al menos un País/Negocio/Sistema.');
                    return;
                }
            }

            document.getElementById('paso' + step).style.display = 'none';
            const next = step + 1;
            document.getElementById('paso' + next).style.display = 'block';
            currentStep = next;

            if (currentStep === 5) {
                document.getElementById('lblNombreRol').innerText = document.getElementById('NombreRol').value.trim();
                document.getElementById('lblMenus').innerText = Array.from(
                    document.querySelectorAll('input[name="ListaMenusSeleccionados"]:checked')
                ).map(i => i.parentElement.querySelector('label').innerText.trim()).join(', ');
                document.getElementById('lblVista').innerText = document.getElementById('MenuInicioSeleccionadoId')
                    .selectedOptions[0]?.text || '';
                document.getElementById('lblPNS').innerText = Array.from(
                    document.querySelectorAll('input[name="ListaPNSSeleccionados"]:checked')
                ).map(i => i.parentElement.querySelector('label').innerText.trim()).join(', ');
            }
        }

        function Prev(step) {
            clearError();
            document.getElementById('paso' + step).style.display = 'none';
            const prev = step - 1;
            document.getElementById('paso' + prev).style.display = 'block';
            currentStep = prev;
        }
    </script>
}
