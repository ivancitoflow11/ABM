@model ABM.Models.EditarUsuarioVM

<style>
    .validation-summary-container {
        margin-bottom: 15px;
    }

    .custom-validation {
        border: 1px solid #dc3545;
        border-radius: 4px;
        padding: 10px;
        font-size: 0.9rem;
    }

    .btn-verde-gris {
        background-color: #A8C4A2;
        color: white;
        border: none;
        transition: background-color 0.3s ease;
    }

        .btn-verde-gris:hover {
            background-color: #8BAF85; /* un poco más oscuro al pasar el mouse */
            color: white;
        }

    .firma-actual-img {
        max-width: 200px;
        height: auto;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 5px;
        margin-top: 10px;
    }
</style>

<div class="col-12" style="margin-top: 90px">
    <h4 style="margin-top:5px;">Editar Usuario</h4>
    <div class="card w-100 border position-relative overflow-hidden mb-0">
        <div class="card-body p-4">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            <form asp-controller="Mantenedores" asp-action="EditarUsuario" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdUsuario)
                @Html.HiddenFor(m => m.FirmaActual)

                <div class="row">
                    <div class="col-lg-6" style="margin-top:15px;">
                        <div class="mb-3">
                            <label for="Nombre" class="form-label">Nombre</label>
                            <input class="form-control" type="text" placeholder="Ingrese nombre" asp-for="Nombre" />
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label for="Usuario" class="form-label">Nombre de Usuario</label>
                            <input class="form-control" type="text" placeholder="Nombre de usuario" asp-for="Usuario" />
                            @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label for="Rut" class="form-label">RUT</label>
                            <input class="form-control" type="text" placeholder="Ingrese RUT" asp-for="Rut" />
                            @Html.ValidationMessageFor(m => m.Rut, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label asp-for="IdGerencia" class="form-label"></label>
                            <select class="form-select" asp-for="IdGerencia" asp-items="Model.GerenciasDisponibles">
                                <option value="">Seleccione una gerencia (Opcional)...</option>
                            </select>
                            <span asp-validation-for="IdGerencia" class="text-danger"></span>
                        </div>
                        <div class="mb-3 form-check">
                            <input class="form-check-input" type="checkbox" asp-for="ResponsableFirma" />
                            <label class="form-check-label" for="ResponsableFirma">
                                @Html.DisplayNameFor(m => m.ResponsableFirma)
                            </label>
                        </div>
                    </div>

                    <div class="col-lg-6" style="margin-top:15px;">
                        <div class="mb-3">
                            <label for="Apellidos" class="form-label">Apellidos</label>
                            <input class="form-control" type="text" placeholder="Ingrese apellidos" asp-for="Apellidos" />
                            @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label for="Correo" class="form-label">Correo Electrónico</label>
                            <input class="form-control" type="email" placeholder="correo@ejemplo.com" asp-for="Correo" />
                            @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label for="Telefono" class="form-label">Teléfono</label>
                            <input class="form-control" type="text" placeholder="Ingrese un teléfono" asp-for="Telefono" />
                            @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label for="RolId" class="form-label">Rol</label>
                            <select class="form-select" asp-for="RolId" asp-items="@(new SelectList(Model.RolesDisponibles, "idRol", "nombre"))">
                                <option disabled selected value="">Seleccione un rol...</option>
                            </select>
                            @Html.ValidationMessageFor(m => m.RolId, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Firma Actual</label>
                            @if (!string.IsNullOrEmpty(Model.FirmaActual))
                            {
                                <div class="mb-2">
                                    <img src="@Url.Content(Model.FirmaActual)" alt="Firma Actual" class="firma-actual-img" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No hay una firma cargada.</p>
                            }
                        </div>
                        <div class="mb-3">
                            <label asp-for="NuevaFirma" class="form-label"></label>
                            <input class="form-control" type="file" asp-for="NuevaFirma" accept="image/*" />
                            @Html.ValidationMessageFor(m => m.NuevaFirma, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="d-flex justify-content-end gap-2 mb-3" style="margin-top: 15px;">
                            <button class="btn btn-success" type="submit" style="border-radius: 40px; width: 200px;">
                                Guardar Cambios
                            </button>
                            <a asp-action="ListaUsuarios" class="btn btn-verde-gris" style="border-radius: 40px; width: 200px;">
                                Volver
                            </a>
                        </div>
                    </div>

                </div>
            </form>

            @* Estado de la cuenta. Va fuera del formulario de edición: es su propio POST, con confirmación. *@
            <hr class="my-3" />
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <span class="fw-semibold me-2">Estado de la cuenta</span>
                    @if (Model.Habilitado)
                    {
                        <span class="badge bg-success">Habilitado</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Deshabilitado</span>
                    }
                    <div class="text-muted small mt-1">
                        @(Model.Habilitado
                            ? "Puede iniciar sesión con normalidad."
                            : "No puede iniciar sesión ni completar el código OTC. Sus sesiones abiertas se cierran.")
                    </div>
                    @if (Model.ResponsableFirma)
                    {
                        <div class="text-muted small">
                            @(Model.Habilitado
                                ? "Es responsable de firma: si se deshabilita, dejará de poder firmar."
                                : "Es responsable de firma, y mientras esté deshabilitada no puede firmar.")
                        </div>
                    }
                </div>

                @if (Model.EsCuentaPropia)
                {
                    <span class="text-muted small">No puede deshabilitar su propia cuenta.</span>
                }
                else
                {
                    <form id="formEstado" asp-controller="Mantenedores" asp-action="CambiarEstadoUsuario" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.IdUsuario" />
                        <input type="hidden" name="habilitar" value="@(Model.Habilitado ? "false" : "true")" />
                        <button type="button" id="btnCambiarEstado" class="btn @(Model.Habilitado ? "btn-outline-danger" : "btn-outline-success")" style="border-radius: 40px; width: 200px;">
                            <i class="fas @(Model.Habilitado ? "fa-user-slash" : "fa-user-check")"></i>
                            @(Model.Habilitado ? "Deshabilitar usuario" : "Habilitar usuario")
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById('formEstado');
            var boton = document.getElementById('btnCambiarEstado');
            if (!form || !boton) { return; }

            // Valor guardado en la base (no el de la casilla del formulario, que puede estar sin guardar).
            var esResponsableFirma = @(Model.ResponsableFirma ? "true" : "false");

            boton.addEventListener('click', function () {
                var deshabilitar = form.querySelector('input[name="habilitar"]').value === 'false';
                var aviso = deshabilitar
                    ? 'No podrá iniciar sesión y se cerrarán sus sesiones abiertas.'
                    : 'Podrá volver a iniciar sesión.';
                if (deshabilitar && esResponsableFirma) {
                    aviso += '<br><br><b>Esta persona es responsable de firma:</b> dejará de poder firmar mientras esté deshabilitada.';
                }
                Swal.fire({
                    icon: 'warning',
                    title: deshabilitar ? '¿Deshabilitar este usuario?' : '¿Habilitar este usuario?',
                    html: aviso,
                    showCancelButton: true,
                    confirmButtonText: deshabilitar ? 'Sí, deshabilitar' : 'Sí, habilitar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: deshabilitar ? '#dc3545' : '#28a745'
                }).then(function (resultado) {
                    if (resultado.isConfirmed) { form.submit(); }
                });
            });
        })();
    </script>
}