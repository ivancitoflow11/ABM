@model ABM.Models.ListaBlancaViewModel

@{
    ViewData["Title"] = "Crear Entrada en Lista Blanca";
}

<div class="col-12" style="margin-top: 90px">
    <h4 style="margin-top:5px;">@ViewData["Title"]</h4>
    <div class="card w-100 border position-relative overflow-hidden mb-0">
        <div class="card-body p-4">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                 <div class="alert alert-danger validation-summary-errors">
                    <span>Por favor, corrija los siguientes errores:</span>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                </div>
            }


            <form asp-action="CrearEntradaListaBlanca" method="post">
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-lg-6" style="margin-top:15px;">
                        <div class="mb-3">
                            <label asp-for="RutNumDocumento" class="form-label"></label>
                            <input asp-for="RutNumDocumento" class="form-control" placeholder="Ej: 12345678-9 o Pasaporte" />
                            <span asp-validation-for="RutNumDocumento" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="RUT" class="form-label"></label>
                            <input asp-for="RUT" class="form-control" placeholder="RUT sin DV (si aplica)" />
                            <span asp-validation-for="RUT" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DV" class="form-label"></label>
                            <input asp-for="DV" class="form-control" placeholder="DV (si aplica)" />
                            <span asp-validation-for="DV" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NumeroEmpleado" class="form-label"></label>
                            <input asp-for="NumeroEmpleado" class="form-control" />
                            <span asp-validation-for="NumeroEmpleado" class="text-danger"></span>
                        </div>
                         <div class="mb-3">
                            <label asp-for="Nombres" class="form-label"></label>
                            <input asp-for="Nombres" class="form-control" />
                            <span asp-validation-for="Nombres" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Apellidos" class="form-label"></label>
                            <input asp-for="Apellidos" class="form-control" />
                            <span asp-validation-for="Apellidos" class="text-danger"></span>
                        </div>
                        @* El campo ApellidoNombre se genera automáticamente, no necesita input si es así *@
                        @* <div class="mb-3">
                            <label asp-for="ApellidoNombre" class="form-label"></label>
                            <input asp-for="ApellidoNombre" class="form-control" readonly />
                            <span asp-validation-for="ApellidoNombre" class="text-danger"></span>
                        </div> *@
                    </div>

                    <div class="col-lg-6" style="margin-top:15px;">
                         <div class="mb-3">
                            <label asp-for="Negocio" class="form-label"></label>
                            <input asp-for="Negocio" class="form-control" />
                            <span asp-validation-for="Negocio" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Pais" class="form-label"></label>
                            <input asp-for="Pais" class="form-control" />
                            <span asp-validation-for="Pais" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Cargo" class="form-label"></label>
                            <input asp-for="Cargo" class="form-control" />
                            <span asp-validation-for="Cargo" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Departamento" class="form-label"></label>
                            <input asp-for="Departamento" class="form-control" />
                            <span asp-validation-for="Departamento" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="TipoEmpleado" class="form-label"></label>
                            <input asp-for="TipoEmpleado" class="form-control" />
                            <span asp-validation-for="TipoEmpleado" class="text-danger"></span>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="ActivoFalanet">
                            <label class="form-check-label" asp-for="ActivoFalanet"></label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="FiniquitadosFalanet">
                            <label class="form-check-label" asp-for="FiniquitadosFalanet"></label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="ActivoAd">
                            <label class="form-check-label" asp-for="ActivoAd"></label>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="d-grid gap-2 mb-3" style="display: flex; justify-content: flex-end;">
                            <button class="btn btn-success" type="submit" style="width: 300px; border-radius:40px; margin-top:15px;">Guardar Entrada</button>
                            <a asp-action="ListarEntradasListaBlanca" class="btn btn-secondary" style="width: 200px; border-radius:40px; margin-top:15px; margin-left:10px;">Cancelar</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}