@model ABM.Models.GlosaNegociosViewModel
@{
    ViewData["Title"] = "Gestión de Glosas de Negocios";
}

<style>
    #tablaGlosas .btn {
        margin-right: 5px;
    }

    .modal-lg {
        max-width: 700px;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .fw-bold {
        font-weight: bold;
    }
</style>

<h2>@ViewData["Title"]</h2>
<hr />

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card mb-4 shadow-sm">
    <div class="card-header">
        <h5 class="card-title mb-0">Crear Nueva Glosa</h5>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("GlosaNegocios", "Mantenedores", FormMethod.Post, new { @class = "needs-validation", novalidate = "" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(model => model.GlosaParaCrear, new { @class = "fw-bold form-label" })
                @Html.TextBoxFor(model => model.GlosaParaCrear, new { @class = "form-control", placeholder = "Ingrese la glosa", required = "required", maxlength = "100" })
                @Html.ValidationMessageFor(model => model.GlosaParaCrear, "", new { @class = "text-danger" })
            </div>

            <div class="row">
                <div class="form-group col-md-6">
                    @Html.LabelFor(model => model.PaisIdSeleccionado, new { @class = "fw-bold form-label" })
                    @Html.DropDownListFor(model => model.PaisIdSeleccionado, Model.PaisesDisponibles, "Seleccione País (Opcional)", new { @class = "form-select", id = "PaisIdSeleccionado" })
                    @Html.ValidationMessageFor(model => model.PaisIdSeleccionado, "", new { @class = "text-danger" })
                </div>
                <div class="form-group col-md-6">
                    @Html.LabelFor(model => model.NegocioNombreSeleccionado, new { @class = "fw-bold form-label" })
                    @Html.DropDownListFor(model => model.NegocioNombreSeleccionado, Model.NegociosDisponibles, "Seleccione Negocio (Opcional)", new { @class = "form-select", id = "NegocioNombreSeleccionado" })
                    @Html.ValidationMessageFor(model => model.NegocioNombreSeleccionado, "", new { @class = "text-danger" })
                </div>
            </div>

            <button type="submit" class="btn btn-success mt-3">
                <i class="fas fa-plus-circle"></i> Crear Glosa
            </button>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="card-title mb-0">Glosas Existentes</h5>
    </div>
    <div class="card-body">
        <div class="form-group">
            <input type="text" id="searchGlosasInput" class="form-control mb-2" placeholder="Buscar en la tabla...">
        </div>
        @if (Model.ListadoGlosas != null && Model.ListadoGlosas.Any())
        {
            <div class="table-responsive">
                <table id="tablaGlosas" class="table table-striped table-bordered table-hover" style="width:100%;">
                    <thead class="thead-dark">
                        <tr>
                            <th>Glosa</th>
                            <th>Negocio</th>
                            <th>País</th>
                            <th class="text-center" style="width: 130px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ListadoGlosas)
                        {
                            <tr id="glosaRow-@System.Web.HttpUtility.UrlEncode(item.GLOSA)?.Replace(".","").Replace(":","")">
                                <td>@Html.DisplayFor(modelItem => item.GLOSA)</td>
                                <td>@(item.NEGOCIO ?? "N/A")</td>
                                <td>@(item.PAIS ?? "N/A")</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-info btn-editar-glosa" data-glosa="@item.GLOSA" title="Editar Glosa">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    @using (Html.BeginForm("EliminarGlosaNegocios", "Mantenedores", new { glosa = item.GLOSA }, FormMethod.Post, null, new { @style = "display:inline;", @class = "form-eliminar-glosa" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-sm btn-danger btn-eliminar-glosa-trigger" title="Eliminar Glosa"
                                                data-glosa-texto="@item.GLOSA">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                No hay glosas registradas actualmente. Puede crear una utilizando el formulario de arriba.
            </div>
        }
    </div>
</div>

<div class="modal fade" id="editarGlosaModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="editarGlosaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editarGlosaModalLabel">Editar Glosa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="editarGlosaModalBody">
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando formulario...</p>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/vendor.min.js"></script> 
    <script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>
    <script src="~/js/sweetalert/sweetalert.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            var dtGlosas = $('#tablaGlosas').DataTable({
                pageLength: 10,
                dom: 'lrtip',
                lengthChange: true,
                lengthMenu: [[10, 20, 50, -1], [10, 20, 50, "Todos"]],
                language: {
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    infoEmpty: "No hay registros disponibles",
                    infoFiltered: "(filtrado de _MAX_ registros totales)",
                    zeroRecords: "No se encontraron registros coincidentes",
                    search: "Buscar:",
                    paginate: { first: "Primero", last: "Último", next: "Siguiente", previous: "Anterior" }
                },
                columns: [null, null, null, { "orderable": false, "searchable": false }],
                responsive: true
            });
            $('#searchGlosasInput').on('keyup', function () { dtGlosas.search(this.value).draw(); });

            function cargarNegocios(paisId, negocioDropdownElement, negocioSeleccionadoNombre, isModalContext) {
                negocioDropdownElement.empty().prop('disabled', true);
                var placeholderText = "Seleccione Negocio (Opcional)";
                var placeholderNoPais = "Seleccione un país primero";

                if (paisId && paisId !== "" && paisId !== "0") {
                    negocioDropdownElement.append($('<option></option>').val("").text("Cargando..."));
                    $.ajax({
                        url: '@Url.Action("ObtenerNegociosFiltradosPorPais", "Mantenedores")',
                        type: 'GET',
                        data: { idPais: paisId },
                        success: function (negocios) {
                            negocioDropdownElement.empty().prop('disabled', false);
                            var hasActualNegocios = negocios && negocios.some(n => n.value !== "");

                            if (hasActualNegocios) {
                                negocioDropdownElement.append($('<option></option>').val("").text(placeholderText));
                            }

                            if (negocios && negocios.length > 0) {
                                $.each(negocios, function (i, negocio) {
                                    if (negocio.value === "" && negocio.text && negocio.text.includes("No hay negocios")) {
                                        negocioDropdownElement.append($('<option></option>').val("").text(negocio.text));
                                    } else if (negocio.value !== "") {
                                        var option = $('<option></option>').val(negocio.value).text(negocio.text);
                                        if (negocio.value === negocioSeleccionadoNombre) {
                                            option.prop('selected', true);
                                        }
                                        negocioDropdownElement.append(option);
                                    }
                                });
                                if (negocioSeleccionadoNombre && negocioDropdownElement.val() === "" && hasActualNegocios) {
                                    negocioDropdownElement.val("");
                                } else if (!hasActualNegocios && negocios.length > 0 && negocios[0].value === "") {
                                    negocioDropdownElement.val("");
                                }
                            } else {
                                negocioDropdownElement.append($('<option></option>').val("").text("No hay negocios para este país"));
                            }
                        },
                        error: function () {
                            negocioDropdownElement.empty().prop('disabled', false)
                                .append($('<option></option>').val("").text("Error al cargar"));
                        }
                    });
                } else {
                    negocioDropdownElement.prop('disabled', false)
                        .append($('<option></option>').val("").text(placeholderNoPais));
                }
            }

            var paisDropdownCrear = $('#PaisIdSeleccionado');
            var negocioDropdownCrear = $('#NegocioNombreSeleccionado');
            paisDropdownCrear.on('change', function () {
                cargarNegocios($(this).val(), negocioDropdownCrear, null, false);
            });
            if (paisDropdownCrear.val() && paisDropdownCrear.val() !== "" && paisDropdownCrear.val() !== "0") {
                var preselectedNegocioCrear = negocioDropdownCrear.val();
                cargarNegocios(paisDropdownCrear.val(), negocioDropdownCrear, preselectedNegocioCrear, false);
            }

            $(document).on('click', '.btn-editar-glosa', function () {
                var glosaId = $(this).data('glosa');
                var modalBody = $('#editarGlosaModalBody');
                var editarModalEl = document.getElementById('editarGlosaModal');
                var editarModal = bootstrap.Modal.getInstance(editarModalEl) || new bootstrap.Modal(editarModalEl);

                modalBody.html('<div class="text-center p-5"><div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"><span class="visually-hidden">Cargando...</span></div><p class="mt-2">Cargando formulario...</p></div>');
                editarModal.show();

                $.ajax({
                    url: '@Url.Action("CargarFormularioEditarGlosaModal", "Mantenedores")',
                    type: 'GET', data: { glosa: glosaId },
                    success: function (response) {
                        modalBody.html(response);
                        var formInModal = modalBody.find('form'); // Encuentra el formulario dentro del contenido cargado
                        if (formInModal.length > 0 && $.validator && $.validator.unobtrusive) {
                            $.validator.unobtrusive.parse(formInModal); // Parsea el formulario específico
                        }

                        var paisDropdownModal = modalBody.find('#PaisIdSeleccionadoModal');
                        var negocioDropdownModal = modalBody.find('#NegocioNombreSeleccionadoModal');
                        var negocioPreseleccionadoEnPartial = negocioDropdownModal.find('option[selected]').val() || negocioDropdownModal.val();

                        if (paisDropdownModal.val() && paisDropdownModal.val() !== "" && paisDropdownModal.val() !== "0") {
                            cargarNegocios(paisDropdownModal.val(), negocioDropdownModal, negocioPreseleccionadoEnPartial, true);
                        }

                        paisDropdownModal.off('change.editmodal').on('change.editmodal', function () {
                            cargarNegocios($(this).val(), negocioDropdownModal, null, true);
                        });
                    },
                    error: function () {
                        modalBody.html('<div class="alert alert-danger p-3">Error al cargar el formulario de edición.</div>');
                    }
                });
            });

            $(document).on('submit', '#formEditarGlosaModal', function (e) {
                e.preventDefault();
                var form = $(this); // 'this' es el formulario que disparó el evento submit

                // Re-validar explícitamente si es necesario o asegurarse que parse fue llamado
                if ($.validator && $.validator.unobtrusive && !form.data('unobtrusiveValidationParsed')) {
                    $.validator.unobtrusive.parse(form);
                    form.data('unobtrusiveValidationParsed', true); // Marcar como parseado
                }


                if (!form.valid || !form.valid()) { // Verificar si form.valid existe y luego llamarlo
                    console.error("jQuery Validate no está funcionando en este formulario o el formulario no es válido.");
                    // Podrías mostrar un error genérico al usuario aquí si la validación de cliente no funciona.
                    // O simplemente permitir que el servidor valide si la validación de cliente falla silenciosamente.
                    // return false; // Descomentar si quieres detener el envío si .valid() no existe o retorna false.
                }

                var modalErrorContainer = form.find('#modalEditErrorSummary');
                modalErrorContainer.hide().empty();
                form.find(".text-danger.field-validation-error").html("").removeClass("field-validation-error").addClass("field-validation-valid");
                form.find(".input-validation-error").removeClass("input-validation-error");

                var submitButton = form.find('button[type="submit"]');
                var originalButtonHtml = submitButton.html();
                submitButton.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Guardando...');

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    success: function (response) {
                        submitButton.prop('disabled', false).html(originalButtonHtml);
                        if (response.success) {
                            var currentModal = bootstrap.Modal.getInstance(document.getElementById('editarGlosaModal'));
                            if (currentModal) {
                                currentModal.hide();
                            }
                            Swal.fire({
                                title: '¡Actualizado!',
                                text: response.message,
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false,
                                didClose: () => {
                                    window.location.reload();
                                }
                            });
                        } else {
                            var errorSummaryHtml = "<strong>Por favor corrija los siguientes errores:</strong><ul class='list-unstyled mt-1'>";
                            if (response.errors) {
                                $.each(response.errors, function (key, messagesForKey) {
                                    var messageText = "";
                                    // Asegurarse que messagesForKey es un array para usar .join()
                                    if (Array.isArray(messagesForKey) && messagesForKey.length > 0) {
                                        messageText = messagesForKey.join(", ");
                                    } else if (typeof messagesForKey === 'string') { // Si es un string solo
                                        messageText = messagesForKey;
                                    } else {
                                        messageText = "Error inesperado para el campo.";
                                        console.warn("MessagesForKey no es un array ni string:", key, messagesForKey);
                                    }
                                    errorSummaryHtml += "<li>" + messageText + "</li>";

                                    var displayKey = key.replace("viewModel.", "");
                                    var fieldErrorSpan = form.find("[data-valmsg-for='" + displayKey + "']");
                                    var fieldInput = form.find("[name='" + displayKey + "'], [name$='." + displayKey + "']");

                                    if (fieldErrorSpan.length > 0) {
                                        fieldErrorSpan.html("<span>" + messageText + "</span>").show();
                                        fieldErrorSpan.removeClass("field-validation-valid").addClass("field-validation-error");
                                    }
                                    if (fieldInput.length > 0) {
                                        fieldInput.addClass("input-validation-error").removeClass("valid");
                                    }
                                });
                            } else if (response.message) {
                                errorSummaryHtml += "<li>" + response.message + "</li>";
                            } else {
                                errorSummaryHtml += "<li>Ocurrió un error desconocido al procesar su solicitud.</li>";
                            }
                            errorSummaryHtml += "</ul>";
                            modalErrorContainer.html(errorSummaryHtml).show();
                        }
                    },
                    error: function (xhr) {
                        submitButton.prop('disabled', false).html(originalButtonHtml);
                        modalErrorContainer.html('<div class="alert alert-danger">Error de conexión o del servidor. Código: ' + xhr.status + '. Intente nuevamente.</div>').show();
                    }
                });
            });

            $(document).on('click', '.btn-eliminar-glosa-trigger', function (e) {
                e.preventDefault();
                var button = $(this);
                var form = button.closest('form.form-eliminar-glosa');
                var glosaTexto = button.data('glosa-texto') || "esta glosa";

                Swal.fire({
                    title: '¿Está seguro?',
                    text: "¡No podrá recuperar la glosa: \"" + glosaTexto + "\"!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, ¡eliminar!',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}