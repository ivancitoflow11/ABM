@model ABM.Models.GlosaNegocioEditViewModel
<form id="formEditarGlosaModal" method="post" action="@Url.Action("EditarGlosaNegociosModal", "Mantenedores")">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.GlosaOriginal)

    <div class="form-group">
        @Html.LabelFor(m => m.Glosa, "Glosa", new { @class = "font-weight-bold" })
        @Html.TextBoxFor(m => m.Glosa, new { @class = "form-control", placeholder = "Ingrese la glosa", required = "required", maxlength = "100" })
        @Html.ValidationMessageFor(m => m.Glosa, "", new { @class = "text-danger" })
    </div>

    <div class="form-row">
        <div class="form-group col-md-6">
            @Html.LabelFor(m => m.PaisIdSeleccionado, "País", new { @class = "font-weight-bold" })
            @Html.DropDownListFor(m => m.PaisIdSeleccionado, Model.PaisesDisponibles, "Seleccione País (Opcional)", new { @class = "form-control", id = "PaisIdSeleccionadoModal" })
            @Html.ValidationMessageFor(m => m.PaisIdSeleccionado, "", new { @class = "text-danger" })
        </div>
        <div class="form-group col-md-6">
            @Html.LabelFor(m => m.NegocioNombreSeleccionado, "Negocio", new { @class = "font-weight-bold" })
            @Html.DropDownListFor(m => m.NegocioNombreSeleccionado, Model.NegociosDisponibles, "Seleccione Negocio (Opcional)", new { @class = "form-control", id = "NegocioNombreSeleccionadoModal" })
            @Html.ValidationMessageFor(m => m.NegocioNombreSeleccionado, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group text-right">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">
            <i class="fas fa-times"></i> Cancelar
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Guardar Cambios
        </button>
    </div>
</form>