@model IEnumerable<ABM.Models.ListaUsuariosViewModel>

@{
    ViewBag.Title = "ListaUsuarios";
}
@{
    var successMessage = TempData["SuccessMessage"] as string;
}

<style>
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        background-color: #28a745 !important;
        color: white !important;
        border: none !important;
        border-radius: 4px;
        padding: 5px 10px;
        margin: 2px;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background-color: #218838 !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background-color: #218838 !important;
        color: white !important;
    }

    /* Estilo pastel suave para tabla */
    .tabla-usuarios {
        background-color: #f8fdfa;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    .tabla-usuarios thead {
        background-color: #d3f2c7; /* verde pastel */
        color: #2d572c;
    }

    .tabla-usuarios th, .tabla-usuarios td {
        vertical-align: middle;
        text-align: left;
        padding: 12px 16px;
        font-size: 14px;
    }

    .tabla-usuarios tbody tr:nth-child(even) {
        background-color: #eef9e9;
    }

    .tabla-usuarios tbody tr:hover {
        background-color: #d3f2c7;
        cursor: pointer;
    }
</style>


<div class="row" style="margin-top:70px;">
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="col-md-12">
        <div class="card mb-4">
            <div class="d-flex justify-content-end mt-5 me-3">
                <a asp-controller="Mantenedores" asp-action="Registrarse" class="btn btn-success">
                    <i class="fas fa-user-plus"></i> Crear Usuario
                </a>
            </div>
            <div class="card-body">
                <h4 class="mt-3 text-center">Listado de Usuarios</h4>
                <div class="col-lg-12 table-responsive">
                    <table id="tableLista" class="table table-bordered table-hover tabla-usuarios" style="width:100%; table-layout: auto;">
                        <thead>
                            <tr>
                                <th style="white-space: nowrap;">Nombre</th>
                                <th style="white-space: nowrap;">Apellidos</th>
                                <th style="white-space: nowrap;">RUT</th>
                                <th style="white-space: nowrap;">Teléfono</th>
                                <th style="white-space: nowrap;">Correo</th>
                                <th style="white-space: nowrap;">Usuario</th>
                                <th style="white-space: nowrap;">Acciones</th>
                            </tr>

                        </thead>
                        @if (Model != null)
                        {
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="white-space: nowrap;">@item.nombre</td>
                                        <td style="white-space: nowrap;">@item.apellidos</td>
                                        <td style="white-space: nowrap;">@item.rut</td>
                                        <td style="white-space: nowrap;">@item.telefono</td>
                                        <td style="white-space: nowrap;">@item.correo</td>
                                        <td style="white-space: nowrap;">@item.usuario</td>
                                        <td style="white-space: nowrap;">
                                            <a asp-controller="Mantenedores" asp-action="EditarUsuario" asp-route-id="@item.idUsuario" class="btn btn-secondary btn-sm">
                                                <i class="fas fa-edit"></i> Editar
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>

                </div>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            var table = $('#tableLista').DataTable({
                responsive: false,
                dom: "Bfrtip",
                lengthMenu: [[10, 20, 50, -1], [10, 20, 50, "Todos"]],
                pageLength: 20,
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ entradas",
                    infoEmpty: "Mostrando 0 a 0 de 0 entradas",
                    infoFiltered: "(filtrado de _MAX_ entradas totales)",
                    zeroRecords: "No se encontraron registros",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
                }
            });
        });
    </script>
}