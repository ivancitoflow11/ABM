	<script>
		// Script para el modal cambiarPNSModal
		document.addEventListener('DOMContentLoaded', () => {
			// 1) “Apunta” al modal por su id
			const modal = document.getElementById('cambiarPNSModal');
			if (!modal) {
				// console.warn("Modal 'cambiarPNSModal' no encontrado. El script no se ejecutará.");
				return; // Si el modal no está en la página actual, no hacer nada.
			}

			// 2) Cuando se abra, carga el contenido…
			modal.addEventListener('show.bs.modal', function () {
				const container = document.getElementById('contenidoCambiarPNS');
				if (!container) {
					console.error("Contenedor 'contenidoCambiarPNS' no encontrado dentro del modal.");
					return;
				}
				container.innerHTML = '<div class="text-center py-5">Cargando…</div>';

				fetch('@Url.Action("PnsSelectorPartial", "Home")') // Asegúrate que "Home" es el controlador correcto
					.then(response => {
						if (!response.ok) {
							throw new Error(`Error de red al cargar PnsSelectorPartial: ${response.statusText}`);
						}
						return response.text();
					})
					.then(html => {
						// inyecta partial + JSON + bindings...
						container.innerHTML = html;

						const pnsDataElement = document.getElementById('pns-data');
						if (!pnsDataElement) {
							console.error("Elemento con ID 'pns-data' (que debería contener el JSON) no encontrado en el partial.");
							container.innerHTML = '<div class="text-center py-5 text-danger">Error: Falta la configuración de datos.</div>';
							return;
						}

						let data;
						try {
							data = JSON.parse(pnsDataElement.textContent);
							if (!Array.isArray(data)) {
								console.warn("pns-data no es un array, se usará un array vacío si no se puede procesar.");
								data = []; // Fallback a array vacío si no es un array
							}
						} catch (e) {
							console.error("Error al parsear JSON de 'pns-data':", e);
							container.innerHTML = '<div class="text-center py-5 text-danger">Error: Datos de configuración inválidos.</div>';
							return;
						}

						const $pais = container.querySelector('#selectPais');
						const $nego = container.querySelector('#selectNegocio');
						const $form = container.querySelector('#formCambiarPNS');
						// Asumimos que el botón de submit tiene id="btnAplicarSeleccionPNS" en tu vista parcial
						// Si no, usa container.querySelector('button[type="submit"]') o un selector más específico.
						const $submitButton = container.querySelector('#btnAplicarSeleccionPNS') || container.querySelector('button[type="submit"]');


						if (!$pais || !$nego || !$form || !$submitButton) {
							console.error("Uno o más elementos del formulario PNS (selectPais, selectNegocio, formCambiarPNS, botón de submit) no fueron encontrados en el partial.");
							// Podrías mostrar un error en 'container' si estos elementos son cruciales
							return;
						}

						// Función para actualizar el estado del botón de submit
						function updateSubmitButtonState() {
							const paisSelected = $pais.value && $pais.value !== "";
							const negocioSelected = $nego.value && $nego.value !== "" && !$nego.disabled;
							$submitButton.disabled = !(paisSelected && negocioSelected);
						}

						// Estado inicial del botón y del select de negocio
						$nego.disabled = true; // El select de negocio empieza deshabilitado
						updateSubmitButtonState(); // El botón de submit empieza deshabilitado

						$pais.addEventListener('change', () => {
							const paisId = +$pais.value; // El '+' convierte a número

							// Limpiar opciones anteriores de negocio, añadir la opción por defecto y deshabilitar
							$nego.innerHTML = `<option value="" selected disabled>-- Selecciona un negocio --</option>`;
							$nego.disabled = true; // Deshabilitar mientras se actualiza o si no hay país

							if ($pais.value && data && Array.isArray(data)) { // Asegurar que data es un array y hay un país seleccionado
								const negociosFiltrados = data.filter(x => x.idPais === paisId);

								if (negociosFiltrados.length > 0) {
									negociosFiltrados.forEach(x => {
										const option = document.createElement('option');
										option.value = x.idNegocio;
										option.textContent = x.negocio;
										$nego.appendChild(option);
									});
									$nego.disabled = false; // Habilitar si hay negocios
								}
							}
							updateSubmitButtonState(); // Actualizar estado del botón
						});

						$nego.addEventListener('change', () => {
							updateSubmitButtonState(); // Actualizar estado del botón
						});

						$form.addEventListener('submit', e => {
							e.preventDefault();

							if ($submitButton.disabled) {
								alert("Por favor, selecciona un país y un negocio antes de aplicar."); // O una notificación más elegante
								return;
							}

							const idPais = +$pais.value;
							const paisTxt = $pais.options[$pais.selectedIndex].text;
							const idNegocio = +$nego.value;
							const negoTxt = $nego.options[$nego.selectedIndex].text;

							const antiforgeryTokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
							const antiforgeryToken = antiforgeryTokenInput ? antiforgeryTokenInput.value : null;

							if (!antiforgeryToken) {
								console.error("Antiforgery token no encontrado en el DOM.");
								alert("Error de seguridad. Por favor, recargue la página e inténtelo de nuevo.");
								return;
							}

							// Muestra un indicador de carga en el botón
							const originalButtonText = $submitButton.innerHTML;
							$submitButton.disabled = true;
							$submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Aplicando...';


							fetch('@Url.Action("CambiarPns", "Home")', { // Asegúrate que "Home" es el controlador correcto
								method: 'POST',
								headers: {
									'Content-Type': 'application/json',
									'RequestVerificationToken': antiforgeryToken
								},
								body: JSON.stringify({ idPais, pais: paisTxt, idNegocio, negocio: negoTxt })
							})
								.then(response => {
									if (!response.ok) {
										return response.json().catch(() => ({})).then(errBody => {
											throw new Error(`Error de red al cambiar PNS: ${response.statusText}. Detalles: ${errBody.message || 'No disponibles'}`);
										});
									}
									return response.json();
								})
								.then(r => {
									if (r.success) {
										// Opcional: Mostrar mensaje de éxito antes de recargar
										// alert("Selección aplicada con éxito. La página se recargará.");
										location.reload();
									} else {
										alert("No se pudo cambiar el país/negocio. " + (r.message || "Respuesta no exitosa del servidor."));
									}
								})
								.catch(error => {
									console.error("Error en fetch para CambiarPns:", error);
									alert(`Ocurrió un error al intentar cambiar el país/negocio: ${error.message}`);
								})
								.finally(() => {
									// Restaura el botón a su estado original
									$submitButton.innerHTML = originalButtonText;
									// El estado de disabled se manejará por updateSubmitButtonState si es necesario,
									// o puedes decidir si re-habilitarlo o no aquí dependiendo de la lógica post-submit.
									// Por ahora, lo dejamos que updateSubmitButtonState lo maneje en cambios subsiguientes.
									// Si el modal se cierra, no importa. Si permanece abierto,
									// y el usuario quiere cambiar de nuevo, la lógica de habilitación funcionará.
									updateSubmitButtonState(); // Re-evaluar estado del botón
								});
						});
					})
					.catch(error => {
						console.error("Error al cargar PnsSelectorPartial:", error);
						container.innerHTML = `<div class="text-center py-5 text-danger">Error al cargar el contenido: ${error.message}. Intente de nuevo.</div>`;
					});
			});
		});

	</script>

	<script>
		// Script para el support-button
		document.addEventListener('DOMContentLoaded', function () { // Asegurar que el DOM esté listo
			const supportButton = document.getElementById('support-button');
			const card = document.getElementById('support-card');

			if (supportButton && card) {
				supportButton.addEventListener('click', function () {
					if (card.style.display === "none" || card.style.display === "") {
						card.style.display = "block";
						setTimeout(() => {
							card.style.transform = "translateX(0)";
						}, 10);
					} else {
						card.style.transform = "translateX(100%)";
						setTimeout(() => {
							card.style.display = "none";
						}, 500);
					}
				});
			} else {
				// console.warn("Botón de soporte o tarjeta no encontrados.");
			}
		});
	</script>

	<script>
		// Funciones auxiliares para cookies (para la lógica de descarga)
		function getCookie(name) {
			const value = `; ${document.cookie}`;
			const parts = value.split(`; ${name}=`);
			if (parts.length === 2) return parts.pop().split(';').shift();
			return null;
		}

		function deleteCookie(name, path = '/') {
			document.cookie = name + '=; Path=' + path + '; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
		}

		function initializeDownloadButton(buttonId, fileDescription) {
			const button = document.getElementById(buttonId);
			if (!button) {
				// console.warn(`Botón de descarga con ID '${buttonId}' no encontrado.`);
				return;
			}

			button.addEventListener('click', function (event) {
				event.preventDefault();

				const originalHref = this.href;
				const downloadToken = new Date().getTime().toString();
				const successCookieName = `download_status_${downloadToken}`;
				const errorCookieName = `download_error_${downloadToken}`;

				deleteCookie(successCookieName);
				deleteCookie(errorCookieName);

				const downloadUrlWithToken = originalHref + (originalHref.includes('?') ? '&' : '?') + `downloadToken=${downloadToken}`;

				Swal.fire({
					title: 'Procesando descarga...',
					html: `Preparando tu archivo de ${fileDescription}.<br/>Por favor, espera.`,
					allowOutsideClick: false,
					allowEscapeKey: false,
					didOpen: () => {
						Swal.showLoading();
					}
				});

				const iframe = document.createElement('iframe');
				iframe.style.display = 'none';
				iframe.src = downloadUrlWithToken;
				document.body.appendChild(iframe);

				let checkCookieInterval = setInterval(function () {
					const successStatus = getCookie(successCookieName);
					const errorStatus = getCookie(errorCookieName);

					if (successStatus === 'completed') {
						clearInterval(checkCookieInterval);
						deleteCookie(successCookieName);
						if (document.body.contains(iframe)) document.body.removeChild(iframe);

						Swal.fire({
							icon: 'success',
							title: '¡Descarga Completada!',
							text: `Tu archivo de ${fileDescription} se ha descargado!.`,
							timer: 3500,
							timerProgressBar: true
						});
					} else if (errorStatus) {
						clearInterval(checkCookieInterval);
						deleteCookie(errorCookieName);
						if (document.body.contains(iframe)) document.body.removeChild(iframe);

						let errorMessageText = `No se pudo preparar el archivo de ${fileDescription}.`;
						if (errorStatus === 'nodata') {
							errorMessageText = `No hay datos disponibles para la descarga de ${fileDescription}.`;
						} else if (errorStatus === 'processing') {
							errorMessageText = `Hubo un error al procesar los datos para ${fileDescription}.`;
						}

						Swal.fire({
							icon: 'error',
							title: 'Error en la Descarga',
							text: errorMessageText
						});
					}
				}, 1000);

				setTimeout(() => {
					if (getCookie(successCookieName) === null && getCookie(errorCookieName) === null) {
						clearInterval(checkCookieInterval);
						if (document.body.contains(iframe)) document.body.removeChild(iframe);
						if (Swal.isLoading()) { // Solo si el Swal de carga sigue activo
							Swal.fire({
								icon: 'warning',
								title: 'Tiempo de Espera Agotado',
								text: 'No se recibió confirmación del servidor para la descarga. Por favor, intenta de nuevo.'
							});
						}
					}
				}, 60000);
			});
		}

		// Inicialización de los botones de descarga y manejo de TempData
		document.addEventListener('DOMContentLoaded', function () {
			initializeDownloadButton('btnDescargarFiniquitados', 'Finiquitados General');
			initializeDownloadButton('btnDescargarActivosFalanet', 'Activos Falanet');

		@if (TempData["SuccessMessage"] != null)
		{
			<text>
						Swal.fire({
							icon: 'success',
						title: '@Html.Raw(TempData["SuccessMessage"])',
						showConfirmButton: false,
						timer: 2000
							});
			</text>
		}
		@if (TempData["ErrorMessage"] != null)
		{
			<text>
						Swal.fire({
							icon: 'error',
						title: 'Atención',
						text: '@Html.Raw(TempData["ErrorMessage"])',
						showConfirmButton: true
							});
			</text>
		}
			});
	</script>

	@* <script src="/js/dashboards/dashboard1.js"></script> *@

	@await RenderSectionAsync("Scripts", required: false)

</body>
