	<script>
		document.getElementById('support-button').addEventListener('click', function () {
			const card = document.getElementById('support-card');
			if (card.style.display === "none") {
				card.style.display = "block"; // Mostrar la card
				setTimeout(() => {
					card.style.transform = "translateX(0)"; // Desplazar la card a su posición original
				}, 10); // Pequeño retraso para permitir que se aplique el display block
			} else {
				card.style.transform = "translateX(100%)"; // Desplazar la card fuera de la vista
				setTimeout(() => {
					card.style.display = "none"; // Ocultar la card después de la animación
				}, 500); // Esperar a que la animación termine
			}
		});
	</script>
	

