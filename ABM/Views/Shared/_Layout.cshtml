@inject IHttpContextAccessor HttpContextAccessor
@inject ABM.Servicios.IRepositorioUsuarios DataService
@inject ABM.Servicios.IRepositorioMenus MenuService


@{
	// 1) Obtengo el usuario y su rol (int?)
	var usuario = await DataService.ObtenerDatosUsuarioPerfilLogeado();
	IEnumerable<MenuViewModel> allMenus;

	// 2) Si idRol tiene valor, llamo al repositorio; si no, lista vacía
	if (usuario.idRol.HasValue)
	{
		allMenus = await MenuService.ObtenerMenusPorRol(usuario.idRol.Value);
	}
	else
	{
		allMenus = Enumerable.Empty<MenuViewModel>();
	}

	// 3) Filtrar sólo menús con ID válido y ordenarlos
	var menus = allMenus
		.Where(m => m.ID_Menu.HasValue)
		.OrderBy(m => m.ID_Menu.Value)
		.ToList();

	var pais = HttpContextAccessor.HttpContext.Session.GetString("Pais") ?? "";
	var negocio = HttpContextAccessor.HttpContext.Session.GetString("Negocio") ?? "";


	string fotoPerfilUrlParaLayout;
	if (usuario != null && !string.IsNullOrEmpty(usuario.FotoUrl) && usuario.FotoUrl != "avatar_default.png")
	{

		fotoPerfilUrlParaLayout = Url.Content($"~/imagenes/perfil/{usuario.FotoUrl}");
	}
	else
	{

		fotoPerfilUrlParaLayout = Url.Content("~/imagenes/perfil/avatar_default.png");
	}
}


<style>
	/* Opción general si .lds-ripple es solo para animación y no tamaño */
	.preloader img {
		width: 200px; /* Ajusta este valor al ancho deseado, por ejemplo, 200px */
		height: auto; /* Esto mantendrá la proporción original de la imagen */
	}

	/* O si la clase .lds-ripple también está involucrada en el tamaño: */
	.preloader .lds-ripple {
		width: 200px; /* Ajusta este valor */
		height: auto;
	}</style>

