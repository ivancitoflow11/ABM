@model ABM.Models.GlosaNegocioEditViewModel

<form id="formEditarGlosaModal" asp-action="EditarGlosaNegociosModal" asp-controller="Mantenedores" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.GlosaOriginal)

    <div id="modalEditErrorSummary" class="text-danger validation-summary-errors mb-3" role="alert" style="display:none;"></div>

    <div class="form-group mb-3">
        <label asp-for="Glosa" class="form-label fw-bold"></label>
        <input asp-for="Glosa" class="form-control" maxlength="100" />
        <span asp-validation-for="Glosa" class="text-danger"></span>
    </div>

    <div class="row mb-3">
        <div class="form-group col-md-6">
            <label asp-for="PaisIdSeleccionado" class="form-label fw-bold"></label>
            <select asp-for="PaisIdSeleccionado" asp-items="Model.PaisesDisponibles" class="form-select" id="PaisIdSeleccionadoModal">
                <option value="">Seleccione País (Opcional)</option>
            </select>
            <span asp-validation-for="PaisIdSeleccionado" class="text-danger"></span>
        </div>
        <div class="form-group col-md-6">
            <label asp-for="NegocioNombreSeleccionado" class="form-label fw-bold"></label>
            <select asp-for="NegocioNombreSeleccionado" asp-items="Model.NegociosDisponibles" class="form-select" id="NegocioNombreSeleccionadoModal">
                <option value="">@(Model.PaisIdSeleccionado != null && Model.PaisIdSeleccionado != "" && Model.PaisIdSeleccionado != "0" ? "Seleccione Negocio (Opcional)" : "Seleccione un país primero")</option>
            </select>
            <span asp-validation-for="NegocioNombreSeleccionado" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Guardar Cambioss
        </button>
    </div>
</form>