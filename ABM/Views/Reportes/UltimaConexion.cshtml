
@model IEnumerable<ABM.Models.UltimaConexion>
@using System.Linq
@{
    ViewData["Title"] = "Reporte de Última Conexión";
    // Texto enfocado solo en Última Conexión y Filtros
    ViewBag.TextoAyuda = "En este reporte podrá consultar el historial de acceso de los usuarios, detallando la fecha y hora de su última conexión registrada en la plataforma. Utilice el menú superior para filtrar y visualizar la actividad específica por Sistema.";
}
<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<div class="pt-5">
    <h4 class="mt-5">Reporte de Última Conexión</h4>

    <div class="mt-4">
        <div class="row">
            <div class="col-md-12">
                <div class="card mb-4">
                    <div class="card-header text-white" style="background-color: #acd743;">
                        Listado
                    </div>
                    <div class="card-body table-responsive">
                        <form method="get" asp-action="UltimaConexion"
                              class="row g-2 mb-3 justify-content-end align-items-end">
                            <div class="col-auto">
                                <label for="sistema" class="form-label">Sistema:</label>
                                <select id="sistema" name="sistema" class="form-select">
                                    <option value="">–– Todos ––</option>
                                    @foreach (var s in ViewBag.Sistemas as List<string>)
                                    {
                                        if (s == (string)ViewBag.SistemaSeleccionado)
                                        {
                                            <option value="@s" selected="selected">@s</option>
                                        }
                                        else
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-auto align-self-end">
                                <button type="submit" class="btn btn-primary">Filtrar</button>
                            </div>
                        </form>
                        <table id="file_export4"
                               class="table table-striped table-bordered nowrap"
                               style="width:100%; text-align:center; table-layout:auto;">
                            <thead>
                                <tr>
                                    <th>Rut</th>
                                    <th>DV</th>
                                    <th>Nombre Usuario</th>
                                    <th>Estado</th>
                                    <th>Última Conexión</th>
                                    <th>Fecha Finiquito</th>
                                    <th>Fecha AD</th>
                                    <th>País</th>
                                    <th>Negocio</th>
                                    <th>Sistema</th>
                                    <th>Gerencia</th>
                                    <th>Subgerencia</th>
                                </tr>
                            </thead>
                            <tbody class="table-group-divider">
                                @if (Model == null || !Model.Any())
                                {
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td class ="text-center">
                                            Sin registros</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td style="white-space:nowrap;">@item.rutdni</td>
                                            <td style="white-space:nowrap;">@item.dv</td>
                                            <td style="white-space:nowrap;">@item.nombreusuario</td>
                                            <td style="white-space:nowrap;">@item.estado</td>
                                            <td style="white-space:nowrap;">@(item.ultima_conexion ?? "-")</td>
                                            <td style="white-space:nowrap;">@(item.fecha_finiquito ?? "-")</td>
                                            <td style="white-space:nowrap;">@(item.Fecha_AD ?? "-")</td>
                                            <td style="white-space:nowrap;">@item.pais</td>
                                            <td style="white-space:nowrap;">@item.negocio</td>
                                            <td style="white-space:nowrap;">@item.sistema</td>
                                            <td style="white-space:nowrap;">@(item.Nom_Gerencia ?? "-")</td>
                                            <td style="white-space:nowrap;">@(item.Nom_Subgerencia ?? "-")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/vendor.min.js"></script>
<script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/js/dataTables.buttons.min.js"></script>
<script src="/js/jszip.min.js"></script>
<script src="/js/pdfmake.min.js"></script>
<script src="/js/vfs_fonts.js"></script>
<script src="/js/buttons.html5.min.js"></script>
<script src="/js/buttons.print.min.js"></script>
<script src="/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>