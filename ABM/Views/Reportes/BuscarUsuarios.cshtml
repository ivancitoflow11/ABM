@model IEnumerable<ABM.Models.UsersBuscar>
@using System

<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />

<div class="pt-5">
    <h4 class="mt-5">Buscar Usuarios</h4>

    <!-- Formulario de búsqueda -->
    <div class="row mb-4 ms-5">
        <form method="get" asp-action="BuscarUsuarios" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="rutDni" class="form-label">RUT</label>
                <input type="text"
                       id="rutDni"
                       name="rutDni"
                       class="form-control"
                       placeholder="Ingrese RUT"
                       value="@(ViewBag.RutDni ?? String.Empty)" />
            </div>
            <div class="col-auto d-flex align-items-center">
                <span class="fw-bold mx-2">O</span>
            </div>
            <div class="col-md-3">
                <label for="nombreUsuario" class="form-label">Nombre Usuario</label>
                <input type="text"
                       id="nombreUsuario"
                       name="nombreUsuario"
                       class="form-control"
                       placeholder="Ingrese Nombre"
                       value="@(ViewBag.NombreUsuario ?? String.Empty)" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-success">Buscar</button>
            </div>
        </form>
    </div>


    <div class="mt-4">
        <div class="row">
            <div class="col-12">
                <div class="card mb-4">
                    <div class="card-header text-white" style="background-color: #acd743;">
                        Resultados
                    </div>
                    <div class="card-body table-responsive">
                        <table id="file_export4"
                               class="table table-striped table-bordered nowrap"
                               style="width:100%; text-align:center; table-layout:auto;">
                            <thead>
                                <tr>
                                    <th>Rut</th>
                                    <th>DV</th>
                                    <th>Nombre Usuario</th>
                                    <th>Estado</th>
                                    <th>Fecha Finiquito</th>
                                    <th>Última Conexión</th>
                                    <th>Fecha AD</th>
                                    <th>País</th>
                                    <th>Negocio</th>
                                    <th>Sistema</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* 1) sin nada buscado aún *@
                                @if (string.IsNullOrWhiteSpace(ViewBag.RutDni as string)
                                && string.IsNullOrWhiteSpace(ViewBag.NombreUsuario as string))
                                {
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td>Ingrese RUT o Nombre y presione “Buscar”</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                                @* 2) ya buscaron pero no hay resultados *@
                                else if (!Model.Any())
                                {
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td>Sin registros para esos criterios</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                                @* 3) y si hay datos, los listamos *@
                                else
                                {
                                    foreach (var x in Model)
                                    {
                                        <tr>
                                            <td style="white-space:nowrap;">@(x.rutdni ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.dv ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.nombreusuario ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.estado ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.fecfiniq ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.fecultlogin ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.fechaad ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.pais ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.negocio ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.sistema ?? "-")</td>
                                        </tr>
                                    }
                                }
                            </tbody>


                            <tfoot>
                                <tr>
                                    <th>Rut</th>
                                    <th>DV</th>
                                    <th>Nombre Usuario</th>
                                    <th>Estado</th>
                                    <th>Fecha Finiquito</th>
                                    <th>Última Conexión</th>
                                    <th>Fecha AD</th>
                                    <th>País</th>
                                    <th>Negocio</th>
                                    <th>Sistema</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/vendor.min.js"></script>
    <script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="/js/dataTables.buttons.min.js"></script>
    <script src="/js/jszip.min.js"></script>
    <script src="/js/pdfmake.min.js"></script>
    <script src="/js/vfs_fonts.js"></script>
    <script src="/js/buttons.html5.min.js"></script>
    <script src="/js/buttons.print.min.js"></script>
    <script src="/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>
}
