@model IEnumerable<ABM.Models.UsuariosNoEncontrados>
@using System.Linq

<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />

<div class="pt-5">
    <h4 class="mt-5">Usuarios NO Encontrados</h4>

    <div class="mt-4">
        <div class="row">
            <div class="col-md-12">
                <div class="card mb-4">
                    <div class="card-header text-white" style="background-color: #acd743;">
                        Listado
                    </div>
                    <div class="card-body table-responsive">
                        <table id="file_export4"
                               class="table table-striped table-bordered nowrap"
                               style="width:100%; text-align:center; table-layout:auto;">
                            <thead>
                                <tr>
                                    <th>Rut</th>
                                    <th>DV</th>
                                    <th>Nombre Usuario</th>
                                    <th>Cargo</th>
                                    <th>Perfil</th>
                                    <th>Estado</th>
                                    <th>Fecha Finiquito</th>
                                    <th>País</th>
                                    <th>Negocio</th>
                                    <th>Sistema</th>
                                </tr>
                            </thead>
                            <tbody class="table-group-divider">
                                @if (Model == null || !Model.Any())
                                {
                                    <tr>
                                        <td>Sin registros</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var x in Model)
                                    {
                                        <tr>
                                            <td style="white-space:nowrap;">@(x.rutdni ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.dv ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.nombreusuario ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.cargo ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.perfil ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.estado ?? "-")</td>
                                            <td style="white-space:nowrap;">
                                                @(x.fecfiniq ?? "-")
                                            </td>
                                            <td style="white-space:nowrap;">@(x.pais ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.negocio ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.sistema ?? "-")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="table-group-divider">
                                <tr>
                                    <th>Rut</th>
                                    <th>DV</th>
                                    <th>Nombre Usuario</th>
                                    <th>Cargo</th>
                                    <th>Perfil</th>
                                    <th>Estado</th>
                                    <th>Fecha Finiquito</th>
                                    <th>País</th>
                                    <th>Negocio</th>
                                    <th>Sistema</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/vendor.min.js"></script>
    <script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="/js/dataTables.buttons.min.js"></script>
    <script src="/js/jszip.min.js"></script>
    <script src="/js/pdfmake.min.js"></script>
    <script src="/js/vfs_fonts.js"></script>
    <script src="/js/buttons.html5.min.js"></script>
    <script src="/js/buttons.print.min.js"></script>
    <script src="/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>
}
