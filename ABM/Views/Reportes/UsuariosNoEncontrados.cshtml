@model IEnumerable<ABM.Models.UsuariosNoEncontrados>
@using System.Linq
@{
    // Texto que dirá el Asistente Frank
    ViewBag.TextoAyuda = "En esta sección visualizará el listado de usuarios clasificados como 'No Encontrados', es decir, cuentas que no presentan coincidencias con la fuente de datos oficial. Utilice el filtro por Sistema para segmentar los resultados.";
}
<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<div class="pt-5">
    <h4 class="mt-5">Usuarios NO Encontrados</h4>

    <div class="mt-4">
        <div class="row">
            <div class="col-md-12">
                <div class="card mb-4">
                    <div class="card-header text-white" style="background-color: #acd743;">
                        Listado
                    </div>
                    <div class="card-body table-responsive">
                        <!-- → Formulario de filtro por sistema -->
                        <form method="get" asp-action="UsuariosNoEncontrados"
                              class="row g-2 mb-3 justify-content-end align-items-end">
                            <div class="col-auto">
                                <label for="sistema" class="form-label">Sistema:</label>
                                <select id="sistema" name="sistema" class="form-select">
                                    <option value="">–– Todos ––</option>
                                    @foreach (var s in ViewBag.Sistemas as List<string>)
                                    {
                                        if (s == (string)ViewBag.SistemaSeleccionado)
                                        {
                                            <option value="@s" selected="selected">@s</option>
                                        }
                                        else
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary">Filtrar</button>
                            </div>
                        </form>
                        <table id="file_export4"
                               class="table table-striped table-bordered nowrap"
                               style="width:100%; text-align:center; table-layout:auto;">
                            <thead>
                                <tr>
                                    <th>Rut</th>
                                    <th>DV</th>
                                    <th>Nombre Usuario</th>
                                    <th>Cargo</th>
                                    <th>Perfil</th>
                                    <th>UserId</th>
                                    <th>Estado</th>
                                    <th>Fecha Finiquito</th>
                                    <th>País</th>
                                    <th>Negocio</th>
                                    <th>Sistema</th>
                                </tr>
                            </thead>
                            <tbody class="table-group-divider">
                                @if (Model == null || !Model.Any())
                                {
                                    <tr>
                                        <td>Sin registros</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var x in Model)
                                    {
                                        <tr>
                                            <td style="white-space:nowrap;">@(x.rutdni ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.dv ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.nombreusuario ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.cargo ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.perfil ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.userid ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.estado ?? "-")</td>
                                            <td style="white-space:nowrap;">
                                                @(x.fecfiniq ?? "-")
                                            </td>
                                            <td style="white-space:nowrap;">@(x.pais ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.negocio ?? "-")</td>
                                            <td style="white-space:nowrap;">@(x.sistema ?? "-")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="table-group-divider">
                                <tr>
                                    <th>Rut</th>
                                    <th>DV</th>
                                    <th>Nombre Usuario</th>
                                    <th>Cargo</th>
                                    <th>Perfil</th>
                                    <th>UserId</th>
                                    <th>Estado</th>
                                    <th>Fecha Finiquito</th>
                                    <th>País</th>
                                    <th>Negocio</th>
                                    <th>Sistema</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/vendor.min.js"></script>
    <script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="/js/dataTables.buttons.min.js"></script>
    <script src="/js/jszip.min.js"></script>
    <script src="/js/pdfmake.min.js"></script>
    <script src="/js/vfs_fonts.js"></script>
    <script src="/js/buttons.html5.min.js"></script>
    <script src="/js/buttons.print.min.js"></script>
    <script src="/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>
}
