@model ABM.ViewModels.ConsultaUsuarioViewModel

@{
    ViewData["Title"] = "Consulta Usuario";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
        :root {
            --bg-color: #f4f7f9;
            --card-bg: #fff;
            --text: #2d3748;
            --muted: #718096;
            --border: #e2e8f0;
            --accent: #4a90e2;
            --success: #38a169;
            --shadow: rgba(0,0,0,.05);
            --active: #e9f2ff;
        }

        body {
            font-family: 'Inter',sans-serif;
            margin: 0;
            background: var(--bg-color);
            color: var(--text);
            padding: 30px 24px 40px;
            text-align: center;
        }

        h1 {
            text-align: center;
            font-size: 24px;
            font-weight: 600;
            margin: 0 0 24px;
        }

        .search-container {
            width: min(1100px, 92vw);
            margin: 0 auto 18px;
        }

        .search-box {
            position: relative;
            display: flex;
            align-items: center;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px 14px;
            transition: box-shadow .2s, border-color .2s;
        }

            .search-box:focus-within {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(74,144,226,.2);
            }

            .search-box i.fa-search {
                color: var(--muted);
                margin-right: 10px;
            }

            .search-box input {
                flex: 1;
                border: none;
                outline: none;
                font-size: 16px;
                font-family: 'Inter', sans-serif;
                text-align: center;
            }

        .clear-btn {
            background: none;
            border: none;
            color: var(--muted);
            cursor: pointer;
            padding: 4px 8px;
            margin-left: 8px;
            font-size: 16px;
            transition: color .2s;
            display: none;
        }

            .clear-btn:hover {
                color: var(--text);
            }

            .clear-btn.visible {
                display: block;
            }

        .autocomplete-list {
            position: relative;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            margin-top: 6px;
            list-style: none;
            padding: 0;
            box-shadow: 0 8px 20px var(--shadow);
            max-height: 380px;
            overflow: auto;
            text-align: center;
            display: none;
        }

            .autocomplete-list.show {
                display: block;
            }

            .autocomplete-list li {
                padding: 12px 14px;
                font-size: 15px;
                cursor: pointer;
            }

                .autocomplete-list li:hover,
                .autocomplete-list li.active {
                    background: var(--active);
                }

                .autocomplete-list li.no-results {
                    color: var(--muted);
                    cursor: default;
                }

            .autocomplete-list mark {
                background: #90EE90;
                border-radius: 3px;
                padding: 0 2px;
            }

        .export-btn {
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 16px auto;
            transition: background .2s;
        }

            .export-btn:hover {
                background: #c82333;
            }

            .export-btn i {
                font-size: 16px;
            }

        .content-wrap {
            width: min(1100px, 92vw);
            margin: 0 auto;
        }

        #printableContent {
            background: var(--bg-color);
            padding: 20px;
            border-radius: 12px;
        }

        /* Card de Datos del Usuario - Compacta */
        .user-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: 0 2px 8px var(--shadow);
            padding: 16px 20px;
            margin-bottom: 16px;
            text-align: left;
        }

            .user-card h2 {
                font-size: 13px;
                font-weight: 700;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: .5px;
                margin: 0 0 12px;
                text-align: center;
            }

            .user-card p {
                margin: 6px 0;
                font-size: 14px;
            }

        /* Cards de Estados - 4 en horizontal */
        .estados-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .estado-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: 0 2px 8px var(--shadow);
            padding: 14px 16px;
            text-align: center;
            min-height: 80px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }

            .estado-card h3 {
                font-size: 12px;
                font-weight: 700;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: .5px;
                margin: 0;
            }

        .pill {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid;
        }

        .pill--ok {
            background: #e6ffed;
            border-color: #c6f6d5;
            color: #2f855a;
        }

        .pill--muted {
            background: #edf2f7;
            border-color: #e2e8f0;
            color: #4a5568;
        }

        .pill--danger {
            background: #ffe6e6;
            border-color: #feb2b2;
            color: #c53030;
        }

        .pill--warn {
            background: #ffe8cc;
            border-color: #ffd0a8;
            color: #b7791f;
        }

        /* 👇 NUEVO - Grid para cards lado a lado */
        .dual-cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }



        /* Card de Sistemas y Negocios */
        .sistemas-card, .negocios-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: 0 2px 8px var(--shadow);
            padding: 16px 20px;
            text-align: left;
        }

            .sistemas-card h2, .negocios-card h2 {
                font-size: 13px;
                font-weight: 700;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: .5px;
                margin: 0 0 12px;
                text-align: center;
            }

        .sistema-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
        }

            .sistema-item:last-child {
                border-bottom: none;
            }

            .sistema-item > div {
                flex: 1;
            }

        .sistema-nombre {
            font-weight: 600;
            color: var(--text);
            font-size: 14px;
        }

        /* Items de negocios - mismo estilo que sistemas */
        .negocio-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
        }

            .negocio-item:last-child {
                border-bottom: none;
            }

        .negocio-nombre {
            font-weight: 600;
            color: var(--text);
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .negocio-nombre i {
                color: var(--accent);
                font-size: 13px;
            }

        .status-band {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: 0 2px 8px var(--shadow);
            padding: 14px 18px;
            color: var(--success);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-weight: 600;
            text-align: center;
            margin-top: 16px;
        }

            .status-band.error {
                color: #c53030;
                border-color: #feb2b2;
                background: #fff5f5;
            }

        @@media print {
            body {
                background: white;
            }

            .search-container,
            .export-btn {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <br />
    <br />
    <h1>Ingrese Rut o Correo</h1>

    <div class="search-container">
        <form id="searchForm" asp-action="Buscar" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text"
                       id="searchInput"
                       name="Input"
                       placeholder="Buscar por nombre, correo o RUT…"
                       value="@Model.Input"
                       autocomplete="off" />
                <button type="button" class="clear-btn" id="clearBtn" title="Limpiar">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </form>
        <ul id="autocompleteList" class="autocomplete-list"></ul>
    </div>

    @if (Model.Usuario != null)
    {
        <button class="export-btn" onclick="exportToPDF()">
            <i class="fas fa-file-pdf"></i>
            Exportar a PDF
        </button>

        <div class="content-wrap">
            <div id="printableContent">
                <!-- Datos del Usuario - Compacto -->
                <div class="user-card">
                    <h2>Datos del Usuario</h2>
                    <p><strong>Nombre:</strong> @Model.Usuario.Nombre</p>
                    <p><strong>Correo:</strong> @Model.Usuario.Correo</p>
                    <p><strong>RUT:</strong> @Model.Usuario.Rut</p>
                </div>

                <!-- Estados - 4 Cards Horizontales -->
                <div class="estados-grid">
                    <!-- AD -->
                    <div class="estado-card">
                        <h3>Active Directory</h3>
                        @{
                            var adTextRaw = string.IsNullOrWhiteSpace(Model?.EstadoAD) ? "NO ENCONTRADO" : Model.EstadoAD;
                            var adTextUpper = adTextRaw.Trim().ToUpper();
                            var adClass = adTextUpper.Contains("ACTIVO") ? "pill pill--ok"
                            : adTextUpper.Contains("NO ENCONTRADO") ? "pill pill--warn"
                            : "pill pill--muted";
                        }
                        <span class="@adClass">@adTextRaw</span>

                        @if (adTextUpper.Contains("ACTIVO") && !string.IsNullOrWhiteSpace(Model.UltimoLoginAD))
                        {
                            <p style="font-size: 12px; color: var(--muted); margin-top: 8px;">
                                Último acceso: @Model.UltimoLoginAD
                            </p>
                        }
                    </div>

                    <!-- Finiquitado -->
                    <div class="estado-card">
                        <h3>Finiquitado</h3>
                        @{
                            var finiqText = Model.EsFiniquitado ? "FINIQUITADO" : "NO FINIQUITADO";
                            var finiqUpper = finiqText.ToUpper();
                            var finiqClass = finiqUpper == "FINIQUITADO" ? "pill pill--danger"
                            : finiqUpper == "NO ENCONTRADO" ? "pill pill--warn"
                            : "pill pill--ok";
                        }
                        <span class="@finiqClass">@finiqText</span>

                        @if (Model.EsFiniquitado && Model.FechaFiniquito.HasValue)
                        {
                            <p style="font-size: 12px; color: var(--muted); margin-top: 8px;">
                                Fecha: @Model.FechaFiniquito.Value.ToString("dd/MM/yyyy")
                            </p>
                        }
                    </div>

                    <!-- SPR -->
                    <div class="estado-card">
                        <h3>SPR</h3>
                        @{
                            var sprClass = Model.SprActivo ? "pill pill--ok" : "pill pill--muted";
                        }
                        <span class="@sprClass">@(Model.SprActivo ? "ACTIVO" : "NO ACTIVO")</span>
                    </div>

                    <!-- Emp.Central -->
                    <div class="estado-card">
                        <h3>Emp. Central</h3>
                        @{
                            var empClass = Model.EmpCentralActivo ? "pill pill--ok" : "pill pill--muted";
                        }
                        <span class="@empClass">@(Model.EmpCentralActivo ? "ACTIVO" : "NO ACTIVO")</span>
                    </div>
                </div>

                <!-- 👇 NUEVO - Grid con dos cards lado a lado -->
                <div class="dual-cards-grid">
                    <!-- Card de Negocios -->
                    <div class="negocios-card">
                        <h2>Negocios Asignados</h2>
                        @if (Model.NegociosUnicos != null && Model.NegociosUnicos.Any())
                        {
                            @foreach (var negocio in Model.NegociosUnicos)
                            {
                                <div class="negocio-item">
                                    <span class="negocio-nombre">
                                        <i class="fas fa-building"></i>
                                        @negocio
                                    </span>
                                    <span class="pill pill--ok">ASIGNADO</span>
                                </div>
                            }
                        }
                        else
                        {
                            <p style="color: var(--muted); text-align: center; padding: 20px 0;">Sin negocios asignados</p>
                        }
                    </div>

                    <!-- Card de Sistemas -->
                    <div class="sistemas-card">
                        <h2>Sistemas Asignados</h2>
                        @if (Model.Sistemas != null && Model.Sistemas.Any())
                        {
                            @foreach (var sistema in Model.Sistemas)
                            {
                                var estadoSistema = (sistema.estado ?? "").ToUpper() == "ACTIVO" ? "pill pill--ok" : "pill pill--muted";
                                <div class="sistema-item">
                                    <div>
                                        <span class="sistema-nombre">@sistema.sistema</span>
                                        <p style="font-size: 12px; color: var(--muted); margin: 4px 0 0 0;">
                                            @sistema.NegocioPais
                                        </p>
                                    </div>
                                    <span class="@estadoSistema">@sistema.estado</span>
                                </div>
                            }
                        }
                        else
                        {
                            <p style="color: var(--muted); text-align: center; padding: 20px 0;">Sin sistemas asignados</p>
                        }
                    </div>
                </div>

                @{
                    var hayProblema = Model.EsFiniquitado && (Model.SprActivo || Model.EmpCentralActivo);
                }

                @if (hayProblema)
                {
                    <div class="status-band error">
                        <i class="fas fa-exclamation-triangle"></i>
                        ¡ALERTA! El usuario está finiquitado pero activo en sistemas.
                    </div>
                }
                else
                {
                    <div class="status-band">
                        <i class="fas fa-check-circle"></i>
                        El Usuario no presenta problemas.
                    </div>
                }
            </div>
        </div>
    }

    <script>
        const searchInput = document.getElementById('searchInput');
        const clearBtn = document.getElementById('clearBtn');
        const autocompleteList = document.getElementById('autocompleteList');
        const searchForm = document.getElementById('searchForm');

        let suggestions = [];
        let activeIndex = -1;
        let searchTimer = null;

        function toggleClearBtn() {
            if (searchInput.value.length > 0) {
                clearBtn.classList.add('visible');
            } else {
                clearBtn.classList.remove('visible');
            }
        }

        clearBtn.addEventListener('click', function() {
            searchInput.value = '';
            autocompleteList.innerHTML = '';
            autocompleteList.classList.remove('show');
            suggestions = [];
            activeIndex = -1;
            toggleClearBtn();
            searchInput.focus();

            if (document.querySelector('.content-wrap')) {
                window.location.href = '/ConsultaUsuario/Buscar';
            }
        });

        searchInput.addEventListener('input', function() {
            toggleClearBtn();

            const term = searchInput.value.trim();

            if (searchTimer) clearTimeout(searchTimer);

            if (term.length < 3) {
                autocompleteList.innerHTML = '';
                autocompleteList.classList.remove('show');
                return;
            }

            searchTimer = setTimeout(() => {
                fetch(`/ConsultaUsuario/Autocomplete?term=${encodeURIComponent(term)}`)
                    .then(r => r.json())
                    .then(data => {
                        suggestions = data || [];
                        renderSuggestions(term);
                    });
            }, 200);
        });

        function renderSuggestions(term) {
            autocompleteList.innerHTML = '';
            activeIndex = -1;

            if (!suggestions.length) {
                const li = document.createElement('li');
                li.className = 'no-results';
                li.textContent = 'Sin resultados';
                autocompleteList.appendChild(li);
                autocompleteList.classList.add('show');
                return;
            }

            suggestions.forEach((item, idx) => {
                const li = document.createElement('li');
                const display = item.correo || item.rut || 'sin dato';
                const fullText = `${item.nombre} (${display})`;

                const regex = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
                li.innerHTML = fullText.replace(regex, '<mark>$1</mark>');

                li.addEventListener('click', () => selectSuggestion(idx));
                autocompleteList.appendChild(li);
            });

            autocompleteList.classList.add('show');
        }

        function selectSuggestion(idx) {
            if (idx < 0 || idx >= suggestions.length) return;

            const item = suggestions[idx];
            const value = (item.nombre && item.nombre.trim())
                       || (item.correo && item.correo.trim())
                       || (item.rut && item.rut.trim())
                       || '';

            if (!value) return;

            searchInput.value = value;
            autocompleteList.innerHTML = '';
            autocompleteList.classList.remove('show');
            searchForm.submit();
        }

        searchInput.addEventListener('keydown', function(e) {
            const items = autocompleteList.querySelectorAll('li:not(.no-results)');

            if (!items.length) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                activeIndex = (activeIndex + 1) % items.length;
                updateActive(items);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                activeIndex = activeIndex <= 0 ? items.length - 1 : activeIndex - 1;
                updateActive(items);
            } else if (e.key === 'Enter' && activeIndex >= 0) {
                e.preventDefault();
                selectSuggestion(activeIndex);
            } else if (e.key === 'Escape') {
                autocompleteList.innerHTML = '';
                autocompleteList.classList.remove('show');
            }
        });

        function updateActive(items) {
            items.forEach((item, idx) => {
                if (idx === activeIndex) {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.search-container')) {
                autocompleteList.innerHTML = '';
                autocompleteList.classList.remove('show');
            }
        });

        // Función para exportar a PDF
        function exportToPDF() {
            const element = document.getElementById('printableContent');
            const opt = {
                margin: 10,
                filename: 'consulta_usuario.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(element).save();
        }

        toggleClearBtn();
    </script>
</body>
</html>