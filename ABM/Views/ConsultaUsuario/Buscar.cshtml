@model ABM.ViewModels.ConsultaUsuarioViewModel

@{
    ViewData["Title"] = "Consulta Usuario";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --bg-color: #f4f7f9;
            --card-bg: #fff;
            --text: #2d3748;
            --muted: #718096;
            --border: #e2e8f0;
            --accent: #4a90e2;
            --success: #38a169;
            --shadow: rgba(0,0,0,.05);
            --active: #e9f2ff;
        }

        body {
            font-family: 'Inter',sans-serif;
            margin: 0;
            background: var(--bg-color);
            color: var(--text);
            padding: 30px 24px 40px;
            text-align: center;
        }

        h1 {
            text-align: center;
            font-size: 24px;
            font-weight: 600;
            margin: 0 0 24px;
        }

        .search-container {
            width: min(1100px, 92vw);
            margin: 0 auto 18px;
        }

        .search-box {
            position: relative;
            display: flex;
            align-items: center;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px 14px;
            transition: box-shadow .2s, border-color .2s;
        }

        .search-box:focus-within {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(74,144,226,.2);
        }

        .search-box i.fa-search {
            color: var(--muted);
            margin-right: 10px;
        }

        .search-box input {
            flex: 1;
            border: none;
            outline: none;
            font-size: 16px;
            font-family: 'Inter', sans-serif;
            text-align: center;
        }

        .clear-btn {
            background: none;
            border: none;
            color: var(--muted);
            cursor: pointer;
            padding: 4px 8px;
            margin-left: 8px;
            font-size: 16px;
            transition: color .2s;
            display: none;
        }

        .clear-btn:hover {
            color: var(--text);
        }

        .clear-btn.visible {
            display: block;
        }

        .autocomplete-list {
            position: relative;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            margin-top: 6px;
            list-style: none;
            padding: 0;
            box-shadow: 0 8px 20px var(--shadow);
            max-height: 380px;
            overflow: auto;
            text-align: center;
            display: none;
        }

        .autocomplete-list.show {
            display: block;
        }

        .autocomplete-list li {
            padding: 12px 14px;
            font-size: 15px;
            cursor: pointer;
        }

        .autocomplete-list li:hover,
        .autocomplete-list li.active {
            background: var(--active);
        }

        .autocomplete-list li.no-results {
            color: var(--muted);
            cursor: default;
        }

        .autocomplete-list mark {
            background: #90EE90;
            border-radius: 3px;
            padding: 0 2px;
        }

        .cards-wrap {
            width: min(1100px, 92vw);
            margin: 8px auto 20px;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 4px 12px var(--shadow);
            padding: 22px;
            text-align: left;
        }

        .card-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .5px;
            margin: 0 0 14px;
            text-align: center;
        }

        .card p {
            margin: 8px 0;
            font-size: 15px;
        }

        .pill {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            border: 1px solid;
        }

        .pill--ok {
            background: #e6ffed;
            border-color: #c6f6d5;
            color: #2f855a;
        }

        .pill--muted {
            background: #edf2f7;
            border-color: #e2e8f0;
            color: #4a5568;
        }

        .pill--danger {
            background: #ffe6e6;
            border-color: #feb2b2;
            color: #c53030;
        }

        .pill--warn {
            background: #ffe8cc;
            border-color: #ffd0a8;
            color: #b7791f;
        }

        .status-band {
            width: min(1100px, 92vw);
            margin: 8px auto 0;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 4px 12px var(--shadow);
            padding: 16px 18px;
            color: var(--success);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-weight: 600;
            text-align: center;
        }

        .status-band.error {
            color: #c53030;
            border-color: #feb2b2;
            background: #fff5f5;
        }
    </style>
</head>
<body>
    <br />
    <br />
    <h1>Ingrese Rut o Correo</h1>

    <div class="search-container">
        <form id="searchForm" asp-action="Buscar" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text"
                       id="searchInput"
                       name="Input"
                       placeholder="Buscar por nombre, correo o RUT…"
                       value="@Model.Input"
                       autocomplete="off" />
                <button type="button" class="clear-btn" id="clearBtn" title="Limpiar">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </form>
        <ul id="autocompleteList" class="autocomplete-list"></ul>
    </div>

    @if (Model.Usuario != null)
    {
        <div class="cards-wrap">
            <div class="cards-grid">
                <!-- Card 1: Datos del Usuario -->
                <div class="card">
                    <h2 class="card-title">Datos del Usuario</h2>
                    <p><strong>Nombre:</strong> @Model.Usuario.Nombre</p>
                    <p><strong>Correo:</strong> @Model.Usuario.Correo</p>
                    <p><strong>RUT:</strong> @Model.Usuario.Rut</p>
                </div>

                <!-- Card 2: Estado AD + Finiquitado + SPR/Emp.Central -->
                <div class="card">
                    <h2 class="card-title">Estado AD</h2>
                    @{
                        var adTextRaw = string.IsNullOrWhiteSpace(Model?.EstadoAD) ? "NO ENCONTRADO" : Model.EstadoAD;
                        var adTextUpper = adTextRaw.Trim().ToUpper();
                        var adClass = adTextUpper.Contains("ACTIVO") ? "pill pill--ok"
                        : adTextUpper.Contains("NO ENCONTRADO") ? "pill pill--warn"
                        : "pill pill--muted";
                    }
                    <p><strong>AD:</strong> <span class="@adClass">@adTextRaw</span></p>

                    @{
                        var finiqText = Model.EsFiniquitado ? "FINIQUITADO" : "NO FINIQUITADO";
                        var finiqUpper = finiqText.ToUpper();
                        var finiqClass = finiqUpper == "FINIQUITADO" ? "pill pill--danger"
                        : finiqUpper == "NO ENCONTRADO" ? "pill pill--warn"
                        : "pill pill--ok";
                    }
                    <p><strong>FINIQUITADO:</strong> <span class="@finiqClass">@finiqText</span></p>

                    @{
                        var sprClass = Model.SprActivo ? "pill pill--ok" : "pill pill--muted";
                        var empClass = Model.EmpCentralActivo ? "pill pill--ok" : "pill pill--muted";
                    }
                    <p><strong>SPR:</strong> <span class="@sprClass">@(Model.SprActivo ? "ACTIVO" : "NO ACTIVO")</span></p>
                    <p><strong>EMP.CENTRAL:</strong> <span class="@empClass">@(Model.EmpCentralActivo ? "ACTIVO" : "NO ACTIVO")</span></p>
                </div>

                <!-- Card 3: Sistemas - NUEVA -->
                <div class="card">
                    <h2 class="card-title">Sistemas Asignados</h2>
                    @if (Model.Sistemas != null && Model.Sistemas.Any())
                    {
                        <div style="max-height: 250px; overflow-y: auto;">
                            @foreach (var sistema in Model.Sistemas)
                            {
                                <div style="margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border);">
                                    <p style="margin: 4px 0; font-weight: 600; color: var(--accent);">@sistema.Sistema</p>
                                    <p style="margin: 4px 0; font-size: 13px;"><strong>País:</strong> @sistema.Pais</p>
                                    <p style="margin: 4px 0; font-size: 13px;"><strong>Negocio:</strong> @sistema.Negocio</p>
                                    <p style="margin: 4px 0; font-size: 13px;"><strong>Cargo:</strong> @sistema.Cargospr</p>
                                    @{
                                        var estadoSistema = sistema.Estado?.ToUpper() == "ACTIVO" ? "pill pill--ok" : "pill pill--muted";
                                    }
                                    <p style="margin: 4px 0;"><span class="@estadoSistema">@sistema.Estado</span></p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p style="color: var(--muted); text-align: center; padding: 20px 0;">Sin sistemas asignados</p>
                    }
                </div>
            </div>
        </div>

        // Detectar si hay problema: finiquitado PERO activo en algo
        var hayProblema = Model.EsFiniquitado && (Model.SprActivo || Model.EmpCentralActivo);

        if (hayProblema)
        {
            <div class="status-band error">
                <i class="fas fa-exclamation-triangle"></i>
                ¡ALERTA! El usuario está finiquitado pero activo en sistemas.
            </div>
        }
        else
        {
            <div class="status-band">
                <i class="fas fa-check-circle"></i>
                El Usuario no presenta problemas.
            </div>
        }
    }

    <script>
        const searchInput = document.getElementById('searchInput');
        const clearBtn = document.getElementById('clearBtn');
        const autocompleteList = document.getElementById('autocompleteList');
        const searchForm = document.getElementById('searchForm');

        let suggestions = [];
        let activeIndex = -1;
        let searchTimer = null;

        function toggleClearBtn() {
            if (searchInput.value.length > 0) {
                clearBtn.classList.add('visible');
            } else {
                clearBtn.classList.remove('visible');
            }
        }

        clearBtn.addEventListener('click', function() {
            searchInput.value = '';
            autocompleteList.innerHTML = '';
            autocompleteList.classList.remove('show');
            suggestions = [];
            activeIndex = -1;
            toggleClearBtn();
            searchInput.focus();

            if (document.querySelector('.cards-wrap')) {
                window.location.href = '/ConsultaUsuario/Buscar';
            }
        });

        searchInput.addEventListener('input', function() {
            toggleClearBtn();

            const term = searchInput.value.trim();

            if (searchTimer) clearTimeout(searchTimer);

            if (term.length < 3) {
                autocompleteList.innerHTML = '';
                autocompleteList.classList.remove('show');
                return;
            }

            searchTimer = setTimeout(() => {
                fetch(`/ConsultaUsuario/Autocomplete?term=${encodeURIComponent(term)}`)
                    .then(r => r.json())
                    .then(data => {
                        suggestions = data || [];
                        renderSuggestions(term);
                    });
            }, 200);
        });

        function renderSuggestions(term) {
            autocompleteList.innerHTML = '';
            activeIndex = -1;

            if (!suggestions.length) {
                const li = document.createElement('li');
                li.className = 'no-results';
                li.textContent = 'Sin resultados';
                autocompleteList.appendChild(li);
                autocompleteList.classList.add('show');
                return;
            }

            suggestions.forEach((item, idx) => {
                const li = document.createElement('li');
                const display = item.correo || item.rut || 'sin dato';
                const fullText = `${item.nombre} (${display})`;

                const regex = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
                li.innerHTML = fullText.replace(regex, '<mark>$1</mark>');

                li.addEventListener('click', () => selectSuggestion(idx));
                autocompleteList.appendChild(li);
            });

            autocompleteList.classList.add('show');
        }

        function selectSuggestion(idx) {
            if (idx < 0 || idx >= suggestions.length) return;

            const item = suggestions[idx];
            const value = (item.nombre && item.nombre.trim())
                       || (item.correo && item.correo.trim())
                       || (item.rut && item.rut.trim())
                       || '';

            if (!value) return;

            searchInput.value = value;
            autocompleteList.innerHTML = '';
            autocompleteList.classList.remove('show');
            searchForm.submit();
        }

        searchInput.addEventListener('keydown', function(e) {
            const items = autocompleteList.querySelectorAll('li:not(.no-results)');

            if (!items.length) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                activeIndex = (activeIndex + 1) % items.length;
                updateActive(items);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                activeIndex = activeIndex <= 0 ? items.length - 1 : activeIndex - 1;
                updateActive(items);
            } else if (e.key === 'Enter' && activeIndex >= 0) {
                e.preventDefault();
                selectSuggestion(activeIndex);
            } else if (e.key === 'Escape') {
                autocompleteList.innerHTML = '';
                autocompleteList.classList.remove('show');
            }
        });

        function updateActive(items) {
            items.forEach((item, idx) => {
                if (idx === activeIndex) {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.search-container')) {
                autocompleteList.innerHTML = '';
                autocompleteList.classList.remove('show');
            }
        });

        toggleClearBtn();
    </script>
</body>
</html>