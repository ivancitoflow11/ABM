@model ABM.ViewModels.ConsultaUsuarioViewModel

@{
    ViewData["Title"] = "Consulta Usuario";
}

<h2>Consulta de Usuario</h2>

<form asp-action="Buscar" method="post">
    <div class="form-group">
        <label for="input">Ingrese dato (nombre, rut o correo):</label>
        <input type="text" class="form-control" id="input" name="Input" value="@Model.Input" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Buscar</button>
</form>

@if (Model.Usuario != null)
{
    <hr />
    <h4>Resultado:</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.Usuario.NombreUsuario</td>
                <td>@Model.Usuario.MailUsuario</td>
            </tr>
        </tbody>
    </table>
}
