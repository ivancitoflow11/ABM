@model IEnumerable<Cl_matriz_diaria>

<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />
<br />
<br />
<br />
<br />
<h4>Historial de Excepciones Notificadas</h4>
<div class="card">

    <div class="card-body">
        <div class="table-responsive">
            <table id="file_export4" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Código Carga</th>
                        <th>Correo Envío</th>
                        <th>Observación</th>
                        <th>Estado</th>
@*                         <th>Llave</th> *@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var excepcion in Model)
                    {
                        <tr>
                            <td>@excepcion.idCarga</td>
                            <td>@excepcion.correo_envio</td>
                            <td>@excepcion.comentario_ex</td>
                            <td>@excepcion.estado_ex</td>
                            @* <td>@excepcion.llave_ex</td> *@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="/js/vendor.min.js"></script>
<script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/js/dataTables.buttons.min.js"></script>
<script src="/js/jszip.min.js"></script>
<script src="/js/pdfmake.min.js"></script>
<script src="/js/vfs_fonts.js"></script>
<script src="/js/buttons.html5.min.js"></script>
<script src="/js/buttons.print.min.js"></script>
<script src="/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>