        document.getElementById('GuardarExcepciones').addEventListener('click', async () => {
            let isValid = true;

            let Estado = document.getElementById('Estado');
            Estado.style.border = "";

            let Motivo = document.getElementById('Motivo');
            Motivo.style.border = "";
            let FechaHasta = document.getElementById('FechaHasta');
            FechaHasta.style.border = "";
            let Evidencia = document.getElementById('Evidencia');
            Evidencia.style.border = "";

            let Observaciones = document.getElementById('Observaciones');

            if (Estado.value === "") {
                isValid = false;
                Estado.style.border = "1px solid red";
            }
            if (Motivo.value === "") {
                isValid = false;
                Motivo.style.border = "1px solid red";
            }
            if (FechaHasta.value === "") {
                isValid = false;
                FechaHasta.style.border = "1px solid red";
            }
            if (Evidencia.value === "") {
               isValid = false;
               Evidencia.style.border = "1px solid red";
            }

            if (isValid) {
                let Ids = ObtenerListaIdsExcepcion();

                console.log(Estado.value);
                console.log(Motivo.value);
                console.log(FechaHasta.value);
                console.log(Evidencia.files[0]);
                console.log(Observaciones.value);


                const formData = new FormData();
                formData.append('IdsCarga', Ids);
                formData.append('Comentario', Observaciones.value);
                if (Evidencia != null && Evidencia !== undefined) {
                    formData.append('Archivo', Evidencia.files[0]);
                }
                formData.append('IdTipoMotivo', Number(Motivo.value));
                formData.append('FechaHasta', FechaHasta.value);
                formData.append('Estado', Estado.value);

                var res = await fetch("/Excepciones/GuardarListaExcepciones", {
                    method: "POST",
                    body: formData
                });

                res = await res.json();

                console.log(res);



                if (res.respuesta) {
                    window.location.replace("../../Excepciones/Index");

                }

            }

        });



        const ObtenerListaIdsExcepcion = () => {

            if ($.fn.DataTable.isDataTable('#tableListaFinal')) {
                $('#tableListaFinal').DataTable().destroy();
            }

            let ListaIds = [];

            let CheckUser = document.getElementsByClassName('CheckUserFinal');

            for (var i = 0; i < CheckUser.length; i++) {
                if (CheckUser[i].checked) {

                    let elem = CheckUser[i].parentNode.parentNode;

                    let Childrens = elem.children;
                    console.log(Childrens);

                    let IdCarga = (Childrens[1].firstChild == null) ? null : Childrens[1].firstChild.textContent;

                    ListaIds.push(IdCarga)
                }
            }

            var table = $('#tableListaFinal').DataTable({
                responsive: false
            });

            return ListaIds;
        };



    </script>

    <script>
        $(document).ready(function () {
            // Función para retroceder al paso anterior
            $('.prevBtn').on('click', function () {
                var currentStep = $(this).closest('.setup-content');
                var prevStepWizard = currentStep.prev('.setup-content');
                if (prevStepWizard.length) {
                    currentStep.hide();
                    prevStepWizard.show();
                }
            });

            // Elimina la funcionalidad del botón Next (si ya tienes los botones Next)
            $('.nextBtn').on('click', function (e) {
                e.preventDefault();  // Esto desactiva el comportamiento del botón Next
            });
        });
    </script>



