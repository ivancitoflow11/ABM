@model AlertaSistemaViewModel

<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alerta Sistema</title>
    <style>
        .responsive-img {
            max-width: 50%;
            height: auto;
        }

        .custom-modal-dialog {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 1.75rem auto;
            max-width: 90%;
        }

        .modal-body {
            max-height: 80vh;
            overflow-y: auto;
        }

        .table {
            width: 100%;
        }

        /* --- INICIO: NUEVOS ESTILOS PARA LA TABLA --- */
        .table-container-scroll {
            overflow-x: auto;
            width: 100%;
        }

        .table-incidencias {
            table-layout: fixed;
            min-width: 900px;
        }

            .table-incidencias th,
            .table-incidencias td {
                text-align: center;
                vertical-align: middle;
            }

                .table-incidencias th.col-negocio,
                .table-incidencias td.col-negocio,
                .table-incidencias th.col-sistema,
                .table-incidencias td.col-sistema {
                    text-align: left;
                    white-space: normal; /* Permite que el texto largo se ajuste */
                }

                .table-incidencias th.col-negocio {
                    width: 180px;
                }

                .table-incidencias th.col-sistema {
                    width: 150px;
                }

                .table-incidencias th.col-detalle {
                    width: 120px;
                }

            .table-incidencias .data-cell {
                width: 45px;
                white-space: nowrap;
            }

        .flag-img {
            width: 30px;
            height: auto;
            display: block;
            margin-left: auto;
            margin-right: auto;
        }

        .sub-header th {
            font-size: 0.8em;
            font-weight: bold;
        }
        /* --- FIN: NUEVOS ESTILOS PARA LA TABLA --- */

    </style>
</head>
<body>
    <div>
        <br />
        <br />

        <div class="row">
            <div class="col-md-12">
                <div class="d-flex justify-content-center" style="padding:10px; margin-top:20px">
                    <img src="/images/abmbanner.png" class="img-fluid responsive-img" alt="Banner" style="border-radius: 10px; opacity: 0.5;" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card mb-4">
                    <div class="card-header text-white" style="background-color: #5a6268; color: white !important;">
                        Resumen de incidencias por sistemas
                    </div>
                    <div class="card-body text-center bg-light">
                        <div style="margin-bottom:10px">Estados de Usuario:</div>
                        <div class="d-flex justify-content-center gap-4 flex-wrap">
                            <div><i class="fas fa-circle" style="color:#dc3545;"></i> Finiquitados (F.)</div>
                            <div><i class="fas fa-circle" style="color:#ffc107;"></i> No Encontrados (N.E.)</div>
                            <div><i class="fas fa-circle" style="color:#17a2b8;"></i> Duplicadas (C.D.)</div>
                        </div>
                    </div>

                    <form method="get" asp-action="AlertaSistema"
                          class="row g-2 align-items-end mb-4"
                          style="margin-left:30px; margin-top:10px">
                        <div class="col-md-3">
                            <label class="form-label">Negocio</label>
                            <select name="idNegocio" id="selectNegocio" class="form-select">
                                <option value="">Todos los negocios</option>
                                @foreach (var n in (List<ABM.Models.PaisNegocioViewModel>)ViewBag.Negocios)
                                {
                                    if (ViewBag.IdNegocioSeleccionado == n.idNegocio)
                                    {
                                        <option value="@n.idNegocio" selected>@n.negocio</option>
                                    }
                                    else
                                    {
                                        <option value="@n.idNegocio">@n.negocio</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Sistema</label>
                            <select name="idSistema" id="selectSistema" class="form-select">
                                <option value="">Todos los sistemas</option>
                                @foreach (var s in (IEnumerable<ABM.Models.Sistema>)ViewBag.Sistemas)
                                {
                                    if (ViewBag.IdSistemaSeleccionado == s.idSistema)
                                    {
                                        <option value="@s.idSistema" selected>@s.sistema</option>
                                    }
                                    else
                                    {
                                        <option value="@s.idSistema">@s.sistema</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-success" type="submit">Filtrar</button>
                        </div>
                    </form>

                    <div class="card-body table-container-scroll">
                        <table id="file_export4" class="table table-bordered table-incidencias">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="col-negocio">Negocio</th>
                                    <th rowspan="2" class="col-sistema">Sistema</th>
                                    @if (Model?.PaisesEnCabecera != null)
                                    {
                                        @foreach (var pais in Model.PaisesEnCabecera)
                                        {
                                            <th colspan="3">
                                                @if (!string.IsNullOrEmpty(pais.Bandera))
                                                {
                                                    <img src="data:image/png;base64,@pais.Bandera" alt="@pais.pais" class="flag-img" title="@pais.pais" />
                                                }
                                            </th>
                                        }
                                    }
                                    <th rowspan="2" class="col-detalle">Detalle</th>
                                </tr>
                                <tr class="sub-header">
                                    @if (Model?.PaisesEnCabecera != null)
                                    {
                                        @foreach (var pais in Model.PaisesEnCabecera)
                                        {
                                            <th class="data-cell" title="Finiquitados">F.</th>
                                            <th class="data-cell" title="No Encontrados">N.E.</th>
                                            <th class="data-cell" title="Cuentas Duplicadas">C.D.</th>
                                        }
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model?.EstadisticasAgrupadas != null)
                                {
                                    foreach (var grupo in Model.EstadisticasAgrupadas)
                                    {
                                        <tr>
                                            <td class="col-negocio">@grupo.Key.Negocio</td>
                                            <td class="col-sistema">@grupo.Key.Sistema</td>

                                            @foreach (var pais in Model.PaisesEnCabecera)
                                            {
                                                var statsPais = grupo.FirstOrDefault(g => g.Pais == pais.pais);

                                                if (statsPais != null)
                                                {
                                                    <td class="data-cell @(statsPais.Finiquitados > 0 ? "bg-danger text-white" : "")" style="cursor:pointer;"
                                                        onclick="showFiniquitadosModal('@statsPais.Sistema', '@statsPais.Pais', '@statsPais.Negocio')">
                                                        @statsPais.Finiquitados
                                                    </td>
                                                    <td class="data-cell @(statsPais.NoEncontrados > 0 ? "bg-warning text-dark" : "")" style="cursor:pointer;"
                                                        onclick="showNoEncontradosModal('@statsPais.Sistema', '@statsPais.Pais', '@statsPais.Negocio')">
                                                        @statsPais.NoEncontrados
                                                    </td>
                                                    <td class="data-cell @(statsPais.CtaDuplicadas > 0 ? "bg-info text-white" : "")" style="cursor:pointer;"
                                                        onclick="showCtasDuplicadasModal('@statsPais.Sistema', '@statsPais.Pais', '@statsPais.Negocio')">
                                                        @statsPais.CtaDuplicadas
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td class="data-cell">0</td>
                                                    <td class="data-cell">0</td>
                                                    <td class="data-cell">0</td>
                                                }
                                            }

                                            <td class="col-detalle">
                                                <button type="button" class="btn btn-success"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#detailsModal"
                                                        data-sistema="@grupo.Key.Sistema"
                                                        data-negocio="@grupo.Key.Negocio"
                                                        data-pais=""
                                                        data-total-usuarios="@grupo.Sum(g => g.TotalUsuarios)"
                                                        data-activos="@grupo.Sum(g => g.Activos)"
                                                        data-finiquitados="@grupo.Sum(g => g.Finiquitados)"
                                                        data-no-encontrados="@grupo.Sum(g => g.NoEncontrados)"
                                                        data-recontratados="@grupo.Sum(g => g.Recontratados)"
                                                        data-duplicados="@grupo.Sum(g => g.CtaDuplicadas)"
                                                        data-de1a3-dias-sin-gestion="@grupo.Sum(g => g.De1a3DiasSinGestion)"
                                                        data-de4a6-dias-sin-gestion="@grupo.Sum(g => g.De4a6DiasSinGestion)"
                                                        data-mas-de6-dias-sin-gestion="@grupo.Sum(g => g.MasDe6DiasSinGestion)">
                                                    Ver Detalles
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered custom-modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="detailsModalLabel">Detalles del Sistema</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="finiquitadosModal" tabindex="-1" aria-labelledby="finiquitadosModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered custom-modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="finiquitadosModalLabel">Detalles de Usuarios Finiquitados</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="NoEncontradosModal" tabindex="-1" aria-labelledby="NoEncontradosModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered custom-modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="NoEncontradosModalLabel">Detalles de Usuarios No Encontrados</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="CtasDuplicadasModal" tabindex="-1" aria-labelledby="CtasDuplicadasModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered custom-modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="CtasDuplicadasModalLabel">Detalles de Cuentas Duplicadas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    @section scripts {
        <script src="/js/vendor.min.js"></script>
        <script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
        <script src="/js/dataTables.buttons.min.js"></script>
        <script src="/js/jszip.min.js"></script>
        <script src="/js/pdfmake.min.js"></script>
        <script src="/js/vfs_fonts.js"></script>
        <script src="/js/buttons.html5.min.js"></script>
        <script src="/js/buttons.print.min.js"></script>

        <script>
            $(document).ready(function() {
                // Inicialización de la tabla principal con paginación, botones, etc.
                $('#file_export4').DataTable({
                     pageLength: 10,
                     // El 'dom' controla qué elementos se muestran y en qué orden.
                     // l=Length, B=Buttons, f=Filtering, r=processing, t=table, i=info, p=pagination
                     dom: 'lBfrtip',
                     buttons: [
                        { extend: 'copy', text: 'Copiar', className: 'btn btn-secondary btn-sm' },
                        { extend: 'excel', text: 'Excel', className: 'btn btn-success btn-sm' },
                        { extend: 'pdf', text: 'PDF', className: 'btn btn-danger btn-sm' }
                     ],
                     language: {
                        lengthMenu: "Mostrar _MENU_ registros",
                        search: "Buscar en tabla:",
                        info: "Mostrando _START_ a _END_ de _TOTAL_ entradas",
                        infoEmpty: "Mostrando 0 a 0 de 0 entradas",
                        infoFiltered:"(filtrado de _MAX_ totales)",
                        zeroRecords: "No se encontraron registros que coincidan",
                        paginate: {
                            next: "Siguiente",
                            previous: "Anterior"
                        }
                     }
                });
            });

            document.addEventListener('DOMContentLoaded', function () {
                var detailsModal = document.getElementById('detailsModal');
                detailsModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var modalBody = detailsModal.querySelector('.modal-body');
                    modalBody.innerHTML = `<table class="table table-bordered"><thead><tr><th>PAÍS</th><th>NEGOCIO</th><th>SISTEMA</th><th>TOTAL USUARIOS</th><th>ACTIVOS</th><th>FINIQUITADOS</th><th>NO ENCONTRADOS</th><th>RECONTRATADOS</th><th>DUPLICADOS</th><th>DE 1 A 3 DIAS</th><th>DE 4 A 6 DIAS</th><th>MÁS DE 6 DIAS</th></tr></thead><tbody><tr><td>TODOS</td><td>${button.getAttribute('data-negocio')}</td><td>${button.getAttribute('data-sistema')}</td><td>${button.getAttribute('data-total-usuarios')}</td><td>${button.getAttribute('data-activos')}</td><td>${button.getAttribute('data-finiquitados')}</td><td>${button.getAttribute('data-no-encontrados')}</td><td>${button.getAttribute('data-recontratados')}</td><td>${button.getAttribute('data-duplicados')}</td><td>${button.getAttribute('data-de1a3-dias-sin-gestion')}</td><td>${button.getAttribute('data-de4a6-dias-sin-gestion')}</td><td>${button.getAttribute('data-mas-de6-dias-sin-gestion')}</td></tr></tbody></table>`;
                });
            });

            function showFiniquitadosModal(sistema, pais, negocio) {
                var finiquitadosList = @Html.Raw(Json.Serialize(Model.ListaFiltroFiniquitados ?? new List<Finiquitados>()));
                var data = finiquitadosList.filter(f => f.sistema === sistema && f.pais === pais && f.negocio === negocio);
                var modalBody = document.querySelector('#finiquitadosModal .modal-body');
                if (data.length > 0) {
                    modalBody.innerHTML = `<table id="tablaFiniquitados" class="table table-striped" style="width:100%"><thead><tr><th>País</th><th>Negocio</th><th>Sistema</th><th>Nombre</th><th>RUT/DNI</th><th>User ID</th><th>Cargo</th><th>C. Costo</th><th>Últ. Login</th><th>Alta</th><th>Baja</th><th>Finiquito</th></tr></thead><tbody>${data.map(f => `<tr><td>${f.pais}</td><td>${f.negocio}</td><td>${f.sistema}</td><td>${f.nombreusuario}</td><td>${f.rutdni}</td><td>${f.userid}</td><td>${f.cargo}</td><td>${f.Nomccostospr}</td><td>${f.fecultlogin}</td><td>${f.fecalta}</td><td>${f.fecbaja}</td><td>${f.fecfiniq}</td></tr>`).join('')}</tbody></table>`;
                    $('#tablaFiniquitados').DataTable({ dom: "Bfrtip", buttons: ['copy', 'excel', 'pdf'], "destroy": true });
                } else {
                    modalBody.innerHTML = '<p>No hay usuarios finiquitados para esta selección.</p>';
                }
                new bootstrap.Modal(document.getElementById('finiquitadosModal')).show();
            }

            function showNoEncontradosModal(sistema, pais, negocio) {
                 var noEncontradosList = @Html.Raw(Json.Serialize(Model.ListaUsuariosNoEncontrados ?? new List<UsuariosNoEncontrados>()));
                 var data = noEncontradosList.filter(f => f.sistema === sistema && f.pais === pais && f.negocio === negocio);
                 var modalBody = document.querySelector('#NoEncontradosModal .modal-body');
                 if (data.length > 0) {
                    modalBody.innerHTML = `<table id="tablaNoEncontrados" class="table table-striped" style="width:100%"><thead><tr><th>País</th><th>Negocio</th><th>Sistema</th><th>Nombre</th><th>RUT/DNI</th><th>User ID</th><th>Cargo</th><th>C. Costo</th><th>Últ. Login</th><th>Alta</th><th>Baja</th></tr></thead><tbody>${data.map(f => `<tr><td>${f.pais}</td><td>${f.negocio}</td><td>${f.sistema}</td><td>${f.nombreusuario}</td><td>${f.rutdni}</td><td>${f.userid}</td><td>${f.cargo}</td><td>${f.Nomccostospr}</td><td>${f.fecultlogin}</td><td>${f.fecalta}</td><td>${f.fecbaja}</td></tr>`).join('')}</tbody></table>`;
                    $('#tablaNoEncontrados').DataTable({ dom: "Bfrtip", buttons: ['copy', 'excel', 'pdf'], "destroy": true });
                 } else {
                    modalBody.innerHTML = '<p>No hay usuarios no encontrados para esta selección.</p>';
                 }
                 new bootstrap.Modal(document.getElementById('NoEncontradosModal')).show();
            }

            function showCtasDuplicadasModal(sistema, pais, negocio) {
                var ctasDuplicadasList = @Html.Raw(Json.Serialize(Model.ListaUsuariosDuplicados ?? new List<UsuariosDuplicados>()));
                var data = ctasDuplicadasList.filter(f => f.sistema === sistema && f.pais === pais && f.negocio === negocio);
                var modalBody = document.querySelector('#CtasDuplicadasModal .modal-body');
                 if (data.length > 0) {
                    modalBody.innerHTML = `<table id="tablaDuplicados" class="table table-striped" style="width:100%"><thead><tr><th>País</th><th>Negocio</th><th>Sistema</th><th>Nombre</th><th>RUT/DNI</th><th>User ID</th><th>Cod. C. Costo</th><th>Cargo</th><th>Nom. C. Costo</th><th>Últ. Login</th><th>Alta</th><th>Baja</th></tr></thead><tbody>${data.map(f => `<tr><td>${f.pais}</td><td>${f.negocio}</td><td>${f.sistema}</td><td>${f.nombreusuario}</td><td>${f.rutdni}</td><td>${f.userid}</td><td>${f.codccosto}</td><td>${f.cargo}</td><td>${f.Nomccostospr}</td><td>${f.fecultlogin}</td><td>${f.fecalta}</td><td>${f.fecbaja}</td></tr>`).join('')}</tbody></table>`;
                    $('#tablaDuplicados').DataTable({ dom: "Bfrtip", buttons: ['copy', 'excel', 'pdf'], "destroy": true });
                 } else {
                    modalBody.innerHTML = '<p>No hay cuentas duplicadas para esta selección.</p>';
                 }
                 new bootstrap.Modal(document.getElementById('CtasDuplicadasModal')).show();
            }

            (function () {
                document.getElementById('selectNegocio').addEventListener('change', function () {
                    var idNeg = this.value;
                    var selSis = document.getElementById('selectSistema');
                    selSis.innerHTML = '<option value="">Cargando...</option>';
                    fetch('@Url.Action("SistemasPorNegocio", "Alertas")?idNegocio=' + idNeg)
                        .then(resp => resp.json())
                        .then(data => {
                            selSis.innerHTML = '<option value="">Todos los sistemas</option>';
                            data.forEach(function (s) {
                                selSis.innerHTML += `<option value="${s.idSistema}">${s.sistema}</option>`;
                            });
                        })
                        .catch(err => {
                            console.error('Error cargando sistemas:', err);
                            selSis.innerHTML = '<option value="">Error al cargar</option>';
                        });
                });
            })();
        </script>
    }
</body>
</html>