@model ABM.Models.CrucesPNSPageViewModel
@{
    ViewData["Title"] = "Gestión de Cruces País-Negocio-Sistema";
}

<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/datatables.net-bs4/css/dataTables.bootstrap4.min.css" /> <%-- Corregido: /lib/ en vez de /libs/ si esa es tu estructura --%>

<div class="pt-5">
    <h4 class="mt-5">Gestión de Cruces PNS</h4>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Mostrar errores de validación globales del modelo para el formulario de creación (si ModelState[string.Empty] tiene errores) *@
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null && ViewData.ModelState[string.Empty].Errors.Any())
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header text-white" style="background-color:#acd743;">
            Crear Nuevo Cruce PNS
        </div>
        <div class="card-body">
            <form asp-controller="Configuracion" asp-action="CrearCrucePNS" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="CruceParaCrear.IdPais" class="form-label"></label>
                        <select asp-for="CruceParaCrear.IdPais" asp-items="Model.CruceParaCrear.Paises" class="form-select">
                            <option value="">Seleccione País...</option>
                        </select>
                        <span asp-validation-for="CruceParaCrear.IdPais" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CruceParaCrear.IdNegocio" class="form-label"></label>
                        <select asp-for="CruceParaCrear.IdNegocio" asp-items="Model.CruceParaCrear.Negocios" class="form-select">
                            <option value="">Seleccione Negocio...</option>
                        </select>
                        <span asp-validation-for="CruceParaCrear.IdNegocio" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CruceParaCrear.IdSistema" class="form-label"></label>
                        <select asp-for="CruceParaCrear.IdSistema" asp-items="Model.CruceParaCrear.Sistemas" class="form-select">
                            <option value="">Seleccione Sistema...</option>
                        </select>
                        <span asp-validation-for="CruceParaCrear.IdSistema" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CruceParaCrear.Tabla" class="form-label"></label>
                        <input asp-for="CruceParaCrear.Tabla" class="form-control" placeholder="Nombre de la tabla asociada" />
                        <span asp-validation-for="CruceParaCrear.Tabla" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CruceParaCrear.Trans" class="form-label">Ruta (Trans)</label>
                        <input asp-for="CruceParaCrear.Trans" class="form-control" placeholder="Ruta o transacción" />
                        <span asp-validation-for="CruceParaCrear.Trans" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="CruceParaCrear.Ip" class="form-label">IP Máquina</label>
                        <input asp-for="CruceParaCrear.Ip" class="form-control" placeholder="Ej: 192.168.1.100" />
                        <span asp-validation-for="CruceParaCrear.Ip" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CruceParaCrear.Responsable" class="form-label"></label>
                        <input asp-for="CruceParaCrear.Responsable" class="form-control" placeholder="Nombre del responsable" />
                        <span asp-validation-for="CruceParaCrear.Responsable" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100">Crear Cruce</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header text-white" style="background-color:#acd743;">
            Listado de Cruces PNS
        </div>
        <div class="card-body">
            <div class="mb-3" style="width:100%; max-width:300px;">
                <input type="text" id="searchCrucesPNSInput" class="form-control" placeholder="Buscar en la tabla..." />
            </div>
            <div class="table-responsive">
                <table id="tablaCrucesPNS" class="table table-striped table-bordered nowrap" style="width:100%; text-align:center;">
                    <thead>
                        <tr>
                            <th>País</th>
                            <th>Negocio</th>
                            <th>Sistema</th>
                            <th>Tabla (PNSJT)</th>
                            <th>Ruta (Trans)</th>
                            <th>IP (PNSJT)</th>
                            <th>Responsable (PNSJT)</th>
                            <th>Estado (PNS)</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CrucesList != null && Model.CrucesList.Any())
                        {
                            @foreach (var item in Model.CrucesList)
                            {
                                <tr data-id="@item.IdPaisNegocioSistema">
                                    <td>@item.NombrePais</td>
                                    <td>@item.NombreNegocio</td>
                                    <td>@item.NombreSistema</td>
                                    <td>@item.Tabla</td>
                                    <td>@item.Trans</td>
                                    <td>@item.Ip</td>
                                    <td>@item.Responsable</td>
                                    <td>@(item.Estado == "1" ? "Activo" : (string.IsNullOrEmpty(item.Estado) ? "No definido" : item.Estado))</td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-success btn-edit-cruce"
                                                data-id="@item.IdPaisNegocioSistema"
                                                title="Editar Cruce PNS">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form asp-controller="Configuracion"
                                              asp-action="DeshabilitarCruce"
                                              asp-route-id="@item.IdPaisNegocioSistema"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()
                                            <button type="button" 
                                                    class="btn btn-sm btn-danger ms-1 btn-deshabilitar-swal" 
                                                    data-idpaisnegociosistema="@item.IdPaisNegocioSistema" 
                                                    title="Deshabilitar Cruce PNS">
                                                <i class="fas fa-link-slash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center">No hay cruces para mostrar.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editarCrucePNSModal" tabindex="-1" aria-labelledby="editarCrucePNSModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header" style="background-color:#acd743;">
                    <h5 class="modal-title text-white" id="editarCrucePNSModalLabel">Editar Cruce PNS</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="formEditarCrucePNS" method="post">
                        @* asp-controller y asp-action se setean dinámicamente con JS *@
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IdPaisNegocioSistema" id="edit-IdPaisNegocioSistema" />
                        <input type="hidden" name="Id_pns" id="edit-Id_pns" />

                        <div id="edit-validation-summary" class="alert alert-danger" style="display:none;"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label for="edit-IdPais" class="form-label">País</label>
                                <select name="IdPais" id="edit-IdPais" asp-items="Model.CruceParaCrear.Paises" class="form-select">
                                    <option value="">Seleccione País...</option>
                                </select>
                                <span data-valmsg-for="IdPais" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label for="edit-IdNegocio" class="form-label">Negocio</label>
                                <select name="IdNegocio" id="edit-IdNegocio" asp-items="Model.CruceParaCrear.Negocios" class="form-select">
                                    <option value="">Seleccione Negocio...</option>
                                </select>
                                <span data-valmsg-for="IdNegocio" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label for="edit-IdSistema" class="form-label">Sistema</label>
                                <select name="IdSistema" id="edit-IdSistema" asp-items="Model.CruceParaCrear.Sistemas" class="form-select">
                                    <option value="">Seleccione Sistema...</option>
                                </select>
                                <span data-valmsg-for="IdSistema" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="edit-Tabla" class="form-label">Nombre tabla (PNSJT)</label>
                                <input type="text" name="Tabla" id="edit-Tabla" class="form-control" />
                                <span data-valmsg-for="Tabla" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="edit-Trans" class="form-label">Ruta (Trans)</label>
                                <input type="text" name="Trans" id="edit-Trans" class="form-control" />
                                <span data-valmsg-for="Trans" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="edit-Ip" class="form-label">IP Máquina (PNSJT)</label>
                                <input type="text" name="Ip" id="edit-Ip" class="form-control" />
                                <span data-valmsg-for="Ip" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="edit-Responsable" class="form-label">Responsable (PNSJT)</label>
                                <input type="text" name="Responsable" id="edit-Responsable" class="form-control" />
                                <span data-valmsg-for="Responsable" class="text-danger"></span>
                            </div>
                        </div>


                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar Cambios</button> 
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/vendor.min.js"></script>
    <script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>
    <script src="~/js/sweetalert/sweetalert.min.js"></script>


    <script>
        $(function () {

            var dtCrucesPNS = $('#tablaCrucesPNS').DataTable({
                pageLength: 10,
                dom: 'ltip',
                lengthMenu: [[10, 20, 50, -1], [10, 20, 50, "Todos"]],
                language: {
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ entradas",
                    infoEmpty: "Mostrando 0 a 0 de 0 entradas",
                    infoFiltered: "(filtrado de _MAX_ totales)",
                    zeroRecords: "No se encontraron registros coincidentes",
                    paginate: { first: "Primero", last: "Último", next: "Siguiente", previous: "Anterior" }
                },
                columns: [
                    null, null, null, null, null, null, null, null,
                    { "orderable": false, "searchable": false }
                ]
            });

            $('#searchCrucesPNSInput').on('keyup', function () {
                dtCrucesPNS.search(this.value).draw();
            });

            var editarCruceModal = new bootstrap.Modal(document.getElementById('editarCrucePNSModal'));
            var $formEditar = $('#formEditarCrucePNS');

            $('#tablaCrucesPNS').on('click', '.btn-edit-cruce', function () {
                var cruceId = $(this).data('id');
                var actionUrl = '@Url.Action("EditarCrucePNS", "Configuracion")/' + cruceId;
                $formEditar.attr('action', actionUrl);

                $formEditar.find('.text-danger').text('');
                $formEditar.find('.is-invalid').removeClass('is-invalid');

                $.get('@Url.Action("EditarCrucePNS", "Configuracion")', { id: cruceId })
                    .done(function (response) {
                        if (response.success && response.data) {
                            var data = response.data;
                            $('#edit-IdPaisNegocioSistema').val(data.idPaisNegocioSistema);
                            $('#edit-Id_pns').val(data.id_pns || 0);
                            $('#edit-IdPais').val(data.idPais);
                            $('#edit-IdNegocio').val(data.idNegocio);
                            $('#edit-IdSistema').val(data.idSistema);
                            $('#edit-Tabla').val(data.tabla);
                            $('#edit-Trans').val(data.trans);
                            $('#edit-Ip').val(data.ip);
                            $('#edit-Responsable').val(data.responsable);
                            $('#display-Estado').val(data.estado == "1" ? "Activo" : (data.estado || "No definido"));
                            editarCruceModal.show();
                        } else {
                            alert(response.message || "Error al cargar los datos para editar.");
                        }
                    })
                    .fail(function () {
                        alert("Error de comunicación al intentar obtener los datos del Cruce PNS para editar.");
                    });
            });

            $formEditar.on('submit', function (e) {
                e.preventDefault();
                var form = this;
                var $form = $(form);
                var formData = $form.serialize();

                $form.find('.text-danger').text('');
                $form.find('.is-invalid').removeClass('is-invalid');

                $.ajax({
                    url: form.action,
                    method: form.method,
                    data: formData,
                })
                    .done(function (response) {
                        editarCruceModal.hide();

                        location.reload(); // Recargar para ver los cambios
                    })
                    .fail(function (xhr) {
                        var generalErrorMessages = [];

                        if (xhr.responseJSON) {
                            var responseData = xhr.responseJSON;

                            if (typeof responseData === 'string') {
                                generalErrorMessages.push(responseData);
                            } else if (responseData.Message) {
                                generalErrorMessages.push(responseData.Message);
                            } else {
                                $.each(responseData, function (fieldName, errorsForKey) {
                                    if (errorsForKey && errorsForKey.length > 0) {
                                        var $input = $form.find('[name="' + fieldName + '"]');
                                        var $span = $form.find('[data-valmsg-for="' + fieldName + '"]');

                                        if ($span.length) {
                                            $span.text(errorsForKey[0]);
                                            if ($input.length) {
                                                $input.addClass('is-invalid');
                                            }
                                        } else {
                                            var prefix = (fieldName && fieldName !== "") ? fieldName + ": " : "";
                                            $.each(errorsForKey, function (i, errorText) {
                                                generalErrorMessages.push(prefix + errorText);
                                            });
                                        }
                                    }
                                });
                            }
                        } else {
                            generalErrorMessages.push('Error desconocido al intentar guardar los cambios. Intente nuevamente.');
                        }

                        if (generalErrorMessages.length > 0) {
                            alert("Por favor corrija los siguientes errores:\n- " + generalErrorMessages.join('\n- '));
                        }
                    });
            });

            $('#tablaCrucesPNS').on('click', '.btn-deshabilitar-swal', function () {
                var $button = $(this);
                var form = $button.closest('form')[0]; // Obtiene el elemento DOM del formulario padre
                var idPNS = $button.data('idpaisnegociosistema');

                // Extraer información de la fila para un mensaje más descriptivo
                var $row = $button.closest('tr');
                var pais = $row.find('td:eq(0)').text(); // Asume que País es la primera columna (índice 0)
                var negocio = $row.find('td:eq(1)').text(); // Asume que Negocio es la segunda
                var sistema = $row.find('td:eq(2)').text(); // Asume que Sistema es la tercera

                Swal.fire({
                    title: '¿Está seguro?',
                    html: `Desea deshabilitar el siguiente cruce:<br><br>
                                   <div style="text-align: left; margin-left: 20px;">
                                       <strong>País:</strong> ${pais}<br>
                                       <strong>Negocio:</strong> ${negocio}<br>
                                       <strong>Sistema:</strong> ${sistema}<br>
                                       (ID: ${idPNS})
                                   </div>`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33', // Rojo para la acción de "deshabilitar"
                    cancelButtonColor: '#3085d6', // Azul estándar para cancelar
                    confirmButtonText: 'Sí, deshabilitar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Si el usuario confirma, envía el formulario
                        form.submit();
                    }
                });
            });
        });
    </script>
}