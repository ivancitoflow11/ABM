@model IEnumerable<ABM.Models.Pais>
@{
    ViewData["Title"] = "Paises";

    // repoblar en POST
    string codPaisValue = "";
    string nombreValue  = "";
    if (Context.Request.Method == "POST"
        && Context.Request.HasFormContentType)
    {
        codPaisValue = Context.Request.Form["CodPais"];
        nombreValue  = Context.Request.Form["Nombre"];
    }
}
<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />
<link rel="stylesheet" href="/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" />

<div class="pt-5">
    <h4 class="mt-5">Gestión de Países</h4>

    <!-- Creación de País -->
    <div class="card mb-4">
        <div class="card-header text-white" style="background-color:#acd743;">
            Crear País
        </div>
        <div class="card-body">
            <form asp-controller="Configuracion"
                  asp-action="CrearPais"
                  method="post"
                  enctype="multipart/form-data"
                  class="row g-3">
                 <div class="col-md-4">
                    <label class="form-label">Nombre país</label>
                    <input type="text" name="Nombre"
                           class="form-control"
                           value="@nombreValue"
                           placeholder="Ejemplo: Chile"
                           required />
                    @{
                        var msNom = ViewData.ModelState["Nombre"];
                    }
                    @if (msNom != null && msNom.Errors.Count > 0)
                    {
                        <span class="text-danger">
                            @msNom.Errors[0].ErrorMessage
                        </span>
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label">Código país</label>
                    <input type="text" name="CodPais"
                           class="form-control"
                           placeholder="Ejemplo: CHL"
                           value="@codPaisValue"
                           required />
                    @{
                        var msCod = ViewData.ModelState["CodPais"];
                    }
                    @if (msCod != null && msCod.Errors.Count > 0)
                    {
                        <span class="text-danger">
                            @msCod.Errors[0].ErrorMessage
                        </span>
                    }
                </div>
               
                <div class="col-md-4">
                    <label class="form-label">Bandera</label>
                    <input type="file" name="BanderaFile"
                           class="form-control"
                           accept="image/*" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-success">Crear</button>
                </div>
            </form>
        </div>
    </div>



    <!-- Listado de Países -->
    <div class="card mb-4">
        <div class="card-header text-white text-center" style="background-color:#acd743;">
            Listado de Países
        </div>

                <!-- Búsqueda -->
        <br />
        <br />
        <div class="mb-3" style="width:25%; margin-left:20px">
            <input type="text" id="searchInput" class="form-control"
                   placeholder="Buscar pais..." />
        </div>
        <div class="card-body table-responsive">
            <table id="tablaPaises"
                   class="table table-striped table-bordered nowrap"
                   style="width:100%; text-align:center;">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Bandera</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr data-id="@p.IdPais">
                            <td>@p.CodPais</td>
                            <td>@p.Nombre</td>
                            <td>
                                @if (!string.IsNullOrEmpty(p.Bandera))
                                {
                                    <img src="data:image/png;base64,@p.Bandera"
                                         style="width:30px; height:auto;" />
                                }
                            </td>
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-success btn-edit"
                                        data-id="@p.IdPais"
                                        title="Editar País">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Bandera</th>
                        <th>Acciones</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Modal de Edición -->
    <div class="modal fade" id="editarModal" tabindex="-1"
         aria-labelledby="editarModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header" style="background-color:#acd743;">
            <h5 class="modal-title text-white" id="editarModalLabel">Editar País</h5>
            <button type="button" class="btn-close"
                    data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body">
            <form id="formEditarPais"
                  asp-controller="Configuracion"
                  asp-action="EditarPais"
                  method="post"
                  enctype="multipart/form-data"
                  class="row g-3">
                <input type="hidden" name="IdPais" id="edit-IdPais" />
                <div class="col-md-4">
                    <label class="form-label">Código país</label>
                    <input type="text" name="CodPais" id="edit-CodPais"
                           class="form-control" required />
                    <span class="text-danger" id="errorCodPaisEdit"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Nombre país</label>
                    <input type="text" name="Nombre" id="edit-Nombre"
                           class="form-control" required />
                    <span class="text-danger" id="errorNombreEdit"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Bandera</label>
                    <input type="file" name="BanderaFile" id="edit-BanderaFile"
                           class="form-control" accept="image/*" />
                    <div id="currentBanderaPreview" class="mt-2"></div>
                </div>
                <div class="col-12 text-end">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar</button>
                </div>
            </form>
          </div>
        </div>
      </div>
    </div>
</div>

@section Scripts {
  <script src="/js/vendor.min.js"></script>
  <script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>

  <script>
    $(function() {
      // Inicializa DataTable
      var table = $('#tablaPaises').DataTable({
        pageLength: 10,
        dom: 'ltip',
        lengthMenu: [[10, 20, 50, -1], [10, 20, 50, "Todos"]],
        language: {
          lengthMenu: "Mostrar _MENU_ registros",
          info:        "Mostrando _START_ a _END_ de _TOTAL_ entradas",
          infoEmpty:   "Mostrando 0 a 0 de 0 entradas",
          infoFiltered:"(filtrado de _MAX_ totales)",
          zeroRecords: "No se encontraron registros",
          paginate: {
            first:    "Primero",
            last:     "Último",
            next:     "Siguiente",
            previous: "Anterior"
          }
        }
      });

      // Búsqueda custom
      $('#searchInput').on('keyup', function() {
        table.search(this.value).draw();
      });

      // Delegación de evento para abrir modal
      $('#tablaPaises').on('click', '.btn-edit', function() {
        var id = $(this).data('id');
        $.get('@Url.Action("EditarPais","Configuracion")', { id: id })
         .done(function(data) {
           $('#errorCodPaisEdit').text('');
           $('#errorNombreEdit').text('');
           $('#edit-IdPais').val(data.idPais);
           $('#edit-CodPais').val(data.codPais);
           $('#edit-Nombre').val(data.nombre);
           if (data.bandera) {
             $('#currentBanderaPreview').html(
               '<img src="data:image/png;base64,' + data.bandera +
               '" style="width:50px; height:auto;" />'
             );
           } else {
             $('#currentBanderaPreview').empty();
           }
           new bootstrap.Modal(
             document.getElementById('editarModal')
           ).show();
         });
      });

      // Submit AJAX del form de edición
      $('#formEditarPais').on('submit', function(e) {
        e.preventDefault();
        var f  = this, fd = new FormData(f);
        $.ajax({
          url:         f.action,
          method:      f.method,
          data:        fd,
          processData: false,
          contentType: false
        })
        .done(function() { location.reload(); })
        .fail(function(xhr) {
          var errors = xhr.responseJSON;
          $('#errorCodPaisEdit').text(errors.CodPais || '');
          $('#errorNombreEdit').text(errors.Nombre  || '');
        });
      });
    });
  </script>
}
