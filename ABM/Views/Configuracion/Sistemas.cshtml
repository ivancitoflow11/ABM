@model IEnumerable<ABM.Models.Sistema>
@{
    ViewData["Title"] = "Sistemas";

    // Lectura de valores en POST (opción A)
    string codSistemaValue = "";
    string sistemaValue = "";
    string nriesgoValue = "";

    if (Context.Request.Method == "POST"
        && Context.Request.HasFormContentType)
    {
        codSistemaValue = Context.Request.Form["codSistema"];
        sistemaValue = Context.Request.Form["sistema"];
        nriesgoValue = Context.Request.Form["nriesgo"];
    }
}
<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />
<link rel="stylesheet" href="/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" />

<div class="pt-5">
    <h4 class="mt-5">Gestión de Sistemas</h4>

    <!-- Creación de Sistema -->
    <div class="card mb-4">
        <div class="card-header text-white" style="background-color:#acd743;">
            Crear Sistema
        </div>
        <div class="card-body">
            <form asp-controller="Configuracion"
                  asp-action="CrearSistema"
                  method="post"
                  class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">Código sistema</label>
                    <input type="text"
                           name="codSistema"
                           class="form-control"
                           value="@codSistemaValue"
                           placeholder="Ejemplo: AWS"
                           required />
                    @{
                        var msCod = ViewData.ModelState["codSistema"];
                    }
                    @if (msCod != null && msCod.Errors.Count > 0)
                    {
                        <span class="text-danger">
                            @msCod.Errors[0].ErrorMessage
                        </span>
                    }
                </div>

                <div class="col-md-4">
                    <label class="form-label">Nombre sistema</label>
                    <input type="text"
                           name="sistema"
                           class="form-control"
                           value="@sistemaValue"
                           placeholder="Ejemplo: FALABELLA"
                           required />
                    @{
                        var msNom = ViewData.ModelState["sistema"];
                    }
                    @if (msNom != null && msNom.Errors.Count > 0)
                    {
                        <span class="text-danger">
                            @msNom.Errors[0].ErrorMessage
                        </span>
                    }
                </div>

                <div class="col-md-3">
                    <label class="form-label">Nivel riesgo</label>
                    <input type="number"
                           name="nriesgo"
                           class="form-control"
                           value="@nriesgoValue"
                           min="0"
                           required />
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-success">Crear</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Listado de Sistemas -->
    <div class="card mb-4">
        <div class="card-header text-white" style="background-color:#acd743;">
            Listado de Sistemas
        </div>
        <!-- Búsqueda -->
        <br />
        <br />
        <div class="mb-3" style="width:25%; margin-left:20px">
            <input type="text" id="searchInput" class="form-control"
                   placeholder="Buscar sistema..." />
        </div>

        <div class="card-body table-responsive">
            <table id="tablaSistemas"
                   class="table table-striped table-bordered nowrap"
                   style="width:100%; text-align:center;">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Nivel riesgo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr data-id="@s.idSistema">
                            <td>@s.codSistema</td>
                            <td>@s.sistema</td>
                            <td>@s.nriesgo</td>
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-success btn-edit-sis"
                                        data-id="@s.idSistema"
                                        title="Editar Sistema">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Nivel riesgo</th>
                        <th>Acciones</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Modal de Edición -->
    <div class="modal fade" id="editarSisModal" tabindex="-1"
         aria-labelledby="editarSisModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background-color:#acd743;">
                    <h5 class="modal-title text-white" id="editarSisModalLabel">
                        Editar Sistema
                    </h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="formEditarSis"
                          asp-controller="Configuracion"
                          asp-action="EditarSistema"
                          method="post"
                          class="row g-3">
                        <input type="hidden" name="idSistema" id="edit-IdSistema" />

                        <div class="col-md-4">
                            <label class="form-label">Código sistema</label>
                            <input type="text" name="codSistema" id="edit-CodSistema"
                                   class="form-control" required />
                            <span class="text-danger" id="errorCodSis"></span>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Nombre sistema</label>
                            <input type="text" name="sistema" id="edit-Sistema"
                                   class="form-control" required />
                            <span class="text-danger" id="errorNomSis"></span>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Nivel riesgo</label>
                            <input type="number" name="nriesgo" id="edit-Nriesgo"
                                   class="form-control" min="0" required />
                        </div>

                        <div class="col-12 text-end">
                            <button type="button" class="btn btn-danger"
                                    data-bs-dismiss="modal">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-success">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/vendor.min.js"></script>
    <script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>

    <script>
        $(function () {
            // Inicializar DataTable con paginación de 10 y sin filtro integrado
            var table = $('#tablaSistemas').DataTable({
                pageLength: 10,
                dom: 'ltip',
                lengthMenu: [[10, 20, 50, -1], [10, 20, 50, "Todos"]],
                language: {
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ entradas",
                    infoEmpty: "Mostrando 0 a 0 de 0 entradas",
                    infoFiltered: "(filtrado de _MAX_ totales)",
                    zeroRecords: "No se encontraron registros",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
                }
            });

            // Búsqueda custom
            $('#searchInput').on('keyup', function () {
                table.search(this.value).draw();
            });

            // Delegación de evento para edición
            $('#tablaSistemas').on('click', '.btn-edit-sis', function () {
                var id = $(this).data('id');
                $.get('@Url.Action("EditarSistema", "Configuracion")', { id: id })
                    .done(function (d) {
                        $('#errorCodSis').text('');
                        $('#errorNomSis').text('');
                        $('#edit-IdSistema').val(d.idSistema);
                        $('#edit-CodSistema').val(d.codSistema);
                        $('#edit-Sistema').val(d.sistema);
                        $('#edit-Nriesgo').val(d.nriesgo);
                        new bootstrap.Modal(
                            document.getElementById('editarSisModal')
                        ).show();
                    });
            });

            // Submit AJAX del formulario de edición
            $('#formEditarSis').on('submit', function (e) {
                e.preventDefault();
                var f = this, fd = new FormData(f);
                $.ajax({
                    url: f.action,
                    method: f.method,
                    data: fd,
                    processData: false,
                    contentType: false
                })
                    .done(function () {
                        location.reload();
                    })
                    .fail(function (xhr) {
                        var err = xhr.responseJSON;
                        $('#errorCodSis').text(err.codSistema || '');
                        $('#errorNomSis').text(err.sistema || '');
                    });
            });
        });
    </script>
}
