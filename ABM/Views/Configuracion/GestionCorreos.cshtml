@model ABM.Models.GestionCorreosPageViewModel
@{
    ViewData["Title"] = "Gestión de Envío de Correos";
}

<link rel="stylesheet" href="~/lib/datatables.net-bs4/css/dataTables.bootstrap4.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="pt-5">
    <h4 class="mt-5">@ViewData["Title"]</h4>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Para errores de validación generales del modelo anidado *@
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }


    <div class="card mb-4">
        <div class="card-header text-white" style="background-color:#b0d404;">
            @* Color de ejemplo *@
            Registrar Nueva Configuración de Correos
        </div>
        <div class="card-body">
            <form asp-controller="Configuracion" asp-action="CrearEnvioCorreo" method="post">
                @Html.AntiForgeryToken()

                <h5>Datos Envío Correo</h5>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="CorreoParaCrear.IdPais" class="form-label"></label>
                        <select asp-for="CorreoParaCrear.IdPais" asp-items="Model.CorreoParaCrear.Paises" class="form-select">
                            <option value="">Seleccione País...</option>
                        </select>
                        <span asp-validation-for="CorreoParaCrear.IdPais" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CorreoParaCrear.IdNegocio" class="form-label"></label>
                        <select asp-for="CorreoParaCrear.IdNegocio" asp-items="Model.CorreoParaCrear.Negocios" class="form-select">
                            <option value="">Seleccione Negocio...</option>
                        </select>
                        <span asp-validation-for="CorreoParaCrear.IdNegocio" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CorreoParaCrear.IdSistema" class="form-label"></label>
                        <select asp-for="CorreoParaCrear.IdSistema" asp-items="Model.CorreoParaCrear.Sistemas" class="form-select">
                            <option value="">Seleccione Sistema...</option>
                        </select>
                        <span asp-validation-for="CorreoParaCrear.IdSistema" class="text-danger"></span>
                    </div>
                </div>
                <hr />
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <label asp-for="CorreoParaCrear.OSI" class="form-label"></label>
                        <input asp-for="CorreoParaCrear.OSI" class="form-control" />
                        <span asp-validation-for="CorreoParaCrear.OSI" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CorreoParaCrear.Correo_OSI" class="form-label"></label>
                        <input asp-for="CorreoParaCrear.Correo_OSI" class="form-control" type="email" />
                        <span asp-validation-for="CorreoParaCrear.Correo_OSI" class="text-danger"></span>
                    </div>
                </div>
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <label asp-for="CorreoParaCrear.Responsable" class="form-label"></label>
                        <input asp-for="CorreoParaCrear.Responsable" class="form-control" />
                        <span asp-validation-for="CorreoParaCrear.Responsable" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CorreoParaCrear.Correo_Responsable" class="form-label"></label>
                        <input asp-for="CorreoParaCrear.Correo_Responsable" class="form-control" type="email" />
                        <span asp-validation-for="CorreoParaCrear.Correo_Responsable" class="text-danger"></span>
                    </div>
                </div>
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <label asp-for="CorreoParaCrear.Gerente" class="form-label"></label>
                        <input asp-for="CorreoParaCrear.Gerente" class="form-control" />
                        <span asp-validation-for="CorreoParaCrear.Gerente" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CorreoParaCrear.Correo_Gerente" class="form-label"></label>
                        <input asp-for="CorreoParaCrear.Correo_Gerente" class="form-control" type="email" />
                        <span asp-validation-for="CorreoParaCrear.Correo_Gerente" class="text-danger"></span>
                    </div>
                </div>
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <label asp-for="CorreoParaCrear.Jefe" class="form-label"></label>
                        <input asp-for="CorreoParaCrear.Jefe" class="form-control" />
                        <span asp-validation-for="CorreoParaCrear.Jefe" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CorreoParaCrear.Correo_Jefe" class="form-label"></label>
                        <input asp-for="CorreoParaCrear.Correo_Jefe" class="form-control" type="email" />
                        <span asp-validation-for="CorreoParaCrear.Correo_Jefe" class="text-danger"></span>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-12">
                        <label asp-for="CorreoParaCrear.Otros_Correos" class="form-label"></label>
                        <input asp-for="CorreoParaCrear.Otros_Correos" class="form-control" />
                        <span asp-validation-for="CorreoParaCrear.Otros_Correos" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-12 text-end">
                        <button type="submit" class="btn btn-success">Registrar Configuración</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header text-white" style="background-color:#b0d404;">
            @* Color de ejemplo *@
            Listado de Configuraciones de Correo
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="file_export4" class="table table-striped table-bordered nowrap" style="width:100%; text-align:center;">
                    <thead>
                        <tr>
                            <th>País</th>
                            <th>Negocio</th>
                            <th>Sistema</th>
                            <th>OSI</th>
                            <th>Correo OSI</th>
                            <th>Responsable</th>
                            <th>Correo Resp.</th>
                            <th>Gerente</th>
                            <th>Correo Ger.</th>
                            <th>Jefe</th>
                            <th>Correo Jefe</th>
                            <th>Otros Correos</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ListaCorreos != null && Model.ListaCorreos.Any())
                        {
                            @foreach (var item in Model.ListaCorreos)
                            {
                                <tr data-id="@item.IdCorreos">
                                    <td>@item.NombrePais</td>
                                    <td>@item.NombreNegocio</td>
                                    <td>@item.NombreSistema</td>
                                    <td>@item.OSI</td>
                                    <td>@item.Correo_OSI</td>
                                    <td>@item.Responsable</td>
                                    <td>@item.Correo_Responsable</td>
                                    <td>@item.Gerente</td>
                                    <td>@item.Correo_Gerente</td>
                                    <td>@item.Jefe</td>
                                    <td>@item.Correo_Jefe</td>
                                    <td>@item.Otros_Correos</td>
                                    <td>
                                        @* Aquí irían botones de Editar/Eliminar en el futuro *@
                                        <button type="button" class="btn btn-sm btn-info btn-edit-correo" data-id="@item.IdCorreos" title="Editar"><i class="fas fa-edit"></i></button>
                                        <button type="button" class="btn btn-sm btn-danger btn-delete-correo" data-id="@item.IdCorreos" title="Eliminar"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="13" class="text-center">No hay configuraciones de correo para mostrar.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* MODAL PARA EDITAR CONFIGURACIÓN DE CORREO *@
<div class="modal fade" id="editarCorreoModal" tabindex="-1" aria-labelledby="editarCorreoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#b0d404;">
                @* Mismo color que tu card-header *@
                <h5 class="modal-title text-white" id="editarCorreoModalLabel">Editar Configuración de Correo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formEditarCorreo" method="post">
                    @* La acción se seteará con JS *@
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdCorreos" id="edit-IdCorreos" />
                    @* Este IdPaisNegocioSistema es el original; se actualizará si cambian P/N/S *@
                    <input type="hidden" name="IdPaisNegocioSistemaOriginal" id="edit-IdPaisNegocioSistemaOriginal" />

                    <h5>Datos Envío Correo</h5>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label for="edit-IdPais" class="form-label">País</label>
                            <select name="IdPais" id="edit-IdPais" class="form-select">
                                @* Las opciones de País se pueden tomar del modelo principal o cargar vía JS si es necesario.
                                Aquí asumimos que Model.CorreoParaCrear.Paises está disponible y es la lista completa. *@
                                @if (Model.CorreoParaCrear.Paises != null)
                                {
                                    foreach (var pais in Model.CorreoParaCrear.Paises)
                                    {
                                        <option value="@pais.Value">@pais.Text</option>
                                    }
                                }
                            </select>
                            <span data-valmsg-for="IdPais" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label for="edit-IdNegocio" class="form-label">Negocio</label>
                            <select name="IdNegocio" id="edit-IdNegocio" class="form-select">
                                <option value="">Seleccione Negocio...</option>
                            </select>
                            <span data-valmsg-for="IdNegocio" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label for="edit-IdSistema" class="form-label">Sistema</label>
                            <select name="IdSistema" id="edit-IdSistema" class="form-select">
                                <option value="">Seleccione Sistema...</option>
                            </select>
                            <span data-valmsg-for="IdSistema" class="text-danger"></span>
                        </div>
                    </div>
                    <hr />
                    <div class="row g-3 mb-2">
                        <div class="col-md-6">
                            <label for="edit-OSI" class="form-label">OSI</label>
                            <input type="text" name="OSI" id="edit-OSI" class="form-control" />
                            <span data-valmsg-for="OSI" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label for="edit-Correo_OSI" class="form-label">Correo OSI</label>
                            <input type="email" name="Correo_OSI" id="edit-Correo_OSI" class="form-control" />
                            <span data-valmsg-for="Correo_OSI" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-6">
                            <label for="edit-Responsable" class="form-label">Responsable</label>
                            <input type="text" name="Responsable" id="edit-Responsable" class="form-control" />
                            <span data-valmsg-for="Responsable" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label for="edit-Correo_Responsable" class="form-label">Correo Responsable</label>
                            <input type="email" name="Correo_Responsable" id="edit-Correo_Responsable" class="form-control" />
                            <span data-valmsg-for="Correo_Responsable" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-6">
                            <label for="edit-Gerente" class="form-label">Gerente</label>
                            <input type="text" name="Gerente" id="edit-Gerente" class="form-control" />
                            <span data-valmsg-for="Gerente" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label for="edit-Correo_Gerente" class="form-label">Correo Gerente</label>
                            <input type="email" name="Correo_Gerente" id="edit-Correo_Gerente" class="form-control" />
                            <span data-valmsg-for="Correo_Gerente" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-6">
                            <label for="edit-Jefe" class="form-label">Jefe</label>
                            <input type="text" name="Jefe" id="edit-Jefe" class="form-control" />
                            <span data-valmsg-for="Jefe" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label for="edit-Correo_Jefe" class="form-label">Correo Jefe</label>
                            <input type="email" name="Correo_Jefe" id="edit-Correo_Jefe" class="form-control" />
                            <span data-valmsg-for="Correo_Jefe" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-12">
                            <label for="edit-Otros_Correos" class="form-label">Otros Correos</label>
                            <input type="text" name="Otros_Correos" id="edit-Otros_Correos" class="form-control" />
                            <span data-valmsg-for="Otros_Correos" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>

    <script>
        $(function () {
            // ========== CONFIGURACIÓN INICIAL ==========

            // Inicializar DataTable con verificación previa
            var dtCorreos;
            if ($.fn.DataTable.isDataTable('#file_export4')) {
                $('#file_export4').DataTable().destroy();
            }

            dtCorreos = $('#file_export4').DataTable({
                pageLength: 10,
                dom: 'ltip',
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
                },
                columnDefs: [
                    { targets: '_all', className: 'text-center' }
                ],
                responsive: true,
                ordering: true,
                searching: true,
                paging: true,
                info: true
            });

            // Función utilitaria para limpiar y repoblar selects
            function limpiarYRepoblarSelect(selectElement, data, placeholderText, esError = false) {
                selectElement.empty();
                selectElement.append($('<option>', {
                    value: '',
                    text: placeholderText
                }));

                if (data && data.length > 0) {
                    $.each(data, function (index, item) {
                        selectElement.append($('<option>', {
                            value: item.value || item.Value,
                            text: item.text || item.Text
                        }));
                    });
                }

                selectElement.prop('disabled', esError || !data || data.length === 0);
            }

            // ========== FORMULARIO PRINCIPAL DE CREACIÓN ==========

            // Obtener referencias a los dropdowns del formulario principal
            var $paisSelect = $('select[name="CorreoParaCrear.IdPais"]');
            var $negocioSelect = $('select[name="CorreoParaCrear.IdNegocio"]');
            var $sistemaSelect = $('select[name="CorreoParaCrear.IdSistema"]');

            // Deshabilitar inicialmente Negocio y Sistema
            $negocioSelect.prop('disabled', true);
            $sistemaSelect.prop('disabled', true);

            // Evento: Cambio de País
            $paisSelect.on('change', function () {
                var paisId = $(this).val();

                // Limpiar y deshabilitar dropdowns dependientes
                limpiarYRepoblarSelect($negocioSelect, [], 'Cargando Negocios...', false);
                $negocioSelect.prop('disabled', true);
                limpiarYRepoblarSelect($sistemaSelect, [], 'Seleccione Sistema...', true);

                if (paisId) {
                    $.getJSON('@Url.Action("GetNegociosPorPais", "Configuracion")', { idPais: paisId })
                        .done(function (data) {
                            if (data && data.length > 0) {
                                limpiarYRepoblarSelect($negocioSelect, data, 'Seleccione Negocio...', false);
                                $negocioSelect.prop('disabled', false);
                            } else {
                                limpiarYRepoblarSelect($negocioSelect, [], 'No hay negocios para este país', true);
                            }
                        })
                        .fail(function (xhr, status, error) {
                            console.error("Error al cargar los negocios:", error);
                            limpiarYRepoblarSelect($negocioSelect, [], 'Error al cargar negocios', true);
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    title: 'Error',
                                    text: 'No se pudieron cargar los negocios. Intente nuevamente.',
                                    icon: 'error',
                                    confirmButtonText: 'Aceptar'
                                });
                            } else {
                                alert('Error al cargar los negocios. Intente nuevamente.');
                            }
                        });
                }
            });

            // Evento: Cambio de Negocio
            $negocioSelect.on('change', function () {
                var paisId = $paisSelect.val();
                var negocioId = $(this).val();

                // Limpiar dropdown de sistemas
                limpiarYRepoblarSelect($sistemaSelect, [], 'Cargando Sistemas...', false);
                $sistemaSelect.prop('disabled', true);

                if (paisId && negocioId) {
                    $.getJSON('@Url.Action("GetSistemasPorPaisYNegocio", "Configuracion")', {
                        idPais: paisId,
                        idNegocio: negocioId
                    })
                        .done(function (data) {
                            if (data && data.length > 0) {
                                limpiarYRepoblarSelect($sistemaSelect, data, 'Seleccione Sistema...', false);
                                $sistemaSelect.prop('disabled', false);
                            } else {
                                limpiarYRepoblarSelect($sistemaSelect, [], 'No hay sistemas para esta combinación', true);
                            }
                        })
                        .fail(function (xhr, status, error) {
                            console.error("Error al cargar los sistemas:", error);
                            limpiarYRepoblarSelect($sistemaSelect, [], 'Error al cargar sistemas', true);
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    title: 'Error',
                                    text: 'No se pudieron cargar los sistemas. Intente nuevamente.',
                                    icon: 'error',
                                    confirmButtonText: 'Aceptar'
                                });
                            } else {
                                alert('Error al cargar los sistemas. Intente nuevamente.');
                            }
                        });
                }
            });

            // ========== MODAL DE EDICIÓN ==========

            var modalEditarCorreoInstance;
            var $editarCorreoModal = $('#editarCorreoModal');

            // Verificar si Bootstrap 5 está disponible
            if (typeof bootstrap !== 'undefined') {
                modalEditarCorreoInstance = new bootstrap.Modal(document.getElementById('editarCorreoModal'));
            } else {
                // Fallback para Bootstrap 4
                modalEditarCorreoInstance = {
                    show: function () { $editarCorreoModal.modal('show'); },
                    hide: function () { $editarCorreoModal.modal('hide'); }
                };
            }

            var $formEditarCorreo = $('#formEditarCorreo');

            // Referencias a los dropdowns del modal de edición
            var $editPaisSelect = $('#edit-IdPais');
            var $editNegocioSelect = $('#edit-IdNegocio');
            var $editSistemaSelect = $('#edit-IdSistema');

            // Eventos para dropdowns del modal de edición
            $editPaisSelect.on('change', function () {
                var paisId = $(this).val();
                limpiarYRepoblarSelect($editNegocioSelect, [], 'Cargando Negocios...', false);
                $editNegocioSelect.prop('disabled', true);
                limpiarYRepoblarSelect($editSistemaSelect, [], 'Seleccione Sistema...', true);

                if (paisId) {
                    $.getJSON('@Url.Action("GetNegociosPorPais", "Configuracion")', { idPais: paisId })
                        .done(function (data) {
                            limpiarYRepoblarSelect($editNegocioSelect, data,
                                (data && data.length > 0) ? 'Seleccione Negocio...' : 'No hay negocios para este país',
                                !(data && data.length > 0));
                        })
                        .fail(function (xhr, status, error) {
                            console.error("Error al cargar negocios para edición:", error);
                            limpiarYRepoblarSelect($editNegocioSelect, [], 'Error al cargar negocios', true);
                        });
                }
            });

            $editNegocioSelect.on('change', function () {
                var paisId = $editPaisSelect.val();
                var negocioId = $(this).val();
                limpiarYRepoblarSelect($editSistemaSelect, [], 'Cargando Sistemas...', false);
                $editSistemaSelect.prop('disabled', true);

                if (paisId && negocioId) {
                    $.getJSON('@Url.Action("GetSistemasPorPaisYNegocio", "Configuracion")', {
                        idPais: paisId,
                        idNegocio: negocioId
                    })
                        .done(function (data) {
                            limpiarYRepoblarSelect($editSistemaSelect, data,
                                (data && data.length > 0) ? 'Seleccione Sistema...' : 'No hay sistemas para esta combinación',
                                !(data && data.length > 0));
                        })
                        .fail(function (xhr, status, error) {
                            console.error("Error al cargar sistemas para edición:", error);
                            limpiarYRepoblarSelect($editSistemaSelect, [], 'Error al cargar sistemas', true);
                        });
                }
            });

            // Función para configurar dropdowns de edición
            function configurarDesplegablesEdicion(data) {
                return new Promise((resolve, reject) => {
                    $editPaisSelect.val(data.idPais);

                    if (data.idPais) {
                        $.getJSON('@Url.Action("GetNegociosPorPais", "Configuracion")', { idPais: data.idPais })
                            .done(function (negociosData) {
                                limpiarYRepoblarSelect($editNegocioSelect, negociosData, 'Seleccione Negocio...', false);

                                if (negociosData && negociosData.length > 0) {
                                    $editNegocioSelect.val(data.idNegocio);

                                    if (data.idNegocio) {
                                        $.getJSON('@Url.Action("GetSistemasPorPaisYNegocio", "Configuracion")', {
                                            idPais: data.idPais,
                                            idNegocio: data.idNegocio
                                        })
                                            .done(function (sistemasData) {
                                                limpiarYRepoblarSelect($editSistemaSelect, sistemasData, 'Seleccione Sistema...', false);

                                                if (sistemasData && sistemasData.length > 0) {
                                                    $editSistemaSelect.val(data.idSistema);
                                                }
                                                resolve();
                                            })
                                            .fail(function (xhr, status, error) {
                                                console.error("Error cargando sistemas:", error);
                                                limpiarYRepoblarSelect($editSistemaSelect, [], 'Error al cargar Sistemas', true);
                                                reject(error);
                                            });
                                    } else {
                                        resolve();
                                    }
                                } else {
                                    resolve();
                                }
                            })
                            .fail(function (xhr, status, error) {
                                console.error("Error cargando negocios:", error);
                                limpiarYRepoblarSelect($editNegocioSelect, [], 'Error al cargar Negocios', true);
                                limpiarYRepoblarSelect($editSistemaSelect, [], 'Error al cargar Sistemas', true);
                                reject(error);
                            });
                    } else {
                        resolve();
                    }
                });
            }

            // Evento: Clic en botón Editar con delegación de eventos
            $(document).on('click', '.btn-edit-correo', function () {
                var correoId = $(this).data('id');
                $formEditarCorreo.attr('action', '@Url.Action("EditarEnvioCorreo", "Configuracion")/' + correoId);

                // Limpiar errores de validación
                $formEditarCorreo.find('.text-danger').text('');
                $formEditarCorreo.find('.is-invalid').removeClass('is-invalid');

                $.getJSON('@Url.Action("GetDatosEnvioCorreo", "Configuracion")', { id: correoId })
                    .done(function (response) {
                        if (response.success && response.data) {
                            var data = response.data;

                            // Llenar campos del formulario
                            $('#edit-IdCorreos').val(data.idCorreos);
                            $('#edit-IdPaisNegocioSistemaOriginal').val(data.idPaisNegocioSistema);
                            $('#edit-OSI').val(data.osi);
                            $('#edit-Correo_OSI').val(data.correo_OSI);
                            $('#edit-Responsable').val(data.responsable);
                            $('#edit-Correo_Responsable').val(data.correo_Responsable);
                            $('#edit-Gerente').val(data.gerente);
                            $('#edit-Correo_Gerente').val(data.correo_Gerente);
                            $('#edit-Jefe').val(data.jefe);
                            $('#edit-Correo_Jefe').val(data.correo_Jefe);
                            $('#edit-Otros_Correos').val(data.otros_Correos);

                            configurarDesplegablesEdicion(data)
                                .then(function () {
                                    modalEditarCorreoInstance.show();
                                })
                                .catch(function (error) {
                                    console.error("Error configurando dropdowns:", error);
                                    modalEditarCorreoInstance.show(); // Mostrar modal aunque haya errores en dropdowns
                                });
                        } else {
                            var mensaje = response.message || "Error al cargar los datos de la configuración.";
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    title: 'Error',
                                    text: mensaje,
                                    icon: 'error',
                                    confirmButtonText: 'Aceptar'
                                });
                            } else {
                                alert(mensaje);
                            }
                        }
                    })
                    .fail(function (xhr, status, error) {
                        console.error("Error en AJAX para GetDatosEnvioCorreo:", error);
                        var mensaje = "Error de comunicación al intentar obtener los datos para editar.";
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                title: 'Error',
                                text: mensaje,
                                icon: 'error',
                                confirmButtonText: 'Aceptar'
                            });
                        } else {
                            alert(mensaje);
                        }
                    });
            });

            // Evento: Envío del formulario de edición
            $formEditarCorreo.on('submit', function (e) {
                e.preventDefault();
                var form = this;
                var $form = $(form);
                var formData = $form.serialize();

                // Limpiar errores previos
                $form.find('.text-danger').text('');
                $form.find('.is-invalid').removeClass('is-invalid');

                $.ajax({
                    url: form.action,
                    method: "POST",
                    data: formData,
                })
                    .done(function (response) {
                        modalEditarCorreoInstance.hide();

                        var mensaje = response.Message || "Configuración de correo actualizada exitosamente.";
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                title: '¡Actualizado!',
                                text: mensaje,
                                icon: 'success',
                                confirmButtonText: 'Aceptar'
                            }).then((result) => {
                                if (result.isConfirmed || result.isDismissed) {
                                    location.reload();
                                }
                            });
                        } else {
                            alert(mensaje);
                            location.reload();
                        }
                    })
                    .fail(function (xhr) {
                        var generalErrorMessages = [];

                        if (xhr.responseJSON) {
                            var responseData = xhr.responseJSON;

                            if (typeof responseData === 'string') {
                                generalErrorMessages.push(responseData);
                            } else if (responseData.Message) {
                                generalErrorMessages.push(responseData.Message);
                            } else {
                                $.each(responseData, function (fieldName, errorsForKey) {
                                    if (errorsForKey && errorsForKey.length > 0) {
                                        var $input = $form.find('[name="' + fieldName + '"]');
                                        var $span = $form.find('[data-valmsg-for="' + fieldName + '"]');

                                        if ($span.length) {
                                            $span.text(errorsForKey[0]);
                                            if ($input.length) $input.addClass('is-invalid');
                                        } else {
                                            var prefix = (fieldName && fieldName !== "") ? fieldName + ": " : "";
                                            $.each(errorsForKey, function (i, errorText) {
                                                generalErrorMessages.push(prefix + errorText);
                                            });
                                        }
                                    }
                                });
                            }
                        } else {
                            generalErrorMessages.push('Error desconocido al actualizar. Intente nuevamente.');
                        }

                        if (generalErrorMessages.length > 0) {
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    title: 'Errores de Validación',
                                    html: "Por favor corrija los siguientes errores:<br><br>• " + generalErrorMessages.join('<br>• '),
                                    icon: 'error',
                                    confirmButtonText: 'Aceptar'
                                });
                            } else {
                                alert("Errores de validación:\n\n• " + generalErrorMessages.join('\n• '));
                            }
                        }
                    });
            });

            // Evento: Clic en botón Eliminar con delegación de eventos
            $(document).on('click', '.btn-delete-correo', function () {
                var correoId = $(this).data('id');

                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: '¿Está seguro?',
                        text: "Esta acción no se puede deshacer.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Sí, eliminar',
                        cancelButtonText: 'Cancelar'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Aquí implementarías la lógica de eliminación
                            // $.post('@Url.Action("EliminarEnvioCorreo", "Configuracion")', { id: correoId })
                            console.log('Eliminar correo ID:', correoId);
                        }
                    });
                } else {
                    if (confirm('¿Está seguro de que desea eliminar esta configuración de correo?')) {
                        console.log('Eliminar correo ID:', correoId);
                        // Implementar lógica de eliminación aquí
                    }
                }
            });

        });
    </script>

