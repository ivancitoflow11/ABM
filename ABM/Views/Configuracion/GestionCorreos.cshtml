                                });
                            }
                        } else {
                            generalErrorMessages.push('Error desconocido al actualizar. Intente nuevamente.');
                        }
                        if (generalErrorMessages.length > 0) {
                            // Para los errores, mantenemos el alert simple, o puedes cambiarlos a Swal también si prefieres.
                            alert("Por favor corrija los siguientes errores:\n- " + generalErrorMessages.join('\n- '));
                        }
                    });
            });
            idNegocioSelect.on('change', function () {
                var paisId = idPaisSelect.val();
                var negocioId = $(this).val();
                idSistemaSelect.empty().append($('<option value="">Cargando Sistemas...</option>')).prop('disabled', true);

                if (paisId && negocioId) {
                    $.getJSON('@Url.Action("GetSistemasPorPaisYNegocio", "Configuracion")', { idPais: paisId, idNegocio: negocioId }) // Ajusta "Configuracion"
                        .done(function (data) {
                            limpiarYRepoblarSelect(idSistemaSelect, data, 'Seleccione Sistema...');
                            if (data && data.length > 0) {
                                idSistemaSelect.prop('disabled', false);
                            } else {
                                idSistemaSelect.empty().append($('<option value="">No hay sistemas para esta combinación</option>')).prop('disabled', true);
                            }
                        })
                        .fail(function () {
                            alert("Error al cargar los sistemas.");
                            idSistemaSelect.empty().append($('<option value="">Error al cargar</option>')).prop('disabled', true);
                        });
                } else {
                    idSistemaSelect.empty().append($('<option value="">Seleccione Sistema...</option>')).prop('disabled', true);
                }
            });
        });
