                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ListaResumenPais?.Any() ?? false)
                            {
                                @foreach (var item in Model.ListaResumenPais)
                                {
                                    <tr>
                                        <td>@item.Sistema</td>
                                        <td>@item.ACTIVOS</td>
                                        <td>@item.FINIQUITADOS</td>
