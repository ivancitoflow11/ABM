        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header text-white" style="background-color: #acd743;">
                    Evidencias Finiquitados
                </div>
                <div class="card-body table-responsive">
                    <table id="gestion2" class="table table-bordered">
                        <thead>
                            <tr>
