@model ABM.Models.LoginViewModel;
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr" data-bs-theme="light" data-color-theme="Blue_Theme" data-layout="vertical">

<head>
    <!-- Required meta tags -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- Favicon icon-->
    <link rel="shortcut icon" type="image/png" href="~/images/logos/favicon-32x32q.png" />

    <title>Inicio de sesión</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
        }

        .logo {
            position: center;
            width: 250px;
            align-content: center;
            height: auto;
            z-index: 1000;
        }

        .bg-img {
            background: url('/images/fdlog.png');
            height: 100vh;
            background-size: cover;
            background-position: center;
        }

            .bg-img:after {
                position: absolute;
                content: "";
                top: 0;
                left: 0;
                height: 100%;
                width: 100%;
            }

        .content {
            position: absolute;
            top: 50%;
            left: 50%;
            z-index: 999;
            text-align: center;
            padding: 60px 32px;
            width: 370px;
            transform: translate(-50%, -50%);
            background: rgba(255, 255, 255, 0.04);
            box-shadow: -1px 4px 28px 0px rgba(0, 0, 0, 0.75);
        }

            .content header {
                color: white;
                font-size: 33px;
                font-weight: 600;
                margin: 0 0 35px 0;
                font-family: "Montserrat", sans-serif;
            }

        .field {
            position: relative;
            height: 45px;
            width: 100%;
            display: flex;
            background: rgba(255, 255, 255, 0.94);
        }

            .field span {
                color: #222;
                width: 40px;
                line-height: 45px;
            }

            .field input {
                height: 100%;
                width: 100%;
                background: transparent;
                border: none;
                outline: none;
                color: #222;
                font-size: 16px;
                font-family: "Poppins", sans-serif;
            }

        .space {
            margin-top: 16px;
        }

        .show {
            position: absolute;
            right: 13px;
            top: 12px;
            font-size: 20px;
            cursor: pointer;
            color: #222;
            z-index: 1000;
            transform: translateY(-50%);
        }

        .pass {
            text-align: left;
            margin: 10px 0;
        }

            .pass a {
                color: white !important;
                text-decoration: none !important;
                background: none !important;
                border: none !important;
                padding: 0 !important;
                box-shadow: none !important;
                display: inline-block;
            }

                .pass a:hover {
                    text-decoration: underline;
                }

        .field input[type="submit"] {
            background: #abd600;
            border: 1px solid #2691d9;
            color: white;
            font-size: 18px;
            letter-spacing: 1px;
            font-weight: 600;
            cursor: pointer;
            font-family: "Montserrat", sans-serif;
        }

            .field input[type="submit"]:hover {
                background: #99bf00;
            }

        .login {
            color: white;
            margin: 20px 0;
            font-family: "Poppins", sans-serif;
        }

        .links {
            display: flex;
            cursor: pointer;
            color: white;
            margin: 0 0 20px 0;
        }

            .links i {
                font-size: 17px;
            }

        i span {
            margin-left: 8px;
            font-weight: 500;
            letter-spacing: 1px;
            font-size: 16px;
            font-family: "Poppins", sans-serif;
        }

        .signup {
            font-size: 15px;
            color: white;
            font-family: "Poppins", sans-serif;
        }

            .signup a {
                color: #3498db;
                text-decoration: none;
            }

                .signup a:hover {
                    text-decoration: underline;
                }

        .footer-text {
            position: absolute;
            bottom: 20px;
            width: 100%;
            text-align: center;
            font-family: Verdana, sans-serif;
            font-weight: bold;
            color: white;
            z-index: 1000;
        }

        .alerta {
            text-align: center;
            font-family: Verdana, sans-serif;
            font-weight: normal;
            color: white;
            background-color: #ff3030;
            padding: 10px;
            border-radius: 10px;
            z-index: 1000;
            font-style: italic;
            font-size: 0.9em;
        }

        .field .icon {
            line-height: 45px;
            font-size: 20px;
            margin-right: 10px;
        }

        #ojito {
            margin-top: 10px;
            color: #34a012;
        }

        .underline-effect {
            color: white;
            text-decoration: none;
            position: relative;
            display: inline-block;
            font-family: Marlett;
        }

            .underline-effect::after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 50%;
                width: 0;
                height: 2px;
                background-color: white;
                transition: all 0.3s ease;
            }

            .underline-effect:hover::after {
                width: 100%;
                left: 0;
            }

        header {
            font-size: 2em;
            font-weight: bold;
            color: white;
            text-shadow: -2px -2px 0 #34a012, -2px 0px 0 #34a012, -2px 2px 0 #34a012, 0px -2px 0 #34a012, 0px 2px 0 #34a012, 2px -2px 0 #34a012, 2px 0px 0 #34a012, 2px 2px 0 #34a012;
        }

        #iconosloginusercontra {
            color: #34a012;
        }
    </style>

</head>

<body>
    <div class="bg-img">
        <div class="content">
            <img src="~/images/logos/logofalabellalogin.png" alt="Logo Falabella" style="width:350px; margin-left:-15px; margin-bottom:-55px">
            <br /><br />
            <header>INICIAR SESIÓN</header>
            <form asp-controller="Acceso" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div class="field">
                    <span id="iconosloginusercontra" class="fa fa-user"></span>
                    <input class="form-control" placeholder="correo@ejemplo.com" required asp-for="Correo" />
                </div>
                <div class="field space">
                    <span id="iconosloginusercontra" class="fa fa-lock icon"></span>
                    <input class="form-control pass-key" type="password" placeholder="Ingrese su contraseña" required asp-for="Repeat_Password" />
                    <span class="show" id="ojito"><i class="fa fa-eye icon"></i></span>
                </div>
                <div class="field" style="margin-top:20px">
                    <input type="submit" value="CONÉCTATE">
                </div>
                <a asp-controller="Acceso" asp-action="OlvidoClave" class="underline-effect" style="margin-top: 15px; display: inline-block;">¿OLVIDASTE TU CONTRASEÑA?</a>
                <br /><br />

                @if (ViewData["Mensaje"] != null)
                {
                    <div class="alerta" role="alert">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        @ViewData["Mensaje"]
                    </div>
                }
            </form>
        </div>
        <div class="footer-text">
            Desarrollado por Bidata
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const pass_field = document.querySelector(".pass-key");
            const showBtn = document.querySelector(".show");

            showBtn.addEventListener("click", function () {
                if (pass_field.type === "password") {
                    pass_field.type = "text";
                    showBtn.innerHTML = '<i class="fa fa-eye-slash"></i>';
                } else {
                    pass_field.type = "password";
                    showBtn.innerHTML = '<i class="fa fa-eye"></i>';
                }
            });
        });
    </script>
</body>
</html>
@if (ViewBag.PedirOTC != null && (bool)ViewBag.PedirOTC)
{
    <!-- SweetAlert2 -->
    <script src="~/js/sweetalert/sweetalert.min.js"></script>
    <style>
        .swal2-popup {
            font-family: 'Segoe UI', 'Helvetica Neue', sans-serif !important;
        }
    </style>

    <script>
        // Convertir la lista de países/negocios de ViewBag a JSON
        var paisNegocioData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject((List<ABM.Models.PaisNegocioViewModel>)ViewBag.PaisesNegocios));
        // Extraer la lista única de países
        var uniqueCountries = [...new Set(paisNegocioData.map(x => x.pais))];
        
        // Variables para almacenar la selección
        var selectedPais, selectedIdPais, selectedNegocio, selectedIdNegocio;

        document.addEventListener("DOMContentLoaded", function () {
            seleccionarPaisNegocio();
        });
        
        function seleccionarPaisNegocio() {
            Swal.fire({
                title: '<strong style="color:#3a3a3a;">Seleccione País y Negocio</strong>',
                html: `
                <div style="display: flex; flex-direction: column; gap: 15px; text-align: left; font-family: 'Segoe UI', sans-serif; font-size: 15px; color: #4a4a4a;">
                    <!-- Campo País -->
                    <div style="display: flex; flex-direction: column; gap: 5px;">
                        <label for="selectPais" style="font-weight:600;"> País</label>
                        <select id="selectPais" class="swal2-input" style="height: 42px; padding: 5px 10px; font-size: 16px; color: #333; border-radius: 5px; border: 1px solid #ccc;">
                            <option value="">-- Seleccione un país --</option>
                        </select>
                    </div>
                    <!-- Campo Negocio -->
                    <div style="display: flex; flex-direction: column; gap: 5px;">
                        <label for="selectNegocio" style="font-weight:600;"> Negocio</label>
                        <select id="selectNegocio" class="swal2-input" style="height: 42px; padding: 5px 10px; font-size: 16px; color: #333; border-radius: 5px; border: 1px solid #ccc;" disabled>
                            <option value="">Debe seleccionar primero un país</option>
                        </select>
                    </div>
                </div>
                `,
                focusConfirm: false,
                confirmButtonText: 'Continuar',
                confirmButtonColor: '#7ac143',

                preConfirm: () => {
                    const idPais = document.getElementById('selectPais').value;
                    const idNegocio = document.getElementById('selectNegocio').value;

                    if (!idPais || !idNegocio || idNegocio === "NA") {
                        Swal.showValidationMessage("Debe seleccionar un país y un negocio.");
                        return false;
                    }

                    // Guardar la selección en variables globales
                    selectedIdPais = idPais;
                    selectedIdNegocio = idNegocio;
                    selectedPais = document.getElementById('selectPais').options[document.getElementById('selectPais').selectedIndex].text;
                    selectedNegocio = document.getElementById('selectNegocio').options[document.getElementById('selectNegocio').selectedIndex].text;

                    return { idPais, idNegocio };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    console.log("Selección:", selectedPais, selectedNegocio);

                    // 🔄 Mostrar loading antes de enviar OTC
                    Swal.fire({
                        title: 'Cargando...',
                        html: 'Generando OTC, revise su correo registrado.',
                        didOpen: () => {
                            Swal.showLoading();
                        },
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        showConfirmButton: false
                    });

                    // Llamamos al endpoint para enviar el OTC
                    enviarOTC();
                } else {
                    seleccionarPaisNegocio();
                }
            });

            // Poblar el select de países con ID y nombre
            const selectPais = document.getElementById("selectPais");
            const paisesUnicos = [...new Map(paisNegocioData.map(item => [item.idPais, item])).values()];
            paisesUnicos.forEach(function (item) {
                const option = document.createElement("option");
                option.value = item.idPais;
                option.text = item.pais;
                selectPais.add(option);
            });

            // Al cambiar país, poblar negocios filtrando por idPais
            selectPais.addEventListener("change", function () {
                const selectedCountryId = this.value;
                const selectNegocio = document.getElementById("selectNegocio");
                selectNegocio.innerHTML = "";

                if (selectedCountryId === "") {
                    const defaultOpt = document.createElement("option");
                    defaultOpt.value = "";
                    defaultOpt.text = "Debe seleccionar primero un país";
                    selectNegocio.add(defaultOpt);
                    selectNegocio.disabled = true;
                } else {
                    const negocios = paisNegocioData.filter(x => x.idPais == selectedCountryId);
                    const uniqueNegocios = [...new Map(negocios.map(item => [item.idNegocio, item])).values()];

                    if (uniqueNegocios.length === 0) {
                        const opt = document.createElement("option");
                        opt.value = "NA";
                        opt.text = "No hay negocios disponibles para el país seleccionado";
                        selectNegocio.add(opt);
                        selectNegocio.disabled = true;
                    } else {
                        uniqueNegocios.forEach(function (item) {
                            const option = document.createElement("option");
                            option.value = item.idNegocio;
                            option.text = item.negocio;
                            selectNegocio.add(option);
                        });
                        selectNegocio.disabled = false;
                    }
                }
            });
        }

        // Función para enviar el OTC mediante AJAX
        function enviarOTC() {
            fetch('/Acceso/EnviarOTC', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
                // Opcional: se puede incluir la selección de país y negocio en el body
                // body: JSON.stringify({ pais: selectedIdPais, negocio: selectedIdNegocio })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        pedirOTC();
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: data.message });
                    }
                })
                .catch(error => {
                    Swal.fire({ icon: 'error', title: 'Error', text: error });
                });
        }

        // Función para mostrar el modal de validación del OTC
        function pedirOTC() {
            Swal.fire({
                title: '<strong style="color:#3a3a3a;">🔐 Verificación OTC</strong>',
                html: `
                            <p style="font-size:16px; color:#4a4a4a;">
                                Por favor, ingresa tu código de verificación de 4 dígitos para continuar.<br>
                                <span style="color:#7ac143; font-weight:bold;">ABM FALABELLA</span>
                            </p>
                        `,
                input: 'text',
                inputPlaceholder: 'Ej: 1234',
                inputAttributes: {
                    maxlength: 4,
                    style: 'text-align: center; font-size: 22px; letter-spacing: 5px;'
                },
                background: '#fcfdf8',
                confirmButtonText: 'Validar',
                confirmButtonColor: '#7ac143',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showLoaderOnConfirm: true,
                preConfirm: (valorOTC) => {
                    return fetch(`/Acceso/ValidarOTC?idUsuario=@ViewBag.IdUsuario&otcIngresado=${valorOTC}&idPais=${selectedIdPais}&pais=${encodeURIComponent(selectedPais)}&idNegocio=${selectedIdNegocio}&negocio=${encodeURIComponent(selectedNegocio)}`)
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(response.statusText);
                            }
                            return response.json();
                        })
                        .then(data => {
                            if (!data.valido) {
                                throw new Error('OTC INCORRECTO');
                            }
                        })
                        .catch(error => {
                            Swal.showValidationMessage(`${error}`);
                        });
                }
            }).then((resultado) => {
                if (resultado.isConfirmed) {
                    window.location.href = '/Home/Index';
                } else {
                    pedirOTC();
                }
            });
        }
    </script>
}