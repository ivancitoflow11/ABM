@model ABM.ViewModels.UsuarioVM

<div class="col-12" style="margin-top: 90px">
    <h4 style="margin-top:5px;">Editar Usuario</h4>
    <div class="card w-100 border position-relative overflow-hidden mb-0">
        <div class="card-body p-4">
            <!-- Mensajes de éxito o error -->
            <div class="alert-container">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        @TempData["Success"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @TempData["Error"]
                    </div>
                }
            </div>

            <form asp-controller="Acceso" asp-action="EditarUsuario" method="post">
                <input type="hidden" asp-for="IdUsuario" />

                <div class="row">
                    <div class="col-lg-6" style="margin-top:15px;">
                        <!-- Columna Izquierda -->
                        <div class="mb-3">
                            <label for="nombre" class="form-label"> Nombre Completo</label>
                            <input class="form-control mb-3" type="text" placeholder="Ejemplo: Javier Osorio" required asp-for="nombre" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Asignar Rol</label>
                            <select class="form-select" aria-label="Default select example" required asp-for="idRol" id="selectRol">
                                <option disabled selected>Seleccione Rol...</option>
                                @if (Model.Roles != null && Model.Roles.Any())
                                {
                                    @foreach (var item in Model.Roles)
                                    {
                                        <option value="@item.idRol">@item.nombre</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="firma" class="form-label">Firma</label>
                            <input type="file" class="form-control mb-3" id="firma" onchange="convertToBase64(this)" />
                            <input type="hidden" asp-for="firma" />
                        </div>

                        <div class="mb-3">
                            <label for="ResponsableFirma" class="form-label">¿Es Responsable de firmar la Matriz de su gerencia?</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="ResponsableFirma" id="ResponsableFirma1" value="true"
                                @(Model.ResponsableFirma == true ? "checked" : "")>
                                <label class="form-check-label" for="ResponsableFirma1">Sí</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="ResponsableFirma" id="ResponsableFirma2" value="false"
                                @(Model.ResponsableFirma == false ? "checked" : "")>
                                <label class="form-check-label" for="ResponsableFirma2">No</label>
                            </div>
                        </div>

                    </div>

                    <div class="col-lg-6" style="margin-top:15px;">
                        <!-- Columna Derecha -->
                        <div class="mb-3">
                            <label for="correo" class="form-label">Email</label>
                            <input class="form-control mb-3" type="email" placeholder="Correo electrónico" required asp-for="correo" />
                        </div>

                        <div class="mb-3">
                            <label for="password_c" class="form-label">Nueva Contraseña (dejar en blanco para mantener la actual)</label>
                            <input class="form-control mb-3" type="password" placeholder="Ingrese nueva clave" asp-for="password_c" />
                        </div>

                        <div class="mb-3">
                            <label for="ConfirmarClave" class="form-label">Confirmar Nueva Contraseña</label>
                            <input class="form-control mb-3" type="password" placeholder="Confirme nueva clave de usuario" asp-for="ConfirmarClave" />
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="mb-3">
                            <label class="form-label">Asignar Gerencia</label>
                            <select class="form-select" aria-label="Default select example" asp-for="ID_gerencia" id="selectGerencia" onchange="cargarSubgerencias()">
                                <option disabled selected>Seleccione Gerencia...</option>
                                <option value="">Todas las gerencias</option>
                                @if (Model.ListaGerencias != null && Model.ListaGerencias.Any())
                                {
                                    @foreach (var item in Model.ListaGerencias)
                                    {
                                        <option value="@item.ID_gerencia">@item.Nom_Gerencia</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Estado:</label>
                            <select class="form-select" aria-label="Default select example" required asp-for="estado">
                                <option value="1">Activo</option>
                                <option value="2">Inactivo</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Subgerencia</label>
                            <select class="form-select" aria-label="Default select example" asp-for="ID_Subgerencia" id="selectSubGerencia">
                                <option disabled selected>Seleccione Subgerencia...</option>
                                <option value="">Todas las subgerencias</option>
                                @if (Model.ListaSubgerencias != null && Model.ListaSubgerencias.Any())
                                {
                                    @foreach (var item in Model.ListaSubgerencias)
                                    {
                                        <option value="@item.ID_Subgerencia">@item.Nom_Subgerencia</option>
                                    }
                                }
                            </select>
                        </div>


                        <div class="d-grid gap-2 mb-3" style="display: flex; justify-content: flex-end;">
                            <button class="btn btn-primary" style="width: 300px; border-radius:40px; margin-top:15px;" type="submit">Guardar Cambios</button>
                            <a asp-controller="Home" asp-action="ListaUsuarios" class="btn btn-secondary" style="width: 300px; border-radius:40px; margin-top:15px;">Cancelar</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Función para manejar el cambio en la selección del rol
    document.getElementById('selectRol').addEventListener('change', function () {
        var selectedRole = this.options[this.selectedIndex].text;
        var gerenciaSelect = document.getElementById('selectGerencia');

        if (selectedRole === "Admin") {
            gerenciaSelect.disabled = true;
            gerenciaSelect.selectedIndex = 0;
        } else {
            gerenciaSelect.disabled = false;
        }
    });

    function convertToBase64(input) {
        const file = input.files[0];
        const reader = new FileReader();

        reader.onloadend = function () {
            document.querySelector('input[name="firma"]').value = reader.result;
        }

        if (file) {
            reader.readAsDataURL(file);
        }
    }
</script>

<script>
    // Variable para almacenar el valor anterior de la gerencia
    var lastSelectedGerencia = null;

    function cargarSubgerencias() {
        // Obtener el valor de la gerencia seleccionada
        var codGerencia = document.getElementById('selectGerencia').value;

        console.log('Gerencia seleccionada:', codGerencia);

        // Si la gerencia seleccionada es diferente de la última seleccionada, limpiar el campo de subgerencias
        if (codGerencia !== lastSelectedGerencia) {
            // Limpiar el campo de subgerencia
            var subgerenciaSelect = document.getElementById('selectSubGerencia');
            subgerenciaSelect.innerHTML = '<option disabled selected>Seleccione Subgerencia...</option><option value="">Todas las subgerencias</option>';

            // Actualizar la última gerencia seleccionada
            lastSelectedGerencia = codGerencia;
        }

        // Si no se selecciona una gerencia, no hacemos nada más
        if (!codGerencia) {
            return;
        }

        // Realizar la solicitud AJAX para obtener las subgerencias
        fetch('@Url.Action("ObtenerSubGerenciasPorGerencia", "Acceso")?codGerencia=' + encodeURIComponent(codGerencia))
            .then(response => response.json())
            .then(data => {
                console.log('Datos recibidos:', data);

                // Limpiar las opciones del select de subgerencia
                var subgerenciaSelect = document.getElementById('selectSubGerencia');
                subgerenciaSelect.options.length = 0;  // Elimina todas las opciones

                // Agregar la opción por defecto
                var optionDefault = new Option('Seleccione Subgerencia...', '', true, true);
                subgerenciaSelect.appendChild(optionDefault);

                // Verificar si hay subgerencias
                if (data && Array.isArray(data) && data.length > 0) {
                    // Agregar las subgerencias al select
                    data.forEach(subgerencia => {
                        console.log(`Agregando opción: ${subgerencia.nom_Subgerencia}, ${subgerencia.iD_Subgerencia}`);
                        var option = new Option(subgerencia.nom_Subgerencia, subgerencia.iD_Subgerencia);
                        subgerenciaSelect.appendChild(option);
                    });
                } else {
                    // Agregar mensaje de no subgerencias disponibles
                    var option = new Option('No hay subgerencias disponibles', '', false, false);
                    subgerenciaSelect.appendChild(option);
                }
            })
            .catch(error => {
                console.error('Error al obtener las subgerencias:', error);
                var option = new Option('Error al cargar subgerencias', '', false, false);
                subgerenciaSelect.appendChild(option);
            });
    }

</script>