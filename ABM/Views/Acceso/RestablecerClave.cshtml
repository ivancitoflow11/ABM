@model ABM.Models.RestablecerClaveViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
    Layout = null; // Mismo layout que el login
}

<!DOCTYPE html>
<html lang="es" dir="ltr" data-bs-theme="light" data-color-theme="Blue_Theme" data-layout="vertical">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" type="image/png" href="~/images/logos/favicon_abm_32x32.png" />
    <link rel="stylesheet" href="~/css/all.min.css" asp-append-version="true" />
    <title>@ViewData["Title"]</title>
    <style>
        /* Reutiliza los estilos del Login.cshtml o crea unos específicos */
        * { margin: 0; padding: 0; box-sizing: border-box; user-select: none; }
        body { font-family: "Poppins", sans-serif; }
        .bg-img { background: url('/images/fdlog.png'); height: 100vh; background-size: cover; background-position: center; display: flex; align-items: center; justify-content: center; }
        .content { z-index: 999; text-align: center; padding: 40px 32px; width: 420px; background: rgba(255, 255, 255, 0.08); box-shadow: -1px 4px 28px 0px rgba(0, 0, 0, 0.75); border-radius: 8px; }
        .content header { color: white; font-size: 26px; font-weight: 600; margin-bottom: 25px; font-family: "Montserrat", sans-serif; text-shadow: -1px -1px 0 #34a012, 1px -1px 0 #34a012, -1px 1px 0 #34a012, 1px 1px 0 #34a012;}
        .field { position: relative; height: 50px; width: 100%; display: flex; background: rgba(255, 255, 255, 0.94); border-radius: 5px; margin-bottom: 20px; }
        .field span.fa { color: #555; width: 50px; line-height: 50px; text-align: center; font-size: 18px; }
        .field input[type="password"] { height: 100%; width: 100%; background: transparent; border: none; outline: none; color: #222; font-size: 16px; padding: 0 15px; font-family: "Poppins", sans-serif; }
        .field input[type="submit"] { background: #abd600; border: 1px solid #99bf00; color: white; font-size: 18px; letter-spacing: 1px; font-weight: 600; cursor: pointer; font-family: "Montserrat", sans-serif; border-radius: 5px; transition: background-color 0.3s ease; width:100%; height:100%;}
        .field input[type="submit"]:hover { background: #99bf00; }
        .alerta.error { text-align: center; font-family: Verdana, sans-serif; color: white; padding: 12px; border-radius: 5px; margin-top: 15px; margin-bottom: 15px; background-color: #dc3545; font-size:0.9em; }
        .text-danger { color: #ffdddd; font-size: 0.85em; text-align:left; display:block; margin-top:-15px; margin-bottom:10px; padding-left:5px;}
        .logo-container { display: flex; flex-direction: column; align-items: center; margin-bottom: 10px; }
        .logo-container img.logo-abm { width: 110px; margin-bottom: -30px; }
        .logo-container img.logo-falabella { width: 250px; }
        .footer-text { position: absolute; bottom: 20px; width: 100%; text-align: center; font-family: Verdana, sans-serif; font-weight: bold; color: white; z-index: 1000; font-size: 0.9em; }
        .show-pass-reset { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); font-size: 16px; cursor: pointer; color: #34a012; padding: 5px;}

    </style>
</head>
<body>
    <div class="bg-img">
        <div class="content">
            <div class="logo-container">
                <img src="~/images/logos/logoabm-falabella.png" alt="Logo ABM" class="logo-abm" />
                <img src="~/images/logos/logofalabellalogin.png" alt="Logo Falabella" class="logo-falabella" />
            </div>
            <header>ESTABLECER NUEVA CONTRASEÑA</header>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alerta error" asp-validation-summary="ModelOnly" role="alert"></div>
            }

            <form asp-action="RestablecerClave" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />

                <div class="field">
                    <span class="fa fa-lock" style="color: #34a012;"></span>
                    <input asp-for="NuevaContrasena" class="form-control pass-key-reset" placeholder="Nueva Contraseña" required />
                    <span class="show-pass-reset" data-target="NuevaContrasena"><i class="fa fa-eye"></i></span>
                </div>
                <span asp-validation-for="NuevaContrasena" class="text-danger"></span>

                <div class="field">
                    <span class="fa fa-lock" style="color: #34a012;"></span>
                    <input asp-for="ConfirmarContrasena" class="form-control pass-key-reset" placeholder="Confirmar Nueva Contraseña" required />
                    <span class="show-pass-reset" data-target="ConfirmarContrasena"><i class="fa fa-eye"></i></span>
                </div>
                <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>

                <div class="field" style="margin-top: 25px;">
                    <input type="submit" value="GUARDAR CONTRASEÑA" />
                </div>
            </form>
        </div>
        <div class="footer-text">
            Desarrollado por Bidata
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".show-pass-reset").forEach(showBtn => {
                const targetId = showBtn.dataset.target;
                const pass_field = document.querySelector(`input[name='${targetId}']`);

                if (showBtn && pass_field) {
                    showBtn.addEventListener("click", function () {
                        if (pass_field.type === "password") {
                            pass_field.type = "text";
                            showBtn.innerHTML = '<i class="fa fa-eye-slash"></i>';
                        } else {
                            pass_field.type = "password";
                            showBtn.innerHTML = '<i class="fa fa-eye"></i>';
                        }
                    });
                }
            });
        });
    </script>
</body>
</html>