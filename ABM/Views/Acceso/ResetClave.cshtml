@model ABM.ViewModels.ResetClaveVM
@{
    Layout = null;
    bool exito = TempData["Exito"] != null;
}

<!DOCTYPE html>
<html lang="en" dir="ltr" data-bs-theme="light" data-color-theme="Blue_Theme" data-layout="vertical">

<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/all.min.css" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/images/logos/logoimperial.png" />
    <script src="/js/sweetalert/sweetalert.min.js"></script>
    <title>Restablecer Contraseña</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
        }

        .bg-img {
            background: url('/images/logft/fdlog.png');
            height: 100vh;
            background-size: cover;
            background-position: center;
        }

            .bg-img:after {
                position: absolute;
                content: "";
                top: 0;
                left: 0;
                height: 100%;
                width: 100%;
                background: rgba(0, 0, 0, 0.7);
            }

        .content {
            position: absolute;
            top: 50%;
            left: 50%;
            z-index: 999;
            text-align: center;
            padding: 60px 32px;
            width: 370px;
            transform: translate(-50%, -50%);
            background: rgba(255, 255, 255, 0.04);
            box-shadow: -1px 4px 28px 0px rgba(0, 0, 0, 0.75);
        }

            .content header {
                color: white;
                font-size: 33px;
                font-weight: 600;
                margin: 0 0 35px 0;
                font-family: "Montserrat", sans-serif;
            }

        .field {
            position: relative;
            height: 45px;
            width: 100%;
            display: flex;
            background: rgba(255, 255, 255, 0.94);
            margin-bottom: 16px;
        }

            .field span {
                color: #222;
                width: 40px;
                line-height: 45px;
            }

            .field input {
                height: 100%;
                width: 100%;
                background: transparent;
                border: none;
                outline: none;
                color: #222;
                font-size: 16px;
                font-family: "Poppins", sans-serif;
            }

                .field input[type="submit"] {
                    background: #3498db;
                    border: 1px solid #2691d9;
                    color: white;
                    font-size: 18px;
                    letter-spacing: 1px;
                    font-weight: 600;
                    cursor: pointer;
                    font-family: "Montserrat", sans-serif;
                }

                    .field input[type="submit"]:hover {
                        background: #2691d9;
                    }

        .alerta {
            text-align: left;
            font-family: Verdana, sans-serif;
            font-weight: normal;
            color: white;
            background-color: #ff3030;
            padding: 10px;
            border-radius: 10px;
            font-size: 0.9em;
            margin-bottom: 15px;
        }

            .alerta ul {
                margin: 0;
                padding-left: 20px;
            }

                .alerta ul li {
                    margin-bottom: 5px;
                }

        .footer-text {
            position: absolute;
            bottom: 20px;
            width: 100%;
            text-align: center;
            font-family: Verdana, sans-serif;
            font-weight: bold;
            color: white;
            z-index: 1000;
        }
    </style>
</head>

<body>
    <div class="bg-img">
        <div class="content">
            <img src="~/images/logos/abmlog.png" alt="Logo Imperial" class="" style="width:350px; margin-left:-15px">
            <br />
            <br />
            <header>Restablecer Contraseña</header>
            <form asp-controller="Acceso" asp-action="ResetClave" method="post">
                <input type="hidden" name="Token" value="@Model.Token" />

                @if (ViewData["Mensaje"] != null || ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alerta" role="alert">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <ul>
                            @if (ViewData["Mensaje"] != null)
                            {
                                <li>@ViewData["Mensaje"]</li>
                            }
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <div class="field">
                    <span class="fa fa-lock"></span>
                    <input class="form-control" asp-for="NuevaClave" placeholder="Nueva Contraseña" type="password" />
                </div>

                <div class="field space">
                    <span class="fa fa-lock"></span>
                    <input class="form-control" asp-for="ConfirmarClave" placeholder="Confirmar Contraseña" type="password" />
                </div>

                <div class="field" style="margin-top:20px">
                    <input type="submit" value="Cambiar Contraseña">
                </div>
            </form>
        </div>
        <div class="footer-text">
            Desarrollado por Bidata
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    icon: 'success',
                    title: '¡Éxito!',
                    text: '@TempData["Exito"]',
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    window.location.href = '@Url.Action("Login", "Acceso")';
                });
            });
        </script>
    }

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>

</html>
