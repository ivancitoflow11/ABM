@model ABM.Models.RegistroUsuarioVM

<style>
    .validation-summary-container {
        margin-bottom: 15px;
    }

    .custom-validation {
        border: 1px solid #dc3545;
        border-radius: 4px;
        padding: 10px;
        font-size: 0.9rem;
    }
</style>

<div class="col-12" style="margin-top: 90px">
    <h4 style="margin-top:5px;">Crear Usuario</h4>
    <div class="card w-100 border position-relative overflow-hidden mb-0">
        <div class="card-body p-4">


            <!-- Mensajes de éxito o error -->
            <div class="alert-container">
                @if (ViewData["Success"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        @ViewData["Success"]
                    </div>
                }
                @if (ViewData["Error"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewData["Error"]
                    </div>
                }
            </div>

            <form asp-controller="Acceso" asp-action="Registrarse" method="post">
                @Html.AntiForgeryToken()
                <div class="row">
                    <!-- Columna izquierda -->
                    <div class="col-lg-6" style="margin-top:15px;">
                        <div class="mb-3">
                            <label for="Nombre" class="form-label">Nombre</label>
                            <input class="form-control" type="text" placeholder="Ingrese su nombre" asp-for="Nombre" />
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label for="Usuario" class="form-label">Nombre de Usuario</label>
                            <input class="form-control" type="text" placeholder="Nombre de usuario" asp-for="Usuario" />
                            @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label for="Rut" class="form-label">RUT</label>
                            <input class="form-control" type="text" placeholder="Ingrese su RUT" asp-for="Rut" />
                            @Html.ValidationMessageFor(m => m.Rut, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label for="Password" class="form-label">Contraseña</label>
                            <div class="input-group">
                                <input class="form-control" type="password" placeholder="Ingrese su contraseña" asp-for="Password" id="password" />
                                <span class="input-group-text" id="togglePassword">
                                    <i class="fa fa-eye" aria-hidden="true"></i>
                                </span>
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label for="MesesExpiracionClave" class="form-label">Meses para Expiración de Clave</label>
                            <select class="form-select" asp-for="MesesExpiracionClave" id="MesesExpiracionClave">
                                <option disabled selected>Seleccione meses...</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                            @Html.ValidationMessageFor(m => m.MesesExpiracionClave, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- Columna derecha -->
                    <div class="col-lg-6" style="margin-top:15px;">
                        <div class="mb-3">
                            <label for="Apellidos" class="form-label">Apellidos</label>
                            <input class="form-control" type="text" placeholder="Ingrese sus apellidos" asp-for="Apellidos" />
                            @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label for="Correo" class="form-label">Correo Electrónico</label>
                            <input class="form-control" type="email" placeholder="correo@ejemplo.com" asp-for="Correo" />
                            @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label for="Telefono" class="form-label">Teléfono</label>
                            <input class="form-control" type="text" placeholder="Ingrese su teléfono" asp-for="Telefono" />
                            @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
                        </div>                       
                        <div class="mb-3">
                            <label for="Repeat_Password" class="form-label">Repetir Contraseña</label>
                            <div class="input-group">
                                <input class="form-control" type="password" placeholder="Repita la contraseña" asp-for="Repeat_Password" id="repeatPassword" />
                                <span class="input-group-text" id="toggleRepeatPassword">
                                    <i class="fa fa-eye" aria-hidden="true"></i>
                                </span>
                            </div>
                            @Html.ValidationMessageFor(m => m.Repeat_Password, "", new { @class = "text-danger" })
                        </div>                       
                        <div class="mb-3">
                            <label for="RolId" class="form-label">Rol</label>
                            <select class="form-select" asp-for="RolId" asp-items="@(new SelectList(Model.RolesDisponibles, "idRol", "nombre"))">
                                <option disabled selected value="">Seleccione un rol...</option>
                            </select>
                            @Html.ValidationMessageFor(m => m.RolId, "", new { @class = "text-danger" })
                        </div>

                    </div>

                    <!-- Botón de envío -->
                    <div class="col-12">
                        <div class="d-grid gap-2 mb-3" style="display: flex; justify-content: flex-end;">
                            <button class="btn btn-success" type="submit" style="width: 300px; border-radius:40px; margin-top:15px;">Registrar Usuario</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

<script>
    function togglePasswordVisibility(inputId, toggleId) {
        const passwordInput = document.getElementById(inputId);
        const toggleElement = document.getElementById(toggleId);
        const newType = passwordInput.getAttribute("type") === "password" ? "text" : "password";
        passwordInput.setAttribute("type", newType);
        toggleElement.querySelector("i").classList.toggle("fa-eye-slash");
    }

    document.getElementById("togglePassword").addEventListener("click", function () {
        togglePasswordVisibility("password", "togglePassword");
    });

    document.getElementById("toggleRepeatPassword").addEventListener("click", function () {
        togglePasswordVisibility("repeatPassword", "toggleRepeatPassword");
    });
</script>
}