@model ABM.Models.Usuario
@{
    ViewData["Title"] = "Ajustes de Perfil";
}

@* @{
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
} *@

<style>
    .user-profile-tab .nav-item .nav-link.active {
        border-bottom: 2px solid #0056b3; /* Ajusta el color a tu tema */
        color: #0056b3;
    }
    .user-profile-tab .nav-item .nav-link {
        border-bottom: 2px solid transparent;
    }
    .form-label {
        font-weight: 500;
    }
    .profile-pic-preview {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border: 3px solid #eee;
        border-radius: 50%; /* Para hacerla redonda */
    }
</style>

<div class="container-fluid" style="margin-top:20px;">
    <div class="font-weight-medium shadow-none position-relative overflow-hidden mb-4">
        <div class="card-body px-0">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="font-weight-medium fs-14 mb-0">Configuración de Cuenta</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="breadcrumb-item text-muted" aria-current="page">Ajustes de Perfil</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
@* 
