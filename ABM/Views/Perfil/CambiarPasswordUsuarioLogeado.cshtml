@model ABM.Models.CambiarPasswordLogeadoViewModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
    // Asumiendo que usas el _Layout.cshtml principal.
}

@{
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<style>
    /* Puedes añadir estilos específicos aquí o en tu CSS global si es necesario */
    .form-label {
        font-weight: 500;
    }
    .card-header-custom {
        background-color: #f8f9fa; /* Un color suave para el encabezado de la tarjeta */
        border-bottom: 1px solid #dee2e6;
    }
</style>

<div class="container-fluid" style="margin-top:20px;">
    <div class="font-weight-medium shadow-none position-relative overflow-hidden mb-4">
        <div class="card-body px-0">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="font-weight-medium fs-14 mb-0">Seguridad de la Cuenta</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" asp-controller="Perfil" asp-action="AjustesPerfil">Ajustes de Perfil</a>
                            </li>
                            <li class="breadcrumb-item text-muted" aria-current="page">Cambiar Contraseña</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Html.Raw(successMessage)
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Html.Raw(errorMessage)
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null && ViewData.ModelState[string.Empty].Errors.Any())
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Por favor, corrija los siguientes errores:</strong>
            <ul>
                @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-header card-header-custom">
                    <h5 class="card-title mb-0">Cambiar Contraseña</h5>
                </div>
                <div class="card-body">
                    <p class="card-subtitle mb-4">
                        Para cambiar tu contraseña, por favor completa los siguientes campos.
                        Recuerda que tu nueva contraseña debe tener mínimo 14 caracteres, al menos una letra mayúscula, una minúscula y un número.
                    </p>
                    @* El formulario ahora apunta a PerfilController *@
                    <form asp-controller="Perfil" asp-action="CambiarPasswordUsuarioLogeado" method="post">
                        @Html.AntiForgeryToken()
                        @* <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div> *@

                        <div class="mb-3">
                            <label asp-for="PasswordActual" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="PasswordActual" type="password" class="form-control" placeholder="Ingresa tu contraseña actual" id="passwordActualInput">
                                <span class="input-group-text password-toggle-icon" style="cursor: pointer;" data-target="passwordActualInput">
                                    <i class="fas fa-eye"></i>
                                </span>
                            </div>
                            <span asp-validation-for="PasswordActual" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevaPassword" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="NuevaPassword" type="password" class="form-control" placeholder="Ingresa tu nueva contraseña" id="nuevaPasswordInput">
                                <span class="input-group-text password-toggle-icon" style="cursor: pointer;" data-target="nuevaPasswordInput">
                                    <i class="fas fa-eye"></i>
                                </span>
                            </div>
                            <span asp-validation-for="NuevaPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmarNuevaPassword" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="ConfirmarNuevaPassword" type="password" class="form-control" placeholder="Confirma tu nueva contraseña" id="confirmarNuevaPasswordInput">
                                <span class="input-group-text password-toggle-icon" style="cursor: pointer;" data-target="confirmarNuevaPasswordInput">
                                    <i class="fas fa-eye"></i>
                                </span>
                            </div>
                            <span asp-validation-for="ConfirmarNuevaPassword" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Cambiar Contraseña</button>
                            @* El botón Cancelar apunta a PerfilController y AjustesPerfil *@
                            <a asp-controller="Perfil" asp-action="AjustesPerfil" class="btn btn-light border">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const togglePasswordIcons = document.querySelectorAll('.password-toggle-icon');

            togglePasswordIcons.forEach(iconElement => {
                iconElement.addEventListener('click', function () {
                    const targetInputId = this.getAttribute('data-target');
                    const passwordInput = document.getElementById(targetInputId);
                    const icon = this.querySelector('i');

                    if (passwordInput.type === 'password') {
                        passwordInput.type = 'text';
                        icon.classList.remove('fa-eye');
                        icon.classList.add('fa-eye-slash');
                    } else {
                        passwordInput.type = 'password';
                        icon.classList.remove('fa-eye-slash');
                        icon.classList.add('fa-eye');
                    }
                });
            });
        });
    </script>
}