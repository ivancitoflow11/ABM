@model ABM.Models.MatrizViewModel
@{
    ViewBag.Title = "Matriz";
}

@{
    // Obtener el idUsuarioLogueado de ViewBag
    var idUsuarioLogueado = ViewBag.IdUsuarioLogueado;
}

<link href="~/js/plugins/noty/lib/noty.css" rel="stylesheet" />
<link href="~/js/plugins/noty/lib/themes/sunset.css" rel="stylesheet" />
<style>
    .form-text {
        margin-top: 0.3rem;
        font-size: 14px;
        color: #007bff;
    }

    #loading {
        background: #f4f4f2 url("img/page-bg.png") repeat scroll 0 0;
        height: 100%;
        left: 0;
        margin: auto;
        position: fixed;
        top: 0;
        width: 100%;
    }

    .bokeh {
        border: 0.01em solid rgba(150, 150, 150, 0.1);
        border-radius: 50%;
        font-size: 100px;
        height: 1em;
        list-style: outside none none;
        margin: 0 auto;
        position: relative;
        top: 35%;
        width: 1em;
        z-index: 2147483647;
    }

        .bokeh li {
            border-radius: 50%;
            height: 0.2em;
            position: absolute;
            width: 0.2em;
        }

            .bokeh li:nth-child(1) {
                animation: 1.13s linear 0s normal none infinite running rota, 3.67s ease-in-out 0s alternate none infinite running opa;
                background: white none repeat scroll 0 0;
                left: 50%;
                margin: 0 0 0 -0.1em;
                top: 0;
                transform-origin: 50% 250% 0;
            }

            .bokeh li:nth-child(2) {
                animation: 1.86s linear 0s normal none infinite running rota, 4.29s ease-in-out 0s alternate none infinite running opa;
                background: #ffa423 none repeat scroll 0 0;
                margin: -0.1em 0 0;
                right: 0;
                top: 50%;
                transform-origin: -150% 50% 0;
            }

            .bokeh li:nth-child(3) {
                animation: 1.45s linear 0s normal none infinite running rota, 5.12s ease-in-out 0s alternate none infinite running opa;
                background: #156db6 none repeat scroll 0 0;
                bottom: 0;
                left: 50%;
                margin: 0 0 0 -0.1em;
                transform-origin: 50% -150% 0;
            }

            .bokeh li:nth-child(4) {
                animation: 1.72s linear 0s normal none infinite running rota, 5.25s ease-in-out 0s alternate none infinite running opa;
                background: #88c100 none repeat scroll 0 0;
                margin: -0.1em 0 0;
                top: 50%;
                transform-origin: 250% 50% 0;
            }

   /*  @@keyframes opa {
        12% {
            opacity: 0.8;
        }

        19.5% {
            opacity: 0.88;
        }

        37.2% {
            opacity: 0.64;
        }

        40.5% {
            opacity: 0.52;
        }

        52.7% {
            opacity: 0.69;
        }

        60.2% {
            opacity: 0.6;
        }

        66.6% {
            opacity: 0.52;
        }

        70% {
            opacity: 0.63;
        }

        79.9% {
            opacity: 0.6;
        }

        84.2% {
            opacity: 0.75;
        }

        91% {
            opacity: 0.87;
        }
    }

    @@keyframes rota {
        100% {
            transform: rotate(360deg);
        }
    } */
</style>


<div id="loading" style="z-index:999999;display:none">
    <ul class="bokeh">
        <li></li>
        <li></li>
        <li></li>
    </ul>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <h5 class="card-header">Lista Sistemas </h5>

            <div class="card-body table-responsive">
                <div>
                    <table class="table table-bordered table-hover table-responsive">
                        <thead>
                            <tr>
                                <th>Id Sistema</th>
                                <th>Nombre Sistema</th>
                                <th>Acciones</th>
                            </tr>

                        </thead>
                        @if (Model != null && Model.Sistemas != null && Model.Sistemas.Any())
                        {
                            <tbody>
                                @foreach (var item in Model.Sistemas)
                                {
                                    <tr>
                                        <td>@item.idSistema</td>
                                        <td>@item.sistema</td>
                                        <td>
                                            @if (idUsuarioLogueado != null)
                                            {
                                                <a class="btn btn-info" href="@Url.Action("ListaMatriz", "Archivos", new { idUsuarioLogueado = ViewBag.IdUsuarioLogueado, idSistema = item.idSistema })">
                                                    <i class="fas fa-arrow-right"></i>
                                                    Ver Matriz
                                                </a>

                                            }
                                        </td>


                                    </tr>
                                }
                            </tbody>
                        }
                    </table>

                </div>
            </div>
        </div>
    </div>



</div>


@section scripts {
    <script src="~/js/sweetalert/sweetalert.min.js"></script>
    <script src="~/js/plugins/noty/lib/bounce.min.js"></script>
    <script src="~/js/plugins/noty/lib/noty.js"></script>
    <script src="~/js/FileSaver/FileSaver.js"></script>
    <script src="~/js/SheetJs/xlsx.min.js"></script>
    @* <script src="~/js/scripts.bundle.js"></script> *@
    <script src="/js/vendor.min.js"></script>
    <script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="/js/datatable/datatable-basic.init.js"></script>
    <script src="/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>

    @if (ViewBag.Existe == false)
    {

        <script>
            Swal.fire({
                title: 'Informacion',
                icon: 'warning',
                showCancelButton: false,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Aceptar',
                html: "<strong>No se encontró campañas asociadas al Rut ingresado.</strong>",
            }).then(async (result) => {
                if (result.isConfirmed) {

                    //recargar();
                }
            });
        </script>
    }

    <script>

        const BuscarCertificadoCliente = (Tipo) => {
            let RutClienteBuscar = document.getElementById('RutClienteBuscar').value;
            if (RutClienteBuscar !== "") {

                if (Tipo === "ExcCupo") {

                    Swal.fire({
                        icon: 'warning',
                        title: 'Se generará un Caso Especial.',
                        input: 'checkbox',
                        inputPlaceholder: 'Aceptar Caso Especial',
                        confirmButtonText: 'Aceptar',

                    }).then(function (result) {
                        if (result.value === 1) {
                            window.location.href = "../Home/ConsultaSolvencia?Rut=" + RutClienteBuscar + "&&Tipo=" + Tipo;

                        } else if (result.value === 0) {
                            Swal.fire({
                                icon: 'warning',
                                text: "Debe aceptar Caso Especial"
                            });
                        }
                    });

                }
                else {
                    window.location.href = "../Home/ConsultaSolvencia?Rut=" + RutClienteBuscar + "&&Tipo=" + Tipo;
                }


            }
            else {
                Swal.fire({
                    title: 'Informacion',
                    icon: 'warning',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Aceptar',
                    html: "<strong>Debe ingresar el Rut.</strong>",
                }).then(async (result) => {
                    if (result.isConfirmed) {

                        //recargar();
                    }
                });
            }
        };

    </script>




}