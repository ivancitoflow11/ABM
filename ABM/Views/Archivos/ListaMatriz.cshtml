 <br />
 <br />
 <br />
<div id="loading" style="z-index:999999;display:none">
	<ul class="bokeh">
		<li></li>
		<li></li>
		<li></li>
	</ul>
</div>
<div class="row">
	<div class="col-md-12">

		<h4><i class="fa-solid fa-bars-staggered"></i> Lista Matriz </h4>
		<div class="card mb-12">

			<input type="hidden" id="IdSistema" value="@ViewBag.IdSistema" />

			<div class="card-body">
				<div class="pull-right">
				</div>


				<!-- Agregamos el select y el botón de filtro -->
				<div class="row my-3">
					<div class="col-md-4 d-flex align-items-end">
						<div class="me-2">
							<label for="estadoFiltro">Ordenar por:</label>
							<select id="estadoFiltro" class="form-control">
								<option value="Todos">Todos</option>
								<option value="Correcto">Correcto</option>
								<option value="Autorizado">Autorizado</option>
							</select>
						</div>

						@if (ViewBag.TieneGerencia && ViewBag.EsResponsableFirma)
						{
							<button class="btn btn-info" id="btnFirmar">Firmar Matriz</button>
						}
					</div>
				</div>
				<br />

				<div class="col-lg-12 table-responsive">

					<table id="file_export4" class="table table-bordered table-hover zero_config" style="width:100%; align-content:center; justify-content:center;text-align:center; table-layout: auto;">
						<thead>
							<tr>
								<th style="white-space: nowrap;">Sistema</th>
								<th style="white-space: nowrap;">RUT/DNI</th>
								<th style="white-space: nowrap;">DV</th>
								<th style="white-space: nowrap;">Nombre Usuario</th>
								<th style="white-space: nowrap;">Usuario</th>
								<th style="white-space: nowrap;">Cargo</th>
								<th style="white-space: nowrap;">Perfil</th>
								<th style="white-space: nowrap;">Gerencia</th>
								<th style="white-space: nowrap;">Subgerencia</th>
								<th style="white-space: nowrap;">Fecha Carga</th>
								<th style="white-space: nowrap;">Evidencia</th>
								<th style="white-space: nowrap;">Cta Duplicada</th>
								<th style="white-space: nowrap;">Estado Matriz</th>
							</tr>
						</thead>
						<tbody id="tablaMatriz">
							@if (Model != null && Model.ListaMatrizPerfil != null && Model.ListaMatrizPerfil.Any())
							{
								@foreach (var item in Model.ListaMatrizPerfil)
								{
									// Determina la clase basada en el estado
									var estadoClase = "";
									@if (item.EstadoMatrizPerfil == "Incorrecto")
									{
										estadoClase = "estado-incorrecto";
									}
									else if (item.EstadoMatrizPerfil == "Autorizado")
									{
										estadoClase = "estado-autorizado";
									}
									else if (item.EstadoMatrizPerfil == "Correcto")
									{
										estadoClase = "estado-correcto";
									}

									<tr class="@estadoClase">
										<td style="white-space: nowrap;">@item.sistema</td>
										<td style="white-space: nowrap;">@item.rutdni</td>
										<td style="white-space: nowrap;">@item.dv</td>
										<td style="white-space: nowrap;">@item.nombreusuario</td>
										<td style="white-space: nowrap;">@item.userid</td>
										<td style="white-space: nowrap;">@item.cargospr</td>
										<td style="white-space: nowrap;">@item.perfil</td>
										<td style="white-space: nowrap;">@item.Nom_Gerencia</td>
										<td style="white-space: nowrap;">@item.Nom_Subgerencia</td>
										<td style="white-space: nowrap;">@item.feccarga</td>
										<td style="white-space: nowrap;">
											@if (item.Evidencia != "Sin evidencia")
											{
												<a target='_black' href="/ExcepcionesEvidencias/@item.Evidencia" class='btn btn-sm btn-primary'><i class="fa-solid fa-download"></i></a>
											}
										</td>
										<td style="white-space: nowrap;">@item.cta_duplicada</td>
										<td class="estadoMatrizPerfil" style="white-space: nowrap;">@item.EstadoMatrizPerfil</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			</div>

		</div>
	</div>



</div>


@section scripts {

	<script src="~/js/plugins/noty/lib/bounce.min.js"></script>
	<script src="~/js/plugins/noty/lib/noty.js"></script>
	<script src="~/js/FileSaver/FileSaver.js"></script>
	<script src="~/js/SheetJs/xlsx.min.js"></script>

	<script src="~/js/Fetch.js"></script>
	<script src="/js/sweetalert/sweetalert.min.js"></script>


	<script src="/js/vendor.min.js"></script>
	<script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
	<script src="/js/dataTables.buttons.min.js"></script>
	<script src="/js/jszip.min.js"></script>
	<script src="/js/pdfmake.min.js"></script>
	<script src="/js/vfs_fonts.js"></script>
	<script src="/js/buttons.html5.min.js"></script>
	<script src="/js/buttons.print.min.js"></script>
	<script src="/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>

	<script>
		$(document).ready(function () {
			var table = $('.zero_config').DataTable();

			// Función para aplicar el filtro
			function aplicarFiltro() {
				var filtro = $('#estadoFiltro').val();
				table.column(12).search(filtro === 'Todos' ? '' : filtro, true, false).draw();
			}

			// Evento change para el select
			$('#estadoFiltro').on('change', aplicarFiltro);

			// Aplicar filtro inicial (opcional)
			aplicarFiltro();
		});

		function mostrarMensaje(titulo, texto, tipo) {
			return Swal.fire({
				icon: tipo,
				title: titulo,
				text: texto,
				confirmButtonText: 'Aceptar',
				customClass: {
					popup: 'custom-modal-class'
				}
			});
		}

		document.getElementById("btnFirmar").addEventListener("click", function () {
			const btn = this;
			btn.disabled = true;

			Swal.fire({
				title: 'Firma de Matriz',
				input: 'textarea',
				inputLabel: 'Ingrese un comentario para la firma:',
				inputPlaceholder: 'Escribe tu comentario aquí...',
				showCancelButton: true,
				confirmButtonText: 'Firmar',
				cancelButtonText: 'Cancelar',
				showLoaderOnConfirm: true,
				customClass: {
					popup: 'custom-modal-class'
				},
				preConfirm: (comentario) => {
					if (!comentario || comentario.trim().length < 5) {
						Swal.showValidationMessage('Debes ingresar un comentario con al menos 5 caracteres para firmar.');
						return false;
					}
					Swal.showLoading();

					return new Promise((resolve) => {
						$.ajax({
							url: '@Url.Action("CrearFirmaConDetalles", "Archivos")',
							type: 'POST',
							data: {
								idUsuarioLogueado: @ViewBag.ID,
								idSistema: @ViewBag.IdSistema,
								comentario: comentario.trim()
							},
							success: function (response) {
								resolve(response);
							},
							error: function (jqXHR, textStatus, errorThrown) {
								resolve({
									respuesta: false,
									mensaje: "Error en la conexión. Por favor, intente nuevamente."
								});
							}
						});
					}).finally(() => {
						Swal.hideLoading();
					});
				},
				allowOutsideClick: () => !Swal.isLoading()
			}).then((result) => {
				if (result.isConfirmed && result.value) {
					let icon = 'warning';
					let title = 'Resultado de la Firma';
					let message = 'Ocurrió un error desconocido.';

					if (typeof result.value === 'object') {
						const respuesta = result.value.respuesta || result.value.RESPUESTA;
						const mensaje = result.value.mensaje || result.value.MENSAJE || message;

						if (respuesta === true) {
							icon = 'success';
							title = 'Firma Exitosa';
						} else if (mensaje.toLowerCase().includes("no hay datos")) {
							icon = 'error';
							title = 'Sin Datos para Firmar';
						} else if (mensaje.toLowerCase().includes("usuario no encontrado")) {
							icon = 'error';
							title = 'Usuario No Válido';
						} else {
							icon = 'warning';
							title = 'Firma No Creada';
						}
						message = mensaje;
					}

					Swal.fire({
						icon: icon,
						title: title,
						text: message,
						confirmButtonText: 'Entendido',
						customClass: {
							popup: 'custom-modal-class'
						}
					}).then(() => {
						if (icon === 'success') {
							location.reload();
						}
					});
				}
			}).finally(() => {
				btn.disabled = false;
			});
		});
	</script>


}