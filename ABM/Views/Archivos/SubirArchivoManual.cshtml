@model ABM.Models.Abm_Sistema

@{
    ViewBag.Title = "SubirArchivoManual";
}

<!-- Favicon icon-->
<link rel="shortcut icon" type="image/png" href="/images/logos/logoimperial.png" />

<!-- Core Css -->
<link rel="stylesheet" href="/css/styles.css" asp-append-version="true" />
<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <h5 class="card-header">Cargar Archivo Sistema: <b>@Model.sistema</b> </h5>

            @*ALERTAS*@

            @if (TempData["RespuestaE"] != null)
            {
                var respuesta = (int)TempData["RespuestaE"];

                if (respuesta == 1)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Sistema:</strong> Error de archivo
                        <button type="button" class="btn-close mt-2" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                else if (respuesta == 2)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>Sistema:</strong> ..
                        <button type="button" class="btn-close mt-2" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                else if (respuesta == 3)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>Sistema:</strong> Archivo cargado exitosamente
                        <button type="button" class="btn-close mt-2" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            }

            <div class="card-body">
                @using (Html.BeginForm("CargarArchivoManual", "Archivos", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <input type="hidden" id="IdSistema" name="Id" value="@Model.idSistema" />
                    <input type="hidden" name="NombreSistema" value="@Model.sistema" />

                    <div>
                        <label for="defaultFormControlInput" class="form-label">Selecione Archivo</label>
                        <input class="form-control form-control-sm"  type="file" multiple="multiple" name="FileUpload" id="FileUpload" >
                    </div>

                    <div class="pull-right" style="margin-top:2%">
                        <button type="submit" class="btn btn-success">Guardar</button>
                    </div>
                }

            </div>
        </div>
    </div>


</div>

