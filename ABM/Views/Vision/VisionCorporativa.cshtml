@using Newtonsoft.Json
@model VisionViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vision Corporativa</title>
    <link href="~/css/leaflet.css" rel="stylesheet" />

    
</head>
<body>
    <br />
    <br />
    <br />
    <br />
    <h3 style="text-align:center">
        Visión corporativa – @(Context.Session.GetString("Negocio") ?? "Negocio")
    </h3>

    <div class="container-fluid">
        <div class="row">
            <!-- Mapa en el lado izquierdo (ocupa 6 columnas de 12) -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Seleccione un País</h4>
                        <div id="visitfromworld" style="width: 100%; height: 750px; border-radius: 8px; border: 1px solid #e0e0e0;"></div>
                        <div class="selected-country" id="selectedCountryJvm" style="text-align: center; font-weight: bold; color: #5090c0; margin-top: 10px;">
                            País seleccionado:
                            @{
                                var selPaisJvm = Model.ListaPaises.FirstOrDefault(x => x.IdPais == Model.SelectedPais);
                                @((selPaisJvm?.NombrePais) ?? "Ninguno")
                                ;
                            }
                        </div>
                        <form asp-action="VisionCorporativa" method="get" id="countryFormJvm">
                            <input type="hidden" id="idPaisJvm" name="idPais" value="@Model.SelectedPais" />
                        </form>
                    </div>
                </div>
            </div>


            <!-- Cards en el lado derecho (ocupa 6 columnas de 12) -->
            <div class="col-md-6">
                <!-- Primera card: Resumen Sistema -->
                <div class="card mb-4" style="max-height: 480px; overflow-y: auto;">
                    <div class="card-header text-white" style="background-color: #acd743;">
                        Resumen Sistema
                    </div>
                    <div class="card-body">
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" data-bs-toggle="tab" href="#sistema" role="tab">
                                    <span>RIESGO SISTEMAS</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#pais" role="tab">
                                    <span>RIESGO PAÍS</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#evolucion" role="tab">
                                    <span>EVOLUCIÓN DÍA</span>
                                </a>
                            </li>
                        </ul>
                        <!-- Tab panes -->
                        <div class="tab-content">
                            <div class="tab-pane active p-3" id="sistema" role="tabpanel">
                                <p class="fw-semibold mb-3">Resultados a la última fecha de carga:</p>
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th scope="col">Sistemas</th>
                                            <th scope="col">Finiquitados</th>
                                            <th scope="col">No Encontrados</th>
                                            <th scope="col">Activos</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.ListaRiesgoSistema != null && Model.ListaRiesgoSistema.Any())
                                        {
                                            foreach (var item in Model.ListaRiesgoSistema)
                                            {
                                                <tr>
                                                    <td>@item.Sistema</td>
                                                    <td>@item.Finiquitados</td>
                                                    <td>@item.NoEncontrados</td>
                                                    <td>@item.Activos</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="tab-pane p-3" id="pais" role="tabpanel">
                                <p class="fw-semibold mb-3">Resultados a la última fecha de carga:</p>
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th scope="col">País</th>
                                            <th scope="col">Finiquitados</th>
                                            <th scope="col">No Encontrados</th>
                                            <th scope="col">Activos</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.ListaRiesgoPais != null && Model.ListaRiesgoPais.Any())
                                        {
                                            @foreach (var item in Model.ListaRiesgoPais)
                                            {
                                                <tr>
                                                    <td>@item.Pais</td>
                                                    <td>@item.cnt_finiquitados</td>
                                                    <td>@item.cnt_no_encontrados</td>
                                                    <td>@item.cnt_activos</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="tab-pane p-3" id="evolucion" role="tabpanel">
                                <p class="fw-semibold mb-3">Resultados últimos 60 días:</p>
                                <table id="tendenciasTable" class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th scope="col" onclick="sortTable()">Fecha Carga &#x25B2;&#x25BC;</th>
                                            <th scope="col">Finiquitados</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tendenciasBody">
                                        @if (Model.ListaTendenciaDiaria != null && Model.ListaTendenciaDiaria.Any())
                                        {
                                            foreach (var item in Model.ListaTendenciaDiaria)
                                            {
                                                <tr>
                                                    <td>@item.feccarga</td>
                                                    <td>@item.cnt_finiquitados</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Segunda card: Mapa Riesgo ABM -->
                <div class="card mb-4">
                    <div class="card-header text-white" style="background-color: #acd743;">
                        Mapa Riesgo ABM
                    </div>
                    <h1 style="text-align:center; margin-top:19px; font-size: 25px; font-family: 'Poppins', sans-serif; font-weight: normal; color: #85929e;">Riesgo Perfil</h1>
                    <div class="card-body">
                        <div id="risk" style="height: 300px; width: 100%;background-image: url('/images/calor.png'); background-size: cover; background-position: center; height: 200px;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-12" hidden>
        <div class="row mb-12">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        Filtrar Datos del Negocio por Fecha
                    </div>
                    <div class="card-body d-flex flex-column align-items-center">
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" id="datepicker-autoclose" placeholder="mm/dd/yyyy" style="text-align:center">
                            <span class="input-group-text">
                                <i class="ti ti-calendar fs-5"></i>
                            </span>
                        </div>
                        <button type="submit" class="btn btn-primary" style="width: 100px;">
                            Filtrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card mb-4">
                    <div class="card-header text-white" style="background-color: #acd743;">
                        Gestión Historica
                    </div>
                    <div class="row mt-2 mx-2">
                        <div class="col-md-9"></div>
                        <div class="col-md-3" style="align-items:end">
                            <select class="form-select" id="sistemaSelect">
                                <option selected disabled>Seleccione Sistema</option>
                                @if (Model.ListaSistema != null && Model.ListaSistema.Any())
                                {
                                    @foreach (var item in Model.ListaSistema)
                                    {
                                        <option value="@item.idSistema">@item.sistema</option>
                                    }
                                }
                            </select>
                        </div>

                    </div>
                    <div class="row">
                        <div class="card-body col-md-6">
                            <div id="chartContainer" style="height: 500px; width: 100%;">
                            </div>
                            <!-- Contenido para la gestión histórica -->
                        </div>
                        <div class="card-body col-md-6">
                            <div id="chartContainer2" style="height: 500px; width: 100%;">
                            </div>
                            <!-- Contenido para la gestión histórica -->
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>


    @section scripts {
        <script src="~/libs/jvectormap/jquery-jvectormap.min.js"></script>
        <script src="~/js/extra-libs/jvectormap/jquery-jvectormap-world-mill-en.js"></script>
        <script src="/js/canvasjs-chart-3.10.9/canvasjs.min.js"></script>
        <script>
            $(function () {
                const colorVerdeNegocio = '#28a745'; // Verde para países con negocio
                const colorAzulSeleccionado = '#007bff'; // Azul para país seleccionado
                const colorGrisOtros = '#D3D3D3'; // Gris para otros países

                const paisesMapeados = { // Solo necesitas codigoJvm aquí si los colores son fijos
                    1: { codigoJvm: 'CL' },
                    2: { codigoJvm: 'CO' },
                    3: { codigoJvm: 'AR' },
                    6: { codigoJvm: 'PE' },
                    7: { codigoJvm: 'CN' },
                    8: { codigoJvm: 'MX' },
                    10: { codigoJvm: 'UY' },
                    11: { codigoJvm: 'BR' }
                };

                const idsPaisesConNegocio = @Html.Raw(Json.Serialize(Model.ListaPaises.Select(p => p.IdPais)));
                const modelPaisesData = @Html.Raw(Json.Serialize(Model.ListaPaises.Select(p => new { p.IdPais, p.NombrePais })));
                const selectedPaisIdDesdeModelo = @Model.SelectedPais;

                let coloresEspecificosParaSeries = {}; // { 'CL': 'color', 'AR': 'color' }
                let initialSelectedRegionCode = null;
                let codigosJvmPaisesConNegocio = [];
                var mapObject; // Para guardar la referencia al mapa

                idsPaisesConNegocio.forEach(idModelo => {
                    if (paisesMapeados[idModelo]) {
                        const codigoJvm = paisesMapeados[idModelo].codigoJvm;
                        codigosJvmPaisesConNegocio.push(codigoJvm);

                        // Por defecto, los países con negocio son verdes
                        coloresEspecificosParaSeries[codigoJvm] = colorVerdeNegocio;

                        if (idModelo == selectedPaisIdDesdeModelo) {
                            initialSelectedRegionCode = codigoJvm;
                            // Si está seleccionado desde el modelo, su color inicial es azul
                            coloresEspecificosParaSeries[codigoJvm] = colorAzulSeleccionado;
                        }
                    }
                });

                $('#visitfromworld').vectorMap({
                    map: 'world_mill_en',
                    backgroundColor: '#FFFFFF',
                    // Configuración de focusOn para América Latina
                    focusOn: {
                        x: 0.25,        // Posición horizontal (0-1)
                        y: 0.6,         // Posición vertical (0-1)
                        scale: 2,       // Nivel de zoom
                        animate: true   // Animación al cargar
                    },
                    regionStyle: {
                        initial: {
                            fill: colorGrisOtros, // GRIS BASE PARA TODOS LOS PAÍSES
                            "stroke-width": 0.5,
                            stroke: "#FFFFFF",
                            cursor: 'default'
                        },
                        hover: function (event, code, region) {
                            if (codigosJvmPaisesConNegocio.includes(code)) {
                                return {
                                    fillOpacity: 0.7,
                                    cursor: 'pointer'
                                };
                            }
                            return { cursor: 'default' };
                        },
                        selected: { // Estilo visual de jVectorMap al seleccionar (borde, etc.)
                            // El color de relleno lo manejaremos dinámicamente con series.setValues
                            fillOpacity: 1
                        },
                        selectedHover: {}
                    },
                    series: {
                        regions: [{
                            values: coloresEspecificosParaSeries, // Colores iniciales (verde/azul)
                            attribute: 'fill'
                            // No se usa defaultFill aquí, ya que regionStyle.initial.fill lo maneja
                        }]
                    },
                    regionsSelectable: true,
                    regionsSelectableOne: true,
                    onRegionClick: function (event, code, regionName) {
                        var currentMap = $('#visitfromworld').vectorMap('get', 'mapObject'); // Obtener instancia del mapa

                        if (!codigosJvmPaisesConNegocio.includes(code)) {
                            event.preventDefault();
                            // Si se hizo clic en un país gris, deseleccionar y restaurar colores
                            currentMap.clearSelectedRegions();
                            let tempColores = {};
                            codigosJvmPaisesConNegocio.forEach(c => {
                                tempColores[c] = colorVerdeNegocio; // Todos los de negocio a verde
                            });
                            currentMap.series.regions[0].setValues(tempColores);
                            $('#selectedCountryJvm').text('País seleccionado: Ninguno');
                            return;
                        }

                        // Si se hizo clic en un país con negocio
                        let idPaisOriginal = null;
                        let nombrePaisParaActualizarDOM = "Cargando...";

                        for (const id in paisesMapeados) {
                            if (paisesMapeados[id].codigoJvm === code) {
                                idPaisOriginal = id;
                                const paisInfoServer = modelPaisesData.find(p => p.IdPais == idPaisOriginal);
                                if (paisInfoServer && paisInfoServer.NombrePais) {
                                    nombrePaisParaActualizarDOM = paisInfoServer.NombrePais;
                                } else if (regionName) {
                                    nombrePaisParaActualizarDOM = regionName;
                                }
                                break;
                            }
                        }

                        $('#selectedCountryJvm').text(`País seleccionado: ${nombrePaisParaActualizarDOM}`);

                        // Actualizar dinámicamente los colores
                        let nuevosColores = {};
                        codigosJvmPaisesConNegocio.forEach(jvmCode => {
                            if (jvmCode === code) { // El país clickeado/seleccionado
                                nuevosColores[jvmCode] = colorAzulSeleccionado;
                            } else { // Otros países con negocio
                                nuevosColores[jvmCode] = colorVerdeNegocio;
                            }
                        });
                        currentMap.series.regions[0].setValues(nuevosColores);
                        // La selección visual de jVectorMap (borde, etc.) se maneja automáticamente
                        // al no hacer event.preventDefault() para regiones seleccionables.

                        if (idPaisOriginal) {
                            window.location.href = '@Url.Action("VisionCorporativa", "Vision")?idPais=' + idPaisOriginal;
                        } else {
                            $('#selectedCountryJvm').text(`País seleccionado: Error`);
                        }
                    },
                    onRegionTipShow: function (e, el, code) {
                        if (!codigosJvmPaisesConNegocio.includes(code)) {
                            e.preventDefault();
                            return;
                        }
                        let nombrePaisParaTooltip = el.html();
                        for (const id in paisesMapeados) {
                            if (paisesMapeados[id].codigoJvm === code) {
                                const paisInfoServer = modelPaisesData.find(p => p.IdPais == id);
                                if (paisInfoServer && paisInfoServer.NombrePais) {
                                    nombrePaisParaTooltip = paisInfoServer.NombrePais;
                                }
                                break;
                            }
                        }
                        el.html(nombrePaisParaTooltip);
                    },
                    zoomButtons: true,
                    zoomOnScroll: true,
                    onLoaded: function (event, currentMapInstance) { // 'map' aquí es la instancia
                        mapObject = currentMapInstance; // Guardar referencia
                        let nombrePaisInicialRender = "Ninguno";

                        // Aplicar colores iniciales y selección
                        let coloresInicialesCarga = {};
                        codigosJvmPaisesConNegocio.forEach(c => {
                            coloresInicialesCarga[c] = (c === initialSelectedRegionCode) ? colorAzulSeleccionado : colorVerdeNegocio;
                        });
                        mapObject.series.regions[0].setValues(coloresInicialesCarga);

                        if (initialSelectedRegionCode) {
                            mapObject.setSelectedRegions(initialSelectedRegionCode); // Para el estilo visual de jVectorMap
                            const idPaisInicial = Object.keys(paisesMapeados).find(key => paisesMapeados[key].codigoJvm === initialSelectedRegionCode);
                            if (idPaisInicial) {
                                const paisInfoServer = modelPaisesData.find(p => p.IdPais == idPaisInicial);
                                if (paisInfoServer && paisInfoServer.NombrePais) {
                                    nombrePaisInicialRender = paisInfoServer.NombrePais;
                                }
                            }
                        } else {
                            // Si no hay selección inicial, pero hay un selectedPaisIdDesdeModelo (podría ser un ID inválido o no mapeado)
                            const paisSeleccionadoModelo = modelPaisesData.find(p => p.IdPais == selectedPaisIdDesdeModelo);
                            if (paisSeleccionadoModelo && paisSeleccionadoModelo.NombrePais) {
                                // Esto es solo para el texto, el color ya sería verde por defecto si no es initialSelectedRegionCode
                                nombrePaisInicialRender = paisSeleccionadoModelo.NombrePais;
                            }
                        }
                        $('#selectedCountryJvm').text(`País seleccionado: ${nombrePaisInicialRender}`);
                    }
                });
            });
        </script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // 1) Creo dataPoints intercambiando X <-> Y
                var dataPoints = [];
            @foreach (var item in Model.RiesgoPerfil)
            {
                @:dataPoints.push({ x: @item.Riesgo_Alto, y: @item.nriesgo, type: "Riesgo_Alto", sistema: "@item.Sistema" });
                @:dataPoints.push({ x: @item.Riesgo_Medio, y: @item.nriesgo, type: "Riesgo_Medio", sistema: "@item.Sistema" });
                @:dataPoints.push({ x: @item.Riesgo_Bajo, y: @item.nriesgo, type: "Riesgo_Bajo", sistema: "@item.Sistema" });
            }

                // 2) Calcular rangos dinámicos para ambos ejes
                var xs = dataPoints.map(function (dp) { return dp.x; });
                var ys = dataPoints.map(function (dp) { return dp.y; });

                var minX = Math.min.apply(null, xs) - 1;
                var maxX = Math.max.apply(null, xs) + 1;
                var minY = Math.min.apply(null, ys) - 1;
                var maxY = Math.max.apply(null, ys) + 1;

                // 3) Construir el gráfico con ejes intercambiados
                var chart = new CanvasJS.Chart("risk", {
                    backgroundColor: "rgba(255, 255, 255, 0.1)",
                    animationEnabled: true,
                    theme: "light2",

                    // Ahora el eje X muestra los conteos (Riesgos Alto/Medio/Bajo)
                    axisX: {
                        title: "Nivel de Riesgo",
                        titleFontFamily: "Poppins",
                        titleFontSize: 16,
                        titleFontWeight: "normal",
                        titleFontColor: "#000",
                        minimum: minX,
                        maximum: maxX,
                        interval: Math.ceil((maxX - minX) / 5),
                        labelAngle: -45,
                        labelFontSize: 12,
                        fontFamily: "Poppins",
                        fontColor: "#000",
                        gridThickness: 1,
                        gridColor: "rgba(0,0,0,0.5)",
                        lineColor: "#000",
                        lineThickness: 2
                    },

                    // Y el eje Y muestra ahora el nRiesgo (nivel de riesgo)
                    axisY: {
                        title: "N° Riesgo",
                        titleFontFamily: "Poppins",
                        titleFontSize: 16,
                        titleFontWeight: "bold",
                        titleFontColor: "#000",
                        minimum: minY,
                        maximum: maxY,
                        interval: Math.ceil((maxY - minY) / 5),
                        labelFontSize: 12,
                        fontFamily: "Poppins",
                        fontColor: "#000",
                        gridThickness: 1,
                        gridColor: "rgba(0,0,0,0.5)",
                        lineColor: "#000",
                        lineThickness: 2
                    },

                    data: [{
                        type: "scatter",
                        markerType: "circle",
                        markerSize: 15,
                        dataPoints: dataPoints,
                        toolTipContent: "<b>Sistema: {sistema}</b><br/>Nivel de Riesgo: {x}<br/>N°: {y}<br/>",
                        markerColor: function (dp) {
                            if (dp.type === "Riesgo_Alto") return "red";
                            if (dp.type === "Riesgo_Medio") return "orange";
                            return "green";
                        }
                    }]
                });

                chart.render();
            });
        </script>



        <script type="text/javascript">
            function convertToDate(fechaString) {
                var fechaParts = fechaString.split('-');
                return new Date(fechaParts[2], fechaParts[1] - 1, fechaParts[0]);
            }
            function sortTable() {
                var tbody = document.getElementById("tendenciasBody");
                var rows = Array.from(tbody.querySelectorAll("tr"));

                rows.sort(function (rowA, rowB) {
                    var dateA = convertToDate(rowA.cells[0].innerText);
                    var dateB = convertToDate(rowB.cells[0].innerText);
                    return dateB - dateA;
                });

                tbody.innerHTML = "";
                rows.forEach(function (row) {
                    tbody.appendChild(row);
                });
            }

            window.onload = function () {
                sortTable();
            };
        </script>


        <script type="text/javascript">
            document.getElementById('sistemaSelect')
                .addEventListener('change', function () {
                    var sistema = parseInt(this.value);
                    var idPais = @Model.SelectedPais;

                    fetch(`@Url.Action("ObtenerGraficoDinamico", "Vision")?sistema=${sistema}&idPais=${idPais}`)
                        .then(resp => resp.json())
                        .then(data => renderizarGrafico(data));
                });

            function renderizarGrafico(data) {
                var chart2 = new CanvasJS.Chart("chartContainer2", {
                    animationEnabled: true,
                    title: {
                        text: "Tendencia Finiquitados por Sistema (últimos 30 días)",
                        fontFamily: "Poppins",
                        fontSize: 25,
                        fontWeight: "normal",
                        fontColor: "#808080"
                    },
                    axisY: {
                        title: "Cantidad Finiquitados",
                        valueFormatString: "#,##0",
                        stripLines: [{
                            value: 0
                        }]
                    },
                    axisX: {
                        valueFormatString: "DD-MM-YYYY",
                        labelAngle: -45
                    },
                    data: [{
                        type: "line",
                        xValueFormatString: "DD-MM-YYYY",
                        yValueFormatString: "#,##0",
                        dataPoints: data.map(item => {
                            const [year, month, day] = item.feccarga.split('-');
                            return {
                                x: new Date(year, month - 1, day),
                                y: item.cantidad_finiquitados || 0
                            };
                        })
                    }]
                });
                chart2.render();
            }
        </script>

        <script type="text/javascript">
            window.onload = function () {
                var chart1 = new CanvasJS.Chart("chartContainer", {
                    animationEnabled: true,
                    title: {
                        text: "Tendencia Finiquitados (últimos 60 días)",
                        fontFamily: "Poppins",
                        fontSize: 25,
                        fontWeight: "normal",
                        fontColor: "#808080",
                    },
                    axisY: {
                        title: "Cantidad Finiquitados",
                        valueFormatString: "#,##0",
                        stripLines: [{
                            value: 0
                        }]
                    },
                    axisX: {
                        labelAngle: -45,
                        valueFormatString: "DD-MM-YYYY"
                    },
                    data: [{
                        type: "line",
                        xValueFormatString: "DD-MM-YYYY",
                        yValueFormatString: "#,##0",
                        dataPoints: [
            @if (Model.ListaTendenciaDiaria != null && Model.ListaTendenciaDiaria.Any())
            {
                foreach (var item in Model.ListaTendenciaDiaria)
                {
                    @:{ x: new Date("@item.feccarga"), y: @item.cnt_finiquitados },
                }
            }
                    ]
                    }]
                });
                chart1.render();
            }
        </script>
    }


</body>
</html>
