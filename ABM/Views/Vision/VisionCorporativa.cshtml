@using Newtonsoft.Json
@model VisionViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vision Corporativa</title>
    <link href="~/css/leaflet.css" rel="stylesheet" />

    <style>

                .map-container {
                        width: 100%;
                        margin: 0 auto;
                        position: relative;
        }

                #map {
                        width: 100%;
                        height: 800px;
                        border-radius: 8px;
                        border: 1px solid #e0e0e0;
                        background: #fafafa;
        }

                .country {
                        stroke: #fff;
                        stroke-width: 1;
                        cursor: pointer;
                        transition: fill .3s, filter .3s;
        }

                    .country:hover {
                            filter: brightness(1.1);
        }

                    .country.disabled {
                            fill: rgba(200, 200, 200, 0.15) !important;
                            cursor: default;
                            pointer-events: none;
        }

        /* semitransparencias para cada país */
                    .country[data-name="ARGENTINA"] {
                            fill: rgba(26,188,156,0.5);
        }

                    .country[data-name="CHILE"] {
                            fill: rgba(52,152,219,0.5);
        }

                    .country[data-name="PERU"] {
                            fill: rgba(230,126,34,0.5);
        }

                    .country[data-name="COLOMBIA"] {
                            fill: rgba(155,89,182,0.5);
        }

                    .country[data-name="BRASIL"] {
                            fill: rgba(241,196,15,0.5);
        }

                    .country[data-name="MEXICO"] {
                            fill: rgba(192,57,43,0.5);
        }

                    .country[data-name="URUGUAY"] {
                            fill: rgba(22,160,133,0.5);
        }

                    .country[data-name="CHINA"] {
                            fill: rgba(127,140,141,0.5);
        }

        /* halo suave al país seleccionado */
                    .country.selected {
                            filter: drop-shadow(0 0 8px rgba(0,0,0,0.3)) brightness(1.1);
                            fill-opacity: 1 !important;
        }

        /* etiquetas claras y nítidas */
                #labels text {
                        font-family: 'Segoe UI', sans-serif;
                        font-size: 12px;
                        font-weight: 600;
                        fill: #2c3e50;
                        pointer-events: none;
                        text-shadow: 0 0 2px rgba(255,255,255,0.8);
        }

                .selected-country {
                        text-align: center;
                        font-weight: bold;
                        color: #5090c0;
                        margin-top: 10px;
        }


        /* Controles de zoom */
                .zoom-controls {
                        position: absolute;
                        top: 10px;
                        right: 10px;
                        background: white;
                        border-radius: 4px;
                        box-shadow: 0 1px 5px rgba(0,0,0,0.2);
                        z-index: 10;
        }

                .zoom-btn {
                        width: 30px;
                        height: 30px;
                        font-size: 16px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        cursor: pointer;
                        border: none;
                        background: white;
        }

                    .zoom-btn:hover {
                            background: #f0f0f0;
        }

                    .zoom-btn:first-child {
                            border-bottom: 1px solid #e0e0e0;
        }


    </style>
</head>
