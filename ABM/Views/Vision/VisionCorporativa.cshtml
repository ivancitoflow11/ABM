@using Newtonsoft.Json
@model VisionViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vision Corporativa</title>
    <link href="~/css/leaflet.css" rel="stylesheet" />

    <style>
        .map-container {
            width: 100%;
            margin: 0 auto;
        }

        #map {
            width: 100%;
            height: 400px;
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            background: #fafafa;
        }

        .country {
            stroke: #fff;
            stroke-width: 1;
            cursor: pointer;
            transition: fill .3s, filter .3s;
        }

            .country:hover {
                filter: brightness(1.1);
            }

            .country.disabled {
                fill: rgba(200, 200, 200, 0.15) !important;
                cursor: default;
                pointer-events: none;
            }

            /* semitransparencias para cada país */
            .country[data-name="ARGENTINA"] {
                fill: rgba(26,188,156,0.5);
            }

            .country[data-name="CHILE"] {
                fill: rgba(52,152,219,0.5);
            }

            .country[data-name="PERU"] {
                fill: rgba(230,126,34,0.5);
            }

            .country[data-name="COLOMBIA"] {
                fill: rgba(155,89,182,0.5);
            }

            .country[data-name="BRASIL"] {
                fill: rgba(241,196,15,0.5);
            }

            .country[data-name="MEXICO"] {
                fill: rgba(192,57,43,0.5);
            }

            .country[data-name="URUGUAY"] {
                fill: rgba(22,160,133,0.5);
            }

            .country[data-name="CHINA"] {
                fill: rgba(127,140,141,0.5);
            }

            /* halo suave al país seleccionado */
            .country.selected {
                filter: drop-shadow(0 0 8px rgba(0,0,0,0.3)) brightness(1.1);
                fill-opacity: 1 !important;
            }

        /* etiquetas claras y nítidas */
        #labels text {
            font-family: 'Segoe UI', sans-serif;
            font-size: 12px;
            font-weight: 600;
            fill: #2c3e50;
            pointer-events: none;
            text-shadow: 0 0 2px rgba(255,255,255,0.8);
        }

        .selected-country {
            text-align: center;
            font-weight: bold;
            color: #5090c0;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <br />
    <br />
    <br />
    <br />
    <h3 style="text-align:center">Visión corporativa</h3>

    <div class="map-container">
        <h5 style="text-align:center; font-family:'Segoe UI',sans-serif">Seleccione un País</h5>

        <svg viewBox="50 150 500 600" id="map">
            <!-- 1) Formas -->
            <g id="shapes">
                <path class="country" data-id="3" data-name="ARGENTINA" d="M300,500 L320,600 L280,700 L350,650 L370,550 L320,480 Z" />
                <path class="country" data-id="1" data-name="CHILE" d="M270,500 L300,500 L320,600 L280,700 L260,650 Z" />
                <path class="country" data-id="6" data-name="PERU" d="M220,380 L270,400 L300,450 L270,500 L240,470 L220,430 Z" />
                <path class="country" data-id="2" data-name="COLOMBIA" d="M220,330 L280,310 L310,350 L270,400 L220,380 Z" />
                <path class="country" data-id="11" data-name="BRASIL" d="M310,350 L400,350 L450,450 L370,550 L320,480 L300,450 L270,400 Z" />
                <path class="country" data-id="8" data-name="MEXICO" d="M100,200 L180,220 L160,280 L100,300 L80,250 Z" />
                <path class="country" data-id="10" data-name="URUGUAY" d="M350,580 L370,550 L390,570 L370,590 Z" />
                <path class="country" data-id="7" data-name="CHINA" d="M480,180 L520,180 L520,220 L480,220 Z" />
            </g>

            <!-- 2) Etiquetas encima -->
            <g id="labels">
                <text data-id="3" x="320" y="590">Argentina</text>
                <text data-id="1" x="265" y="620">Chile</text>
                <text data-id="6" x="245" y="430">Perú</text>
                <text data-id="2" x="250" y="340">Colombia</text>
                <text data-id="11" x="370" y="420">Brasil</text>
                <text data-id="8" x="130" y="240">México</text>
                <text data-id="10" x="370" y="580">Uruguay</text>
                <text data-id="7" x="500" y="205">China</text>
            </g>
        </svg>

        <div class="selected-country" id="selectedCountry">
            País seleccionado:
            @{
                var selPais = Model.ListaPaises.FirstOrDefault(x => x.IdPais == Model.SelectedPais);
                @((selPais?.NombrePais) ?? "Ninguno")
                ;
            }
        </div>

        <form asp-action="VisionCorporativa" method="get" id="countryForm">
            <input type="hidden" id="idPais" name="idPais" value="@Model.SelectedPais" />
        </form>
    </div>

    <div class="container mt-12" hidden>
        <div class="row mb-12">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        Filtrar Datos del Negocio por Fecha
                    </div>
                    <div class="card-body d-flex flex-column align-items-center">
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" id="datepicker-autoclose" placeholder="mm/dd/yyyy" style="text-align:center">
                            <span class="input-group-text">
                                <i class="ti ti-calendar fs-5"></i>
                            </span>
                        </div>
                        <button type="submit" class="btn btn-primary" style="width: 100px;">
                            Filtrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>




    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header text-white" style="background-color: #acd743;">
                    Mapa Riesgo ABM
                </div>
                <h1 style="text-align:center; margin-top:19px; font-size: 25px; font-family: 'Poppins', sans-serif; font-weight: normal; color: #85929e;">Riesgo Perfil</h1>




                <div class="card-body">
                    <!-- Aquí eliminé col-md-6 para que el gráfico ocupe el 100% -->
                    <div id="risk" style="height: 300px; width: 100%;background-image: url('/images/calor.png'); background-size: cover; background-position: center; height: 200px;">
                    </div>
                    <!-- Contenido para la gestión histórica -->
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-4" style="max-height: 450px; overflow-y: auto;">
                <div class="card-header text-white" style="background-color: #acd743;">
                    Resumen Sistema
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#sistema" role="tab">
                                <span>RIESGO SISTEMAS</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#pais" role="tab">
                                <span>RIESGO PAÍS</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#evolucion" role="tab">
                                <span>EVOLUCIÓN DÍA</span>
                            </a>
                        </li>
                    </ul>
                    <!-- Tab panes -->
                    <div class="tab-content">
                        <div class="tab-pane active p-3" id="sistema" role="tabpanel">
                            <p class="fw-semibold mb-3">Resultados a la última fecha de carga:</p>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th scope="col">Sistemas</th>
                                        <th scope="col">Finiquitados</th>
                                        <th scope="col">No Encontrados</th>
                                        <th scope="col">Activos</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ListaRiesgoSistema != null && Model.ListaRiesgoSistema.Any())
                                    {
                                        foreach (var item in Model.ListaRiesgoSistema)
                                        {
                                            <tr>
                                                <td>@item.Sistema</td>
                                                <td>@item.Finiquitados</td>
                                                <td>@item.NoEncontrados</td>
                                                <td>@item.Activos</td>
                                            </tr>
                                        }
                                    }

                                </tbody>
                            </table>
                        </div>
                        <div class="tab-pane p-3" id="pais" role="tabpanel">
                            <p class="fw-semibold mb-3">Resultados a la última fecha de carga:</p>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th scope="col">País</th>
                                        <th scope="col">Finiquitados</th>
                                        <th scope="col">No Encontrados</th>
                                        <th scope="col">Activos</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ListaRiesgoPais != null && Model.ListaRiesgoPais.Any())
                                    {
                                        @foreach (var item in Model.ListaRiesgoPais)
                                        {
                                            <tr>
                                                <td>@item.Pais</td>
                                                <td>@item.cnt_finiquitados</td>
                                                <td>@item.cnt_no_encontrados</td>
                                                <td>@item.cnt_activos</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="tab-pane p-3" id="evolucion" role="tabpanel">
                            <table id="tendenciasTable" class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th scope="col" onclick="sortTable()">Fecha Carga &#x25B2;&#x25BC;</th>
                                        <th scope="col">Finiquitados Últ. 60 días</th>
                                    </tr>
                                </thead>
                                <tbody id="tendenciasBody">
                                    @if (Model.ListaTendenciaDiaria != null && Model.ListaTendenciaDiaria.Any())
                                    {
                                        foreach (var item in Model.ListaTendenciaDiaria)
                                        {
                                            <tr>
                                                <td>@item.feccarga</td>
                                                <td>@item.cnt_finiquitados</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <br />

        <div class="row">
            <div class="col-md-12">
                <div class="card mb-4">
                    <div class="card-header text-white" style="background-color: #acd743;">
                        Gestión Historica
                    </div>
                    <div class="row mt-2 mx-2">
                        <div class="col-md-9"></div>
                        <div class="col-md-3" style="align-items:end">
                            <select class="form-select" id="sistemaSelect">
                                <option selected disabled>Seleccione Sistema</option>
                                @if (Model.ListaSistema != null && Model.ListaSistema.Any())
                                {
                                    @foreach (var item in Model.ListaSistema)
                                    {
                                        <option value="@item.idSistema">@item.sistema</option>
                                    }
                                }
                            </select>
                        </div>

                    </div>
                    <div class="row">
                        <div class="card-body col-md-6">
                            <div id="chartContainer" style="height: 300px; width: 100%;">
                            </div>
                            <!-- Contenido para la gestión histórica -->
                        </div>
                        <div class="card-body col-md-6">
                            <div id="chartContainer2" style="height: 300px; width: 100%;">
                            </div>
                            <!-- Contenido para la gestión histórica -->
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>


    @section scripts {
        <script src="/js/canvasjs-chart-3.10.9/canvasjs.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // 1) IDs válidos del modelo
                const validIds = @Html.Raw(
                JsonConvert.SerializeObject(
                Model.ListaPaises.Select(p => p.IdPais)
                )
                );

                const countries = document.querySelectorAll('#map .country');
                // 2) Inicial: resaltar el que ya trae la sesión
                const sel = Number(document.getElementById('idPais').value);
                if (sel) {
                    const init = document.querySelector(`.country[data-id="${sel}"]`);
                    if (init) init.classList.add('selected');
                }

                // 3) Recorremos todos y ocultamos etiquetas de los deshabilitados
                countries.forEach(country => {
                    const id = Number(country.dataset.id);
                    const label = document.querySelector(
                        `#map #labels text[data-id="${id}"]`
                    );

                    if (!validIds.includes(id)) {
                        country.classList.add('disabled');
                        if (label) label.remove();
                        return;
                    }

                    // 4) País válido → hacemos click para filtrar
                    country.addEventListener('click', () => {
                        // limpiamos previos
                        countries.forEach(c => c.classList.remove('selected'));
                        country.classList.add('selected');

                        // actualizamos texto y recargamos
                        const name = country.dataset.name;
                        document.getElementById('selectedCountry').textContent =
                            `País seleccionado: ${name}`;

                        // GET limpio
                        window.location.href =
                            '@Url.Action("VisionCorporativa", "Vision")?idPais=' + id;
                    });
                });
            });
        </script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // 1) Creo dataPoints intercambiando X <-> Y
                var dataPoints = [];
            @foreach (var item in Model.RiesgoPerfil)
            {
                @:dataPoints.push({ x: @item.Riesgo_Alto, y: @item.nriesgo, type: "Riesgo_Alto", sistema: "@item.Sistema" });
                @:dataPoints.push({ x: @item.Riesgo_Medio, y: @item.nriesgo, type: "Riesgo_Medio", sistema: "@item.Sistema" });
                @:dataPoints.push({ x: @item.Riesgo_Bajo, y: @item.nriesgo, type: "Riesgo_Bajo", sistema: "@item.Sistema" });
            }

                // 2) Calcular rangos dinámicos para ambos ejes
                var xs = dataPoints.map(function (dp) { return dp.x; });
                var ys = dataPoints.map(function (dp) { return dp.y; });

                var minX = Math.min.apply(null, xs) - 1;
                var maxX = Math.max.apply(null, xs) + 1;
                var minY = Math.min.apply(null, ys) - 1;
                var maxY = Math.max.apply(null, ys) + 1;

                // 3) Construir el gráfico con ejes intercambiados
                var chart = new CanvasJS.Chart("risk", {
                    backgroundColor: "rgba(255, 255, 255, 0.1)",
                    animationEnabled: true,
                    theme: "light2",

                    // Ahora el eje X muestra los conteos (Riesgos Alto/Medio/Bajo)
                    axisX: {
                        title: "Nivel de Riesgo",
                        titleFontFamily: "Poppins",
                        titleFontSize: 16,
                        titleFontWeight: "normal",
                        titleFontColor: "#000",
                        minimum: minX,
                        maximum: maxX,
                        interval: Math.ceil((maxX - minX) / 5),
                        labelAngle: -45,
                        labelFontSize: 12,
                        fontFamily: "Poppins",
                        fontColor: "#000",
                        gridThickness: 1,
                        gridColor: "rgba(0,0,0,0.5)",
                        lineColor: "#000",
                        lineThickness: 2
                    },

                    // Y el eje Y muestra ahora el nRiesgo (nivel de riesgo)
                    axisY: {
                        title: "N° Riesgo",
                        titleFontFamily: "Poppins",
                        titleFontSize: 16,
                        titleFontWeight: "bold",
                        titleFontColor: "#000",
                        minimum: minY,
                        maximum: maxY,
                        interval: Math.ceil((maxY - minY) / 5),
                        labelFontSize: 12,
                        fontFamily: "Poppins",
                        fontColor: "#000",
                        gridThickness: 1,
                        gridColor: "rgba(0,0,0,0.5)",
                        lineColor: "#000",
                        lineThickness: 2
                    },

                    data: [{
                        type: "scatter",
                        markerType: "circle",
                        markerSize: 15,
                        dataPoints: dataPoints,
                        toolTipContent: "<b>Sistema: {sistema}</b><br/>Nivel de Riesgo: {x}<br/>N°: {y}<br/>",
                        markerColor: function (dp) {
                            if (dp.type === "Riesgo_Alto") return "red";
                            if (dp.type === "Riesgo_Medio") return "orange";
                            return "green";
                        }
                    }]
                });

                chart.render();
            });
        </script>



        <script type="text/javascript">
            function convertToDate(fechaString) {
                var fechaParts = fechaString.split('-');
                return new Date(fechaParts[2], fechaParts[1] - 1, fechaParts[0]);
            }
            function sortTable() {
                var tbody = document.getElementById("tendenciasBody");
                var rows = Array.from(tbody.querySelectorAll("tr"));

                rows.sort(function (rowA, rowB) {
                    var dateA = convertToDate(rowA.cells[0].innerText);
                    var dateB = convertToDate(rowB.cells[0].innerText);
                    return dateB - dateA;
                });

                tbody.innerHTML = "";
                rows.forEach(function (row) {
                    tbody.appendChild(row);
                });
            }

            window.onload = function () {
                sortTable();
            };
        </script>


        <script type="text/javascript">
            document.getElementById('sistemaSelect')
                .addEventListener('change', function () {
                    var sistema = parseInt(this.value);
                    var idPais = @Model.SelectedPais;  

                    fetch(`@Url.Action("ObtenerGraficoDinamico", "Vision")?sistema=${sistema}&idPais=${idPais}`)
                        .then(resp => resp.json())
                        .then(data => renderizarGrafico(data));
                });

            function renderizarGrafico(data) {
                var chart = new CanvasJS.Chart("chartContainer2", {
                    animationEnabled: true,
                    title: {
                        text: "Tendencia Finiquitados por Sistema",
                        fontFamily: "Poppins",
                        fontSize: 25,
                        fontWeight: "normal",
                        fontColor: "#808080"
                    },
                    axisY: {
                        title: "Cantidad Finiquitados",
                        valueFormatString: "#,##0",
                        stripLines: [{
                            value: 0
                        }]
                    },
                    axisX: {
                        valueFormatString: "DD-MM-YYYY",
                        labelAngle: -45
                    },
                    data: [{
                        type: "column",
                        xValueFormatString: "DD-MM-YYYY",
                        yValueFormatString: "#,##0",
                        dataPoints: data.map(item => {
                            // Asumiendo que feccarga viene en formato 'YYYY-MM-DD'
                            const [year, month, day] = item.feccarga.split('-');
                            return {
                                x: new Date(year, month - 1, day),
                                y: item.cantidad_finiquitados || 0
                            };
                        })
                    }]
                });
                chart.render();
            }


        </script>
        <script type="text/javascript">
            window.onload = function () {
                var chart = new CanvasJS.Chart("chartContainer", {
                    title: {
                        text: "Tendencia Finiquitados",
                        fontFamily: "Poppins",
                        fontSize: 25,
                        fontWeight: "normal",
                        fontColor: "#808080",
                    },
                    axisY: {
                        title: "Cantidad Finiquitados",
                        valueFormatString: "#,###"
                    },
                    axisX: {
                        labelAngle: -45,
                        valueFormatString: "DD-MM-YYYY"
                    },
                    data: [{
                        type: "line",
                        yValueFormatString: "#,##0",
                        dataPoints: [
            @if (Model.ListaTendenciaDiaria != null && Model.ListaTendenciaDiaria.Any())
            {
                @foreach (var item in Model.ListaTendenciaDiaria)
                {
                    @:{ x: new Date("@item.feccarga"), y: @item.cnt_finiquitados },
                }
            }
                        ],
                    }]
                });

                chart.render();
            }
        </script>
    }


</body>
</html>
