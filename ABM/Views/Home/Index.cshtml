@model ABM.Models.HomeViewModel 
@{
    ViewData["Title"] = "Panel de Inicio"; 
}


<style>
    :root {
        --font-family-base: 'Poppins', 'Segoe UI', sans-serif;
        --primary-color: #005be6;
        --secondary-color: #aad500; 
        --accent-color-1: #007bff; 
        --accent-color-2: #c0e75a; 

        --text-color-dark: #2c3e50; /* Azul oscuro para texto principal */
        --text-color-medium: #566573; /* Gris medio para texto secundario */
        --text-color-light: #85929e; /* Gris claro para etiquetas */

        --bg-light: #f8f9fa; /* Fondo general muy claro */
        --bg-card: #ffffff; /* Fondo de las tarjetas */

        --border-radius-md: 12px;
        --border-radius-lg: 20px;
        --box-shadow-soft: 0 8px 25px rgba(0, 0, 0, 0.07);
        --box-shadow-lifted: 0 12px 35px rgba(0, 0, 0, 0.1);
    }

    body { 
        font-family: var(--font-family-base);
        background-color: var(--bg-light); 
    }

    .modern-dashboard-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start; 
        padding: 30px 20px; 
        box-sizing: border-box;
        margin-top:50px;
    }

    .dashboard-content-wrapper {
        width: 100%;
        max-width: 1200px; 
        background: rgba(255, 255, 255, 0.85); 
        backdrop-filter: blur(15px) saturate(180%);
        -webkit-backdrop-filter: blur(15px) saturate(180%); 
        border: 1px solid rgba(209, 213, 219, 0.4); 
        border-radius: var(--border-radius-lg);
        padding: 35px 45px;
        box-shadow: var(--box-shadow-lifted);
        color: var(--text-color-dark);
    }

    /* Header Section */
    .profile-header-section {
        display: flex;
        align-items: center;
        margin-bottom: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid rgba(0,0,0,0.08);
    }

    .profile-avatar-lg {
        font-size: 3.8rem;
        color: var(--primary-color);
        margin-right: 25px;
        background-color: color-mix(in srgb, var(--primary-color) 15%, transparent);
        border-radius: 50%;
        width: 90px;
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0, 91, 230, 0.15);
    }

        .profile-avatar-lg i { /* Para ajustar el tamaño del icono dentro del círculo */
            transform: scale(0.9);
        }

    .greeting-text h1 {
        font-size: 2.6rem;
        font-weight: 600;
        margin: 0 0 4px 0;
        color: var(--text-color-dark);
    }

    .greeting-text h2.username {
        font-size: 1.8rem;
        font-weight: 400;
        color: var(--primary-color); /* Nombre de usuario en color primario */
        margin: 0;
    }

    /* Metrics Grid Section */
    .metrics-grid-section h3.section-title,
    .actions-section h3.section-title {
        font-size: 1.6rem;
        font-weight: 600;
        color: var(--text-color-dark);
        margin-bottom: 25px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--primary-color);
        display: inline-block; /* Para que el borde solo ocupe el ancho del texto */
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); /* Más flexible */
        gap: 25px;
        margin-bottom: 40px;
    }

    .metric-card {
        background-color: var(--bg-card);
        border-radius: var(--border-radius-md);
        padding: 25px;
        box-shadow: var(--box-shadow-soft);
        display: flex;
        align-items: center;
        gap: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-left: 5px solid transparent; /* Para acento de color */
    }

        .metric-card:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: var(--box-shadow-lifted);
        }

        .metric-card .metric-icon {
            font-size: 2rem;
            width: 55px;
            height: 55px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            flex-shrink: 0; /* Evita que el icono se encoja */
        }
        /* Aplicar colores específicos a iconos y borde izquierdo */
        .metric-card.email {
            border-left-color: #d9534f;
        }

            .metric-card.email .metric-icon {
                background-color: #d9534f;
            }

        .metric-card.role {
            border-left-color: #5cb85c;
        }

            .metric-card.role .metric-icon {
                background-color: #5cb85c;
            }

        .metric-card.access {
            border-left-color: #f0ad4e;
        }

            .metric-card.access .metric-icon {
                background-color: #f0ad4e;
            }

        .metric-card.country {
            border-left-color: var(--secondary-color);
        }
            /* Usando color Falabella */
            .metric-card.country .metric-icon {
                background-color: var(--secondary-color);
            }

        .metric-card.business {
            border-left-color: var(--accent-color-1);
        }
            /* Usando acento azul */
            .metric-card.business .metric-icon {
                background-color: var(--accent-color-1);
            }


    .metric-info .label {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-color-light);
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .metric-info .value {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--text-color-dark);
        word-break: break-all; /* Para valores largos como correos */
    }

    /* Actions Section */
    .actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .action-tile {
        background-color: var(--bg-card);
        border-radius: var(--border-radius-md);
        padding: 20px;
        text-align: center;
        text-decoration: none;
        color: var(--text-color-medium);
        box-shadow: var(--box-shadow-soft);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 130px; /* Altura mínima para consistencia */
    }

        .action-tile:hover {
            transform: translateY(-5px) scale(1.03);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            color: var(--primary-color);
        }

        .action-tile .action-icon {
            font-size: 2.2rem;
            margin-bottom: 12px;
            color: var(--primary-color);
            transition: color 0.3s ease;
        }

        .action-tile:hover .action-icon {
            color: var(--accent-color-1); /* Cambio de color del icono en hover */
        }

        .action-tile .action-label {
            font-size: 1rem;
            font-weight: 500;
        }

    /* Footer */
    .dashboard-footer {
        text-align: center;
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid rgba(0,0,0,0.08);
        font-size: 0.9rem;
        color: var(--text-color-light);
    }

        .dashboard-footer .abm {
            color: var(--primary-color);
            font-weight: 600;
        }

        .dashboard-footer .falabella {
            color: var(--secondary-color);
            font-weight: 600;
        }

    /* Login Prompt Card (para usuarios no autenticados) */
    .login-prompt-wrapper { /* Similar al dashboard-content-wrapper pero centrado */
        width: 100%;
        max-width: 600px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(15px) saturate(180%);
        -webkit-backdrop-filter: blur(15px) saturate(180%);
        border: 1px solid rgba(209, 213, 219, 0.4);
        border-radius: var(--border-radius-lg);
        padding: 40px 50px;
        box-shadow: var(--box-shadow-lifted);
        text-align: center;
        color: var(--text-color-dark);
        margin-top: 50px; /* Para centrarlo un poco más si la página es corta */
    }

        .login-prompt-wrapper h1 {
            font-size: 2.4rem;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .login-prompt-wrapper .brand-text-login {
            font-size: 2rem;
            font-weight: 600;
            margin-bottom: 25px;
        }

            .login-prompt-wrapper .brand-text-login .abm {
                color: var(--primary-color);
            }

            .login-prompt-wrapper .brand-text-login .falabella {
                color: var(--secondary-color);
            }

        .login-prompt-wrapper p {
            font-size: 1.1rem;
            color: var(--text-color-medium);
            line-height: 1.6;
        }

</style>

<div class="modern-dashboard-container">
    @if (Model.IsAuthenticated && Model.NombreCompleto != null)
    {
        <div class="dashboard-content-wrapper">
            <section class="profile-header-section">
                <div class="profile-avatar-lg">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div class="greeting-text">
                    <h1>Hola de nuevo,</h1>
                    <h2 class="username">@Model.NombreCompleto</h2>
                </div>
            </section>

            <section class="metrics-grid-section">
                <h3 class="section-title">Tu Información</h3>
                <div class="metrics-grid">
                    @if (!string.IsNullOrEmpty(Model.Correo))
                    {
                        <div class="metric-card email">
                            <div class="metric-icon"><i class="fas fa-envelope"></i></div>
                            <div class="metric-info">
                                <p class="label">Correo Electrónico</p>
                                <p class="value">@Model.Correo</p>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.RolNombre))
                    {
                        <div class="metric-card role">
                            <div class="metric-icon"><i class="fas fa-user-tag"></i></div>
                            <div class="metric-info">
                                <p class="label">Rol Asignado</p>
                                <p class="value">@Model.RolNombre</p>
                            </div>
                        </div>
                    }
                    @if (Model.UltimoAcceso.HasValue)
                    {
                        <div class="metric-card access">
                            <div class="metric-icon"><i class="fas fa-history"></i></div>
                            <div class="metric-info">
                                <p class="label">Último Acceso</p>
                                <p class="value">@Model.UltimoAcceso.Value.ToString("dd MMM yyyy, HH:mm")</p> 
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Pais))
                    {
                        <div class="metric-card country">
                            <div class="metric-icon"><i class="fas fa-map-marker-alt"></i></div>
                            <div class="metric-info">
                                <p class="label">País</p>
                                <p class="value">@Model.Pais</p>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Negocio))
                    {
                        <div class="metric-card business">
                            <div class="metric-icon"><i class="fas fa-briefcase"></i></div>
                            <div class="metric-info">
                                <p class="label">Negocio</p>
                                <p class="value">@Model.Negocio</p>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="actions-section">
                <h3 class="section-title">Accesos Directos</h3>
                <div class="actions-grid">
                    <a href="@Url.Action("Salir", "Home")" class="action-tile">
                        <div class="action-icon"><i class="fa-solid fa-right-from-bracket"></i></div>
                        <span class="action-label">Cerrar sesión</span>
                    </a>
                    @* <a href="" class="action-tile">
                        <div class="action-icon"><i class="fas fa-file-alt"></i></div>
                        <span class="action-label">Mis Documentos</span>
                    </a>
                    <a href="" class="action-tile">
                        <div class="action-icon"><i class="fas fa-chart-pie"></i></div>
                        <span class="action-label">Ver Estadísticas</span>
                    </a> *@
                    <a href="" class="action-tile">
                        <div class="action-icon"><i class="fas fa-life-ring"></i></div>
                        <span class="action-label">Soporte Técnico</span>
                    </a>
                </div>
            </section>

            <footer class="dashboard-footer">
                <span class="abm">ABM</span> <span class="falabella">FALABELLA</span> &copy; @DateTime.Now.Year
            </footer>
        </div>
    }
    else
    {
        <div class="login-prompt-wrapper">
            <h1>Bienvenido al Portal</h1>
            <div class="brand-text-login">
                <span class="abm">ABM</span> <span class="falabella">FALABELLA</span>
            </div>
            <p>
                Para acceder a tu panel personalizado y todas las funcionalidades del sistema, por favor, inicia sesión.
            </p>

        </div>
    }
</div>

@section Scripts {
    <script src="~/js/sweetalert/sweetalert.min.js"></script>
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'success',
                    title: '@Html.Raw(TempData["SuccessMessage"])',
                    toast: true, 
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                        });
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'error',
                    title: '@Html.Raw(TempData["ErrorMessage"])',
                    showConfirmButton: true
                        });
            </text>
        }
    </script>
}