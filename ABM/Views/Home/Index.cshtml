@using System.Security.Claims;
@using Microsoft.AspNetCore.Http;
@{
    ViewData["Title"] = "Inicio";
    string pais = Context.Session.GetString("Pais");
    string negocio = Context.Session.GetString("Negocio");
}

<div style="min-height: 100vh; display: flex; justify-content: center; align-items: center; text-align: center; font-family: 'Segoe UI', sans-serif;">
    @if (User.Identity!.IsAuthenticated)
    {
        <div style="backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.9); border: 1px solid rgba(170, 213, 0, 0.6); border-radius: 20px; padding: 40px; max-width: 600px; width: 90%; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);">
            <h1 style="font-size: 2.8rem; color: #3a3a3a; font-weight: bold;">Bienvenido(a),</h1>
            <h2 style="font-size: 1.8rem; color: #4a4a4a; margin: 10px 0;">
                @User.Claims.Where(c => c.Type == ClaimTypes.Name).Select(c => c.Value).SingleOrDefault()
            </h2>

            @if (!string.IsNullOrEmpty(pais) && !string.IsNullOrEmpty(negocio))
            {
                <div style="font-size: 1.3rem; color: #4a4a4a; margin: 15px 0; padding: 10px;">
                    <div style="display: flex; justify-content: center; align-items: center; gap: 8px;">
                        <i class="fas fa-globe" style="color: #7ac143;"></i>
                        <span>@pais</span>
                    </div>
                    <div style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 5px;">
                        <i class="fas fa-building" style="color: #5bc0ff;"></i>
                        <span>@negocio</span>
                    </div>
                </div>
            }

            <p style="font-size: 1.2rem; margin-top: 20px; font-weight: bold;">
                <span style="color: #005be6;">ABM</span>
                <span style="color: #aad500;"> FALABELLA</span>
            </p>
        </div>
    }
    else
    {
        <div style="backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.9); border: 1px solid rgba(170, 213, 0, 0.6); border-radius: 20px; padding: 40px; max-width: 600px; width: 90%; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);">
            <h1 style="font-size: 2.8rem; color: #3a3a3a; font-weight: bold;">Bienvenido a</h1>
            <h2 style="font-size: 2.3rem; color: #4a4a4a; font-weight: bold; margin-bottom: 20px;">
                <span style="color: #005be6;">ABM</span>
                <span style="color: #aad500;"> FALABELLA</span>
            </h2>
            <p style="font-size: 1.2rem; color: #666;">
                Por favor, inicia sesión para acceder a todas las funcionalidades del sistema.
            </p>
        </div>
    }
</div>