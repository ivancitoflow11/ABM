@model IEnumerable<ABM.Models.Rol>

<h1>Lista de Roles</h1>

<div class="container">
    <div class="row">
        @foreach (var rol in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@rol.nombre</h5>
                        <a asp-controller="Home"
                           asp-action="EditarPermisos"
                           asp-route-idRol="@rol.idRol"
                           class="btn btn-primary">
                            Editar Permisos
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
