@model IEnumerable<ABM.Models.SapUser>

<form method="get" asp-action="BuscadorPasoSap" class="row g-3 align-items-end" id="form-buscador-paso-sap">
    <div class="col-md-3">
        <label for="rutODni" class="form-label">RUT o DNI</label>
        <input type="text" id="rutODni" name="rutODni" class="form-control" placeholder="Ingrese RUT o DNI" value="@(ViewBag.RutODni ?? string.Empty)" />
    </div>
    <div class="col-auto d-flex align-items-center">
        <span class="fw-bold mx-2">O</span>
    </div>
    <div class="col-md-3">
        <label for="nombreCompleto" class="form-label">Nombre Completo</label>
        <input type="text" id="nombreCompleto" name="nombreCompleto" class="form-control" placeholder="Ingrese nombre completo" value="@(ViewBag.NombreCompleto ?? string.Empty)" />
    </div>
    <div class="col-auto d-flex align-items-center">
        <span class="fw-bold mx-2">O</span>
    </div>
    <div class="col-md-3">
        <label for="correoUsuario" class="form-label">Correo</label>
        <input type="text" id="correoUsuario" name="correoUsuario" class="form-control" placeholder="Ingrese correo" value="@(ViewBag.CorreoUsuario ?? string.Empty)" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-success">Buscar</button>
    </div>
</form>

<div class="mt-4">
    <div class="card">
        <div class="card-header text-white" style="background-color: #198754;">Resultados de Paso SAP</div>
        <div class="card-body table-responsive">
            <table class="table table-striped table-bordered nowrap datatable-export" style="width:100%; text-align:center;">
                <thead>
                    <tr>
                        <th>RUT/DNI</th>
                        <th>Nombre Completo</th>
                        <th>Correo</th>
                        <th>Cargo</th>
                        <th>Sistema</th>
                        <th>Negocio</th>
                        <th>País</th>
                        <th>Último Login</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RutODni == null && ViewBag.NombreCompleto == null && ViewBag.CorreoUsuario == null)
                    {
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td class="text-muted">Ingrese un criterio para iniciar la búsqueda.</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                    else if (!Model.Any())
                    {
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td class="text-muted">No se encontraron registros.</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td style="white-space:nowrap;">@($"{user.RutODni}-{user.DigVerif}")</td>
                                <td style="white-space:nowrap;">@(user.NombreCompleto ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.CorreoUsuario ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.Cargo ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.Sistema ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.Negocio ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.Pais ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.FechaUltimoLogin ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>