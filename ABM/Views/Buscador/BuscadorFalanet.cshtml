@model IEnumerable<ABM.Models.ActivosFalanetUser>

<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />

<div class="pt-5">
    <h4 class="mt-5">Buscador de Activos Falanet</h4>

    <div class="row mb-4 ms-5">
        <form method="get" asp-action="BuscadorFalanet" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="rut" class="form-label">RUT</label>
                <input type="text"
                       id="rut"
                       name="rut"
                       class="form-control"
                       placeholder="Ingrese RUT"
                       value="@(ViewBag.Rut ?? string.Empty)" />
            </div>
            <div class="col-auto d-flex align-items-center">
                <span class="fw-bold mx-2">O</span>
            </div>
            <div class="col-md-3">
                <label for="apePaterno" class="form-label">Apellido Paterno</label>
                <input type="text"
                       id="apePaterno"
                       name="apePaterno"
                       class="form-control"
                       placeholder="Ingrese Apellido"
                       value="@(ViewBag.ApePaterno ?? string.Empty)" />
            </div>
            <div class="col-auto d-flex align-items-center">
                <span class="fw-bold mx-2">O</span>
            </div>
            <div class="col-md-3">
                <label for="correo" class="form-label">Correo</label>
                <input type="text"
                       id="correo"
                       name="correo"
                       class="form-control"
                       placeholder="Ingrese Correo"
                       value="@(ViewBag.Correo ?? string.Empty)" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-success">Buscar</button>
            </div>
        </form>
    </div>

    <div class="mt-4">
        <div class="row">
            <div class="col-12">
                <div class="card mb-4">
                    <div class="card-header text-white" style="background-color: #007bff;">
                        Resultados
                    </div>
                    <div class="card-body table-responsive">
                        <table id="file_export_falanet"
                               class="table table-striped table-bordered nowrap"
                               style="width:100%; text-align:center; table-layout:auto;">
                            <thead>
                                <tr>
                                    <th>RUT</th>
                                    <th>Nombre Completo</th>
                                    <th>Correo</th>
                                    <th>Cargo</th>
                                    <th>Empresa</th>
                                    <th>Cta. Usuario</th>
                                    <th>País</th>
                                    <th>CCOSTO</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (string.IsNullOrWhiteSpace(ViewBag.Rut as string) &&
                                                                string.IsNullOrWhiteSpace(ViewBag.ApePaterno as string) &&
                                                                string.IsNullOrWhiteSpace(ViewBag.Correo as string))
                                {
                                    <tr>
                                        <td colspan="8">Ingrese un criterio de búsqueda y presione "Buscar"</td>
                                    </tr>
                                }
                                else if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="8">No se encontraron registros para los criterios ingresados.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var user in Model)
                                    {
                                        <tr>
                                            <td style="white-space:nowrap;">@($"{user.RUT}-{user.D_VERIFICADOR}")</td>
                                            <td style="white-space:nowrap;">@($"{user.NOMBRES} {user.APEPATERNO} {user.APEMATERNO}")</td>
                                            <td style="white-space:nowrap;">@(user.CORREO ?? "-")</td>
                                            <td style="white-space:nowrap;">@(user.NOMCARGO ?? "-")</td>
                                            <td style="white-space:nowrap;">@(user.NOMEMPRESA ?? "-")</td>
                                            <td style="white-space:nowrap;">@(user.CTAUSUARIO ?? "-")</td>
                                            <td style="white-space:nowrap;">@(user.PAÍS ?? "-")</td>
                                            <td style="white-space:nowrap;">@(user.CCOSTO ?? "-")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/vendor.min.js"></script>
    <script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="/js/dataTables.buttons.min.js"></script>
    <script src="/js/jszip.min.js"></script>
    <script src="/js/pdfmake.min.js"></script>
    <script src="/js/vfs_fonts.js"></script>
    <script src="/js/buttons.html5.min.js"></script>
    <script src="/js/buttons.print.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#file_export_falanet').DataTable({
                dom: 'Bfrtip',
                buttons: ['copy', 'excel', 'pdf', 'print']
            });
        });
    </script>
}