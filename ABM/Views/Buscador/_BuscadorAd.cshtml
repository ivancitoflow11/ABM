@model IEnumerable<ABM.Models.AdUser>

<form method="get" asp-action="BuscadorAd" class="row g-3 align-items-end" id="form-buscador-ad">
    <div class="col-md-3">
        <label for="employeeId" class="form-label">Employee ID o (RUT)</label>
        <input type="text" id="employeeId" name="employeeId" class="form-control" placeholder="Ingrese Employee ID" value="@(ViewBag.EmployeeId ?? String.Empty)" />
    </div>
    <div class="col-auto d-flex align-items-center">
        <span class="fw-bold mx-2">O</span>
    </div>
    <div class="col-md-3">
        <label for="displayName" class="form-label">Nombre (cn)</label>
        <input type="text" id="displayName" name="displayName" class="form-control" placeholder="Ingrese Nombre" value="@(ViewBag.DisplayName ?? String.Empty)" />
    </div>
    <div class="col-auto d-flex align-items-center">
        <span class="fw-bold mx-2">O</span>
    </div>
    <div class="col-md-3">
        <label for="mail" class="form-label">Correo</label>
        <input type="text" id="mail" name="mail" class="form-control" placeholder="Ingrese Correo" value="@(ViewBag.Mail ?? String.Empty)" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-success">Buscar</button>
    </div>
</form>

<div class="mt-4">
    <div class="card">
        <div class="card-header text-white" style="background-color: #007bff;">Resultados</div>
        <div class="card-body table-responsive">
            <table class="table table-striped table-bordered nowrap datatable-export" style="width:100%; text-align:center;">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Employee ID</th>
                        <th>Usuario Login</th>
                        <th>Cargo</th>
                        <th>Departamento</th>
                        <th>Compañía</th>
                        <th>País</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.EmployeeId == null && ViewBag.DisplayName == null && ViewBag.Mail == null)
                    {
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td class="text-muted">Ingrese un criterio para iniciar la búsqueda.</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                    else if (!Model.Any())
                    {
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td class="text-muted">No se encontraron registros.</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td style="white-space:nowrap;">@(user.DisplayName ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.Mail ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.EmployeeID ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.SAMAccountName ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.Title ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.Department ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.Company ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.C ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>