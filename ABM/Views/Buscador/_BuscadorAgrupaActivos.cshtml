@model IEnumerable<ABM.Models.AgrupaActivosUser>

<form method="get" asp-action="BuscadorAgrupaActivos" class="row g-3 align-items-end" id="form-buscador-agrupa-activos">
    <div class="col-md-3">
        <label for="rutDni" class="form-label">RUT</label>
        <input type="text" id="rutDni" name="rutDni" class="form-control" placeholder="Ingrese RUT" value="@(ViewBag.RutDni ?? string.Empty)" />
    </div>
    <div class="col-auto d-flex align-items-center">
        <span class="fw-bold mx-2">O</span>
    </div>
    <div class="col-md-3">
        <label for="nombreUsuario" class="form-label">Nombre de Usuario</label>
        <input type="text" id="nombreUsuario" name="nombreUsuario" class="form-control" placeholder="Ingrese nombre" value="@(ViewBag.NombreUsuario ?? string.Empty)" />
    </div>
    <div class="col-auto d-flex align-items-center">
        <span class="fw-bold mx-2">O</span>
    </div>
    <div class="col-md-3">
        <label for="mailUsuario" class="form-label">Correo</label>
        <input type="text" id="mailUsuario" name="mailUsuario" class="form-control" placeholder="Ingrese correo" value="@(ViewBag.MailUsuario ?? string.Empty)" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-success">Buscar</button>
    </div>
</form>

<div class="mt-4">
    <div class="card">
        <div class="card-header text-white" style="background-color: #6c757d;">Resultados de Agrupa Activos</div>
        <div class="card-body table-responsive">
            <table class="table table-striped table-bordered nowrap datatable-export" style="width:100%; text-align:center;">
                <thead>
                    <tr>
                        <th>RUT</th>
                        <th>Nombre Usuario</th>
                        <th>Correo</th>
                        <th>Cargo</th>
                        <th>Empresa</th>
                        <th>Último Login</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RutDni == null && ViewBag.NombreUsuario == null && ViewBag.MailUsuario == null)
                    {
                        <tr>
                            <td></td>
                            <td></td>
                            <td class="text-muted">Ingrese un criterio para iniciar la búsqueda.</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                    else if (!Model.Any())
                    {
                        <tr>
                            <td></td>
                            <td></td>
                            <td class="text-muted">No se encontraron registros.</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td style="white-space:nowrap;">@($"{user.RutDni}-{user.Dv}")</td>
                                <td style="white-space:nowrap;">@(user.NombreUsuario ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.MailUsuario ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.CargoSpr ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.Empresa ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.FecUltLogin ?? "-")</td>
                                <td style="white-space:nowrap;">
                                    <span class="badge @(user.Estado == "ACTIVO" ? "bg-success" : "bg-danger")">
                                        @(user.Estado ?? "-")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>