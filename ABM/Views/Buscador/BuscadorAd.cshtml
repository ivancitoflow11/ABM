@model IEnumerable<ABM.Models.AdUser>
@using System

<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />

<div class="pt-5">
    <h4 class="mt-5">Buscador de Usuarios (Active Directory)</h4>

    <div class="row mb-4 ms-5">
        <form method="get" asp-action="BuscadorAd" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="employeeId" class="form-label">Employee ID o (RUT)</label>
                <input type="text"
                       id="employeeId"
                       name="employeeId"
                       class="form-control"
                       placeholder="Ingrese Employee ID"
                       value="@(ViewBag.EmployeeId ?? String.Empty)" />
            </div>
            <div class="col-auto d-flex align-items-center">
                <span class="fw-bold mx-2">O</span>
            </div>
            <div class="col-md-3">
                <label for="displayName" class="form-label">Nombre (cn)</label>
                <input type="text"
                       id="displayName"
                       name="displayName"
                       class="form-control"
                       placeholder="Ingrese Nombre"
                       value="@(ViewBag.DisplayName ?? String.Empty)" />
            </div>
            <div class="col-auto d-flex align-items-center">
                <span class="fw-bold mx-2">O</span>
            </div>
            <div class="col-md-3">
                <label for="mail" class="form-label">Correo</label>
                <input type="text"
                       id="mail"
                       name="mail"
                       class="form-control"
                       placeholder="Ingrese Correo"
                       value="@(ViewBag.Mail ?? String.Empty)" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-success">Buscar</button>
            </div>
        </form>
    </div>

    <div class="mt-4">
        <div class="row">
            <div class="col-12">
                <div class="card mb-4">
                    <div class="card-header text-white" style="background-color: #007bff;">
                        Resultados
                    </div>
                    <div class="card-body table-responsive">
                        <table id="file_export_ad"
                               class="table table-striped table-bordered nowrap"
                               style="width:100%; text-align:center; table-layout:auto;">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Correo</th>
                                    <th>Employee ID</th>
                                    <th>Usuario Login</th>
                                    <th>Cargo</th>
                                    <th>Departamento</th>
                                    <th>Compañía</th>
                                    <th>País</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (string.IsNullOrWhiteSpace(ViewBag.EmployeeId as string) &&
                                                                string.IsNullOrWhiteSpace(ViewBag.DisplayName as string) &&
                                                                string.IsNullOrWhiteSpace(ViewBag.Mail as string))
                                {
                                    <tr>
                                        <td colspan="8">Ingrese un criterio de búsqueda y presione "Buscar"</td>
                                    </tr>
                                }
                                else if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="9">No se encontraron registros para los criterios ingresados.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var user in Model)
                                    {
                                        <tr>
                                            <td style="white-space:nowrap;">@(user.DisplayName ?? "-")</td>
                                            <td style="white-space:nowrap;">@(user.Mail ?? "-")</td>
                                            <td style="white-space:nowrap;">@(user.EmployeeID ?? "-")</td>
                                            <td style="white-space:nowrap;">@(user.SAMAccountName ?? "-")</td>
                                            <td style="white-space:nowrap;">@(user.Title ?? "-")</td>
                                            <td style="white-space:nowrap;">@(user.Department ?? "-")</td>
                                            <td style="white-space:nowrap;">@(user.Company ?? "-")</td>
                                            <td style="white-space:nowrap;">@(user.C ?? "-")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Nombre (DisplayName)</th>
                                    <th>Correo</th>
                                    <th>Employee ID</th>
                                    <th>Usuario Login</th>
                                    <th>Cargo</th>
                                    <th>Departamento</th>
                                    <th>Compañía</th>
                                    <th>País</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/vendor.min.js"></script>
    <script src="/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="/js/dataTables.buttons.min.js"></script>
    <script src="/js/jszip.min.js"></script>
    <script src="/js/pdfmake.min.js"></script>
    <script src="/js/vfs_fonts.js"></script>
    <script src="/js/buttons.html5.min.js"></script>
    <script src="/js/buttons.print.min.js"></script>
    <script>
        // Inicializamos DataTable en la nueva tabla
        $(document).ready(function () {
            $('#file_export_ad').DataTable({
                dom: 'Bfrtip',
                buttons: ['copy', 'excel', 'pdf', 'print']
            });
        });
    </script>
}