@model IEnumerable<ABM.Models.ActivosFalanetUser>

<form method="get" asp-action="BuscadorFalanet" class="row g-3 align-items-end" id="form-buscador-falanet">
    <div class="col-md-3">
        <label for="rut" class="form-label">RUT</label>
        <input type="text" id="rut" name="rut" class="form-control" placeholder="Ingrese RUT" value="@(ViewBag.Rut ?? string.Empty)" />
    </div>
    <div class="col-auto d-flex align-items-center">
        <span class="fw-bold mx-2">O</span>
    </div>
    <div class="col-md-3">

        <label for="nombreCompleto" class="form-label">Nombre Completo</label>
        <input type="text" id="nombreCompleto" name="nombreCompleto" class="form-control" placeholder="Ingrese Nombre" value="@(ViewBag.NombreCompleto ?? string.Empty)" />
    </div>
    <div class="col-auto d-flex align-items-center">
        <span class="fw-bold mx-2">O</span>
    </div>
    <div class="col-md-3">
        <label for="correo" class="form-label">Correo</label>
        <input type="text" id="correo" name="correo" class="form-control" placeholder="Ingrese Correo" value="@(ViewBag.Correo ?? string.Empty)" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-success">Buscar</button>
    </div>
</form>

<div class="mt-4">
    <div class="card">
        <div class="card-header text-white" style="background-color: #007bff;">Resultados</div>
        <div class="card-body table-responsive">
            <table class="table table-striped table-bordered nowrap datatable-export" style="width:100%; text-align:center;">
                <thead>
                    <tr>
                        <th>RUT</th>
                        <th>Nombre Completo</th>
                        <th>Correo</th>
                        <th>Cargo</th>
                        <th>Empresa</th>
                        <th>Cta. Usuario</th>
                        <th>País</th>
                        <th>CCOSTO</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.Rut == null && ViewBag.NombreCompleto == null && ViewBag.Correo == null)
                    {
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td class="text-muted">Ingrese un criterio para iniciar la búsqueda.</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                    else if (!Model.Any())
                    {
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td class="text-muted">No se encontraron registros.</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td style="white-space:nowrap;">@($"{user.RUT}-{user.D_VERIFICADOR}")</td>
                                @* CAMBIO: Ahora usamos la propiedad unificada *@
                                <td style="white-space:nowrap;">@(user.NombreCompleto ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.CORREO ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.NOMCARGO ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.NOMEMPRESA ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.CTAUSUARIO ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.PAÍS ?? "-")</td>
                                <td style="white-space:nowrap;">@(user.CCOSTO ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>