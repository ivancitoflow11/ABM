@model IEnumerable<ABM.Models.MatrizActivo>

@{
    ViewData["Title"] = $"Matriz de Datos para {@ViewData["Pais"]} - {@ViewData["Sistema"]}";
}

<div class="container-fluid pt-5">
    <h1 class="my-4">@ViewData["Title"]</h1>

    <p>
        <a asp-action="Index" class="btn btn-secondary mb-3">
            &larr; Volver a la lista de matrices
        </a>
    </p>

    <div class="card">
        <div class="card-header text-white" style="background-color: #b0d404;">
            Listado de Activos en Matriz
        </div>
        <div class="card-body table-responsive">
            <table id="file_export4" class="table table-striped table-bordered nowrap" style="width:100%;">
                <thead>
                    <tr>
                        <th>RUT/DNI</th>
                        <th>Nombre Usuario</th>
                        <th>User ID</th>
                        <th>Sistema</th>
                        <th>País</th>
                        <th>Cargo</th>
                        <th>Perfil</th>
                        <th>Gerencia</th>
                        <th>Subgerencia</th>
                        <th>Fecha Carga</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(item.Rutdni ?? "-")-@(item.Dv ?? "")</td>
                            <td>@(item.NombreUsuario ?? "-")</td>
                            <td>@(item.UserId ?? "-")</td>
                            <td>@(item.Sistema ?? "-")</td>
                            <td>@(item.Pais ?? "-")</td>
                            <td>@(item.CargoSpr ?? "-")</td>
                            <td>@(item.Perfil ?? "-")</td>
                            <td>@(item.Nom_Gerencia ?? "-")</td>
                            <td>@(item.Nom_Subgerencia ?? "-")</td>
                            <td>@item.FecCarga.ToString("dd-MM-yyyy")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th>RUT/DNI</th>
                        <th>Nombre Usuario</th>
                        <th>User ID</th>
                        <th>Sistema</th>
                        <th>País</th>
                        <th>Cargo</th>
                        <th>Perfil</th>
                        <th>Gerencia</th>
                        <th>Subgerencia</th>
                        <th>Fecha Carga</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/vendor.min.js"></script>
    <script src="~/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/js/dataTables.buttons.min.js"></script>
    <script src="~/js/jszip.min.js"></script>
    <script src="~/js/pdfmake.min.js"></script>
    <script src="~/js/vfs_fonts.js"></script>
    <script src="~/js/buttons.html5.min.js"></script>
    <script src="~/js/buttons.print.min.js"></script>
    <script src="~/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>
}