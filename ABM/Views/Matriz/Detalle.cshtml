@model IEnumerable<ABM.Models.MatrizActivo>
@{
    ViewData["Title"] = $"Matriz de Datos para {@ViewData["Pais"]} - {@ViewData["Sistema"]}";
}

<style>
    /* Eliminar padding del contenedor principal */
    .full-width-container {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        width: 100% !important;
    }

    /* Eliminar bordes y sombras de la card */
    .full-width-card {
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        margin: 0 !important;
    }

    /* Header personalizado */
    .custom-header {
        background-color: #b0d404 !important;
        color: white;
        padding: 15px 20px;
        margin: 0;
        border: none;
    }

    /* Ajustar el body de la card */
    .full-width-body {
        padding: 0 !important;
        margin: 0 !important;
    }

    /* Asegurar que la tabla use todo el ancho */
    .full-width-table {
        width: 100% !important;
        margin: 0 !important;
    }

    /* Ajustar el botón de volver */
    .back-button-container {
        padding: 15px 20px;
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }
</style>
<br />
    <br />
<br />
<div class="full-width-container">
    <!-- Sección del título y botón de volver -->
    <div class="back-button-container">
        <h1 class="mb-3">@ViewData["Title"]</h1>
        <a asp-action="Index" class="btn btn-secondary">
            &larr; Volver a la lista de matrices
        </a>
    </div>
    <br />
    <br />
    <br />
    <!-- Card sin bordes -->
    <div class="card full-width-card">
        <div class="card-header custom-header">
            <h5 class="mb-0">Listado de Activos en Matriz</h5>
        </div>
        <br />
        <div class="card-body full-width-body">
            <div class="table-responsive">
                <table id="file_export4" class="table table-striped table-bordered nowrap full-width-table">
                    <thead>
                        <tr>
                            <th>RUT/DNI</th>
                            <th>Nombre Usuario</th>
                            <th>User ID</th>
                            <th>País</th>
                            <th>Sistema</th>
                            <th>Cargo</th>
                            <th>Perfil</th>
                            <th>Gerencia</th>
                            <th>Subgerencia</th>
                            <th>Fecha Carga</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@(item.Rutdni ?? "-")-@(item.Dv ?? "")</td>
                                <td>@(item.NombreUsuario ?? "-")</td>
                                <td>@(item.UserId ?? "-")</td>
                                <td>@(item.Pais ?? "-")</td>
                                <td>@(item.Sistema ?? "-")</td>
                                <td>@(item.CargoSpr ?? "-")</td>
                                <td>@(item.Perfil ?? "-")</td>
                                <td>@(item.Nom_Gerencia ?? "-")</td>
                                <td>@(item.Nom_Subgerencia ?? "-")</td>
                                <td>@item.FecCarga.ToString("dd-MM-yyyy")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>RUT/DNI</th>
                            <th>Nombre Usuario</th>
                            <th>User ID</th>
                            <th>País</th>
                            <th>Sistema</th>
                            <th>Cargo</th>
                            <th>Perfil</th>
                            <th>Gerencia</th>
                            <th>Subgerencia</th>
                            <th>Fecha Carga</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/vendor.min.js"></script>
    <script src="~/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/js/dataTables.buttons.min.js"></script>
    <script src="~/js/jszip.min.js"></script>
    <script src="~/js/pdfmake.min.js"></script>
    <script src="~/js/vfs_fonts.js"></script>
    <script src="~/js/buttons.html5.min.js"></script>
    <script src="~/js/buttons.print.min.js"></script>
    <script src="~/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>
}