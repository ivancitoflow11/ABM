@model IEnumerable<ABM.Models.MatrizActivo>
@using ABM.Models

@{
    ViewData["Title"] = $"Matriz: {ViewData["sistema"]} | Negocio: {ViewData["Negocio"]} | País: {ViewData["Pais"]}";

    var firmaExistente = ViewBag.FirmaExistente as Firma;
    var puedeFirmar = ViewBag.PuedeFirmar as bool? ?? false;
    var idPais = ViewBag.IdPais;
    var idNegocio = ViewBag.IdNegocio;
    var idSistema = ViewBag.IdSistema;
}

<style>
    .back-button-container h1 {
    text-align: center; /* Centra el texto horizontalmente */
    font-size: 1.75rem; /* Ajusta el tamaño. Puedes usar 1.5rem o 2rem si lo prefieres. */
    width: 100%;      /* Asegura que ocupe todo el ancho para que el centrado funcione bien */
}
    .full-width-container {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        width: 100% !important;
    }

    .full-width-card {
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        margin: 0 !important;
    }

    .custom-header {
        background-color: #b0d404 !important;
        color: white;
        padding: 15px 20px;
        margin: 0;
        border: none;
    }

    .full-width-body {
        padding: 0 !important;
        margin: 0 !important;
    }

    .full-width-table {
        width: 100% !important;
        margin: 0 !important;
    }

    .back-button-container {
        padding: 15px 20px;
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }
</style>
<br />
<br />
<br />
<div class="full-width-container">
    <div class="back-button-container">
        <h1 class="mb-3">@ViewData["Title"]</h1>
        <a asp-action="Index" class="btn btn-secondary">
            &larr; Volver a la lista de matrices
        </a>
    </div>

    <div class="container-fluid my-3">
        <div class="card">
            <div class="card-body">
                @if (firmaExistente != null)
                {
                    <div class="alert alert-success d-flex justify-content-between align-items-center" role="alert">
                        <div>
                            <h5 class="alert-heading">Matriz Firmada</h5>
                            <p class="mb-0">
                                Esta matriz fue certificada el <strong>@firmaExistente.fechaFirma.ToString("dd 'de' MMMM 'de' yyyy 'a las' HH:mm") hrs.</strong>
                                @if (!string.IsNullOrEmpty(firmaExistente.comentario))
                                {
                                    <br />
                                    <em>Comentario: "@firmaExistente.comentario"</em>
                                }
                            </p>
                        </div>
                        <div>
                            <button id="btn-eliminar-firma" class="btn btn-danger" data-idfirma="@firmaExistente.idFirma">
                                <i class="fas fa-trash-alt"></i> Eliminar Firma
                            </button>
                        </div>
                        <a asp-action="DescargarPdfFirma"
                           asp-controller="Matriz" 
                           asp-route-idFirma="@firmaExistente.idFirma"
                           class="btn btn-success">
                            <i class="fas fa-file-pdf"></i> Descargar PDF de Firma
                        </a>
                    </div>
                }

                @if (puedeFirmar)
                {
                    <div class="text-end">
                        <button id="btn-firmar" class="btn btn-primary btn-lg">
                            <i class="fas fa-check-circle"></i> Firmar Matriz
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card full-width-card">
        <div class="card-header custom-header">
            <h5 class="mb-0">Listado de Activos en Matriz</h5>
        </div>
        <div class="card-body full-width-body">
            <div class="table-responsive">
                <table id="file_export4" class="table table-striped table-bordered nowrap full-width-table">
                    <thead>
                        <tr>
                            <th>RUT/DNI</th>
                            <th>Nombre Usuario</th>
                            <th>User ID</th>
                            <th>País</th>
                            <th>Negocio</th>
                            <th>Sistema</th>
                            <th>Cargo</th>
                            <th>Perfil</th>
                            <th>Fecha Carga</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@(item.Rutdni ?? "-")-@(item.Dv ?? "")</td>
                                <td>@(item.NombreUsuario ?? "-")</td>
                                <td>@(item.UserId ?? "-")</td>
                                <td>@(item.Pais ?? "-")</td>
                                <td>@(item.Negocio ?? "-")</td>
                                <td>@(item.Sistema ?? "-")</td>
                                <td>@(item.CargoSpr ?? "-")</td>
                                <td>@(item.Perfil ?? "-")</td>
                                <td>@item.FecCarga.ToString("dd-MM-yyyy")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>RUT/DNI</th>
                            <th>Nombre Usuario</th>
                            <th>User ID</th>
                            <th>País</th>
                            <th>Negocio</th>
                            <th>Sistema</th>
                            <th>Cargo</th>
                            <th>Perfil</th>
                            <th>Fecha Carga</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalComentario" tabindex="-1" aria-labelledby="modalComentarioLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalComentarioLabel">Confirmar Firma</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Estás a punto de certificar el contenido de esta matriz.</p>
                <div class="mb-3">
                    <label for="comentarioFirma" class="form-label">Añadir un comentario (opcional):</label>
                    <textarea class="form-control" id="comentarioFirma" rows="3"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btn-confirmar-firma" class="btn btn-primary">Confirmar y Firmar</button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="IdPais" value="@idPais" />
<input type="hidden" id="IdNegocio" value="@idNegocio" />
<input type="hidden" id="IdSistema" value="@idSistema" />
@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/vendor.min.js"></script>
    <script src="~/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/js/dataTables.buttons.min.js"></script>
    <script src="~/js/jszip.min.js"></script>
    <script src="~/js/pdfmake.min.js"></script>
    <script src="~/js/vfs_fonts.js"></script>
    <script src="~/js/buttons.html5.min.js"></script>
    <script src="~/js/buttons.print.min.js"></script>
    <script src="~/js/datatable/datatable-advanced.init.js" asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
                $(document).ready(function () {
                    var antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

                    $('#btn-firmar').on('click', function () {
                        var modalComentario = new bootstrap.Modal(document.getElementById('modalComentario'));
                        modalComentario.show();
                    });

                    $('#btn-confirmar-firma').on('click', function () {
                        var comentario = $('#comentarioFirma').val();

                        var dataPayload = {
                            idPais: $('#IdPais').val(),
                            idNegocio: $('#IdNegocio').val(),
                            idSistema: $('#IdSistema').val(),
                            comentario: comentario
                        };

                        $.ajax({
                            url: '@Url.Action("FirmarMatriz", "Matriz")',
                            type: 'POST',
                            headers: {
                                'RequestVerificationToken': antiForgeryToken
                            },
                            data: dataPayload,
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire({
                                        title: '¡Éxito!',
                                        text: response.message,
                                        icon: 'success'
                                    }).then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('Error', 'Ocurrió un problema de comunicación con el servidor.', 'error');
                            }
                        });
                    });

                    $('#btn-eliminar-firma').on('click', function () {
                        var idFirma = $(this).data('idfirma');

                        Swal.fire({
                            title: '¿Estás seguro?',
                            text: "No podrás revertir esta acción.",
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#3085d6',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'Sí, eliminar firma',
                            cancelButtonText: 'Cancelar'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                $.ajax({
                                    url: '@Url.Action("EliminarFirma", "Matriz")',
                                    type: 'POST',
                                    headers: {
                                        'RequestVerificationToken': antiForgeryToken
                                    },
                                    data: { idFirma: idFirma },
                                    success: function (response) {
                                        if (response.success) {
                                            Swal.fire({
                                                title: 'Eliminada',
                                                text: response.message,
                                                icon: 'success'
                                            }).then(() => {
                                                location.reload();
                                            });
                                        } else {
                                            Swal.fire('Error', response.message, 'error');
        }
                                    },
                                    error: function () {
                                         Swal.fire('Error', 'Ocurrió un problema de comunicación con el servidor.', 'error');
                                    }
                                });
                            }
                        });
                    });
                });
    </script>
}